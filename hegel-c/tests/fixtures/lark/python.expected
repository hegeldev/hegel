start file_input
terminal AMPERSAND	0	"\\&"
terminal AND	0	"and"
terminal AS	0	"as"
terminal ASSERT	0	"assert"
terminal ASYNC	0	"async"
terminal AT	0	"@"
terminal AWAIT	0	"await"
terminal BIN_NUMBER	2	"0(?:b|B)(?:(?:_)?[0-1])+"
terminal BREAK	0	"break"
terminal CASE	0	"case"
terminal CIRCUMFLEX	0	"\\^"
terminal CLASS	0	"class"
terminal COLON	0	":"
terminal COMMA	0	","
terminal COMMENT	0	"#[^\n]*"
terminal CONTINUE	0	"continue"
terminal DEC_NUMBER	0	"(?:0(?:(?:_)?0)*(?![1-9])|[1-9](?:(?:_)?[0-9])*)"
terminal DEF	0	"def"
terminal DEL	0	"del"
terminal DOT	0	"\\."
terminal ELIF	0	"elif"
terminal ELSE	0	"else"
terminal EQUAL	0	"="
terminal EXCEPT	0	"except"
terminal FALSE	0	"False"
terminal FINALLY	0	"finally"
terminal FLOAT_NUMBER	2	"(?:[0-9](?:(?:_)?[0-9])*(?:e|E)(?:(?:\\+|\\-))?[0-9](?:(?:_)?[0-9])*|(?:[0-9](?:(?:_)?[0-9])*\\.(?:[0-9](?:(?:_)?[0-9])*)?|\\.[0-9](?:(?:_)?[0-9])*)(?:(?:e|E)(?:(?:\\+|\\-))?[0-9](?:(?:_)?[0-9])*)?)"
terminal FOR	0	"for"
terminal FROM	0	"from"
terminal GLOBAL	0	"global"
terminal HEX_NUMBER	2	"0(?:x|X)(?:(?:_)?(?:[0-9]|[a-f]|[A-F]))+"
terminal IF	0	"if"
terminal IMAG_NUMBER	2	"(?:(?:[0-9](?:(?:_)?[0-9])*(?:e|E)(?:(?:\\+|\\-))?[0-9](?:(?:_)?[0-9])*|(?:[0-9](?:(?:_)?[0-9])*\\.(?:[0-9](?:(?:_)?[0-9])*)?|\\.[0-9](?:(?:_)?[0-9])*)(?:(?:e|E)(?:(?:\\+|\\-))?[0-9](?:(?:_)?[0-9])*)?)|[0-9](?:(?:_)?[0-9])*)(?:J|j)"
terminal IMPORT	0	"import"
terminal IN	0	"in"
terminal IS	0	"is"
terminal LAMBDA	0	"lambda"
terminal LBRACE	0	"\\{"
terminal LESSTHAN	0	"<"
terminal LONG_STRING	0	"(?s:(?i:([ubf]?r?|r[ubf])(\"\"\".*?(?<!\\\\)(\\\\\\\\)*?\"\"\"|'''.*?(?<!\\\\)(\\\\\\\\)*?''')))"
terminal LPAR	0	"\\("
terminal LSQB	0	"\\["
terminal MATCH	0	"match"
terminal MINUS	0	"\\-"
terminal MORETHAN	0	">"
terminal NAME	0	"[^\\W\\d]\\w*"
terminal NONE	0	"None"
terminal NONLOCAL	0	"nonlocal"
terminal NOT	0	"not"
terminal OCT_NUMBER	2	"0(?:o|O)(?:(?:_)?[0-7])+"
terminal OR	0	"or"
terminal PASS	0	"pass"
terminal PERCENT	0	"%"
terminal PLUS	0	"\\+"
terminal RAISE	0	"raise"
terminal RBRACE	0	"\\}"
terminal RETURN	0	"return"
terminal RPAR	0	"\\)"
terminal RSQB	0	"\\]"
terminal SEMICOLON	0	";"
terminal SLASH	0	"/"
terminal STAR	0	"\\*"
terminal STRING	0	"(?i:([ubf]?r?|r[ubf])(\"(?!\"\").*?(?<!\\\\)(\\\\\\\\)*?\"|'(?!'').*?(?<!\\\\)(\\\\\\\\)*?'))"
terminal TILDE	0	"\\~"
terminal TRUE	0	"True"
terminal TRY	0	"try"
terminal UNDERSCORE	0	"_"
terminal VBAR	0	"\\|"
terminal WHILE	0	"while"
terminal WITH	0	"with"
terminal YIELD	0	"yield"
terminal _NEWLINE	0	"(?:(?:\r?\n[\t ]*|#[^\n]*))+"
terminal __ANON_0	0	"\\->"
terminal __ANON_1	0	"\\*\\*"
terminal __ANON_10	0	"\\^="
terminal __ANON_11	0	"<<="
terminal __ANON_12	0	">>="
terminal __ANON_13	0	"\\*\\*="
terminal __ANON_14	0	"//="
terminal __ANON_15	0	":="
terminal __ANON_16	0	"<<"
terminal __ANON_17	0	">>"
terminal __ANON_18	0	"//"
terminal __ANON_19	0	"=="
terminal __ANON_2	0	"\\+="
terminal __ANON_20	0	">="
terminal __ANON_21	0	"<="
terminal __ANON_22	0	"<>"
terminal __ANON_23	0	"!="
terminal __ANON_24	0	"\\.\\.\\."
terminal __ANON_3	0	"\\-="
terminal __ANON_4	0	"\\*="
terminal __ANON_5	0	"@="
terminal __ANON_6	0	"/="
terminal __ANON_7	0	"%="
terminal __ANON_8	0	"\\&="
terminal __ANON_9	0	"\\|="
terminal __IGNORE_0	0	"[\t \f]+"
terminal __IGNORE_1	0	"\\\\[\t \f]*\r?\n"
ignore __IGNORE_0
ignore __IGNORE_1
