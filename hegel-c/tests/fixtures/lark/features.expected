start start
terminal COLON	0	":"
terminal COMMA	0	","
terminal EQUAL	0	"="
terminal ESCAPED_STRING	0	"\".*?(?<!\\\\)(\\\\\\\\)*?\""
terminal KEYWORD	0	"(?i:KeyWord)"
terminal LSQB	0	"\\["
terminal NAME	0	"(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*"
terminal NOTHING	0	"nothing"
terminal RSQB	0	"\\]"
terminal SIGNED_NUMBER	0	"(?:(?:\\+|\\-))?(?:(?:(?:[0-9])+(?:e|E)(?:(?:\\+|\\-))?(?:[0-9])+|(?:(?:[0-9])+\\.(?:(?:[0-9])+)?|\\.(?:[0-9])+)(?:(?:e|E)(?:(?:\\+|\\-))?(?:[0-9])+)?)|(?:[0-9])+)"
terminal SPACE	0	"(?:[ \t\f\r\n])+"
terminal WS_INLINE	0	"(?:(?:\\ |\t))+"
terminal __ANON_0	0	"[a-c]"
terminal __ANON_1	0	"(?i:x+)"
terminal __IGNORE_1	0	"#[^\n]*"
ignore SPACE
ignore __IGNORE_1
rule list
rule number
rule pair{NAME,value}
rule start
rule string
rule value
