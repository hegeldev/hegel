<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Hegel.NUnit</RootNamespace>
    <AssemblyName>Hegel.NUnit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Hegel.NUnit</PackageId>
    <Title>Hegel for NUnit</Title>
    <Authors>David R. MacIver</Authors>
    <Company>Antithesis</Company>
    <Description>NUnit 4 integration for Hegel: [HegelTest] marks a method taking a TestCase as a property-based test.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://hegel.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hegeldev/hegel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>property-based-testing;testing;hegel;hypothesis;fuzzing;nunit</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Hegel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hegel/Hegel.csproj" />
  </ItemGroup>

</Project>
