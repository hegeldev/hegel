    def start(settings: Settings) -> Run: ...
    @staticmethod
    def start_blob(settings: Settings, blob: str) -> Run: ...
    def next_test_case(self) -> TestCase | None: ...
    def drain_output(self) -> list[str]: ...
    def result(self) -> RunResult: ...

class RunResult:
    def status(self) -> int: ...
    def error(self) -> str | None: ...
    def error_kind(self) -> tuple[int, int]: ...
    def failure_count(self) -> int: ...
    def failure(self, index: int) -> tuple[str, str | None, str | None]: ...

class TestCase:
    def clone(self) -> TestCase: ...
    def block(self, indent: int) -> TestCase: ...
    def set_worker(self, worker_index: int) -> None: ...
    def should_capture(self) -> bool: ...
    def mark_complete(self, status: int, origin: str | None) -> None: ...
    def generate_boolean(self, p: float, forced: bool | None = None) -> bool: ...
    def generate_integer(self, min_value: int, max_value: int) -> int: ...
    def generate_float(
        self,
        width: int,
        min_value: float,
        max_value: float,
        allow_nan: bool,
        allow_infinity: bool,
        exclude_min: bool,
        exclude_max: bool,
        smallest_nonzero_magnitude: float,
    ) -> float: ...
    def generate_bytes(self, min_size: int, max_size: int | None) -> bytes: ...
    def generate_string(self, generator: StringGenerator) -> bytes: ...
    def generate_date(
        self, min_value: tuple[int, int, int], max_value: tuple[int, int, int]
    ) -> tuple[int, int, int]: ...
    def generate_time(
        self,
        min_value: tuple[int, int, int, int],
        max_value: tuple[int, int, int, int],
    ) -> tuple[int, int, int, int]: ...
    def generate_datetime(
        self,
        min_value: tuple[int, int, int, int, int, int, int],
        max_value: tuple[int, int, int, int, int, int, int],
    ) -> tuple[int, int, int, int, int, int, int]: ...
    def generate_uuid(self, version: int | None) -> bytes: ...
    def generate_ipv4(self) -> bytes: ...
    def generate_ipv6(self) -> bytes: ...
    def target(self, value: float, label: str) -> None: ...
    def event(self, label: str) -> None: ...
    def event_value(self, value: float, label: str) -> None: ...
    def start_span(self, label: int) -> None: ...
    def stop_span(self, discard: bool) -> None: ...
    def note(self, text: str) -> None: ...
    def printer(self, max_width: int) -> Printer: ...
    def new_collection(self, min_size: int, max_size: int | None) -> Collection: ...
    def new_repeat(self) -> Repeat: ...
    def new_recursion(self, max_depth: int, max_leaves: int) -> Recursion: ...
    def new_pool(self) -> Pool: ...
    def new_state_machine(
        self,
        rule_names: Sequence[str],
        rule_groups: Sequence[int],
        rule_weights: Sequence[float] | None,
        invariant_names: Sequence[str],
        invariant_always_check: Sequence[bool] | None,
        min_concurrency: int,
        max_concurrency: int,
        step_count: int,
    ) -> tuple[StateMachine, int]: ...

class Collection:
    def more(self, tc: TestCase) -> bool: ...
    def reject(self, tc: TestCase, why: str | None) -> None: ...

class Repeat:
    def more(self, tc: TestCase) -> bool: ...
    def failed(self, tc: TestCase) -> None: ...

class Recursion:
    def branch(self, tc: TestCase, depth: int) -> bool: ...
    def leaf(self, tc: TestCase) -> None: ...
    def retry(self, tc: TestCase) -> None: ...
    def finish(self, tc: TestCase) -> None: ...

class Pool:
    def add(self, tc: TestCase) -> int: ...
    def generate(self, tc: TestCase, consume: bool) -> int: ...
    def restore(self, tc: TestCase, variable_id: int) -> None: ...

class StateMachine:
    def next_group(self, tc: TestCase) -> int | None: ...
    def next_rule(self, tc: TestCase, worker_index: int) -> int | None: ...
    def rule_rejected(self, tc: TestCase, worker_index: int) -> None: ...
    def should_check_invariant(self, tc: TestCase, invariant_index: int) -> bool: ...
