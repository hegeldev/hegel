# Recipes for the Python frontend (the `hegeltest` package on PyPI, imported
# as `hegel`). Run as `just python::<recipe>` from anywhere in the repo;
# recipes execute from this directory, so `uv` finds the project here. The
# Rust half (`src/`, the `hegel-python` crate) is a member of the root Cargo
# workspace, so `cargo fmt` and `cargo clippy` for it run from the root
# justfile; only the Python-side checks live here.
set ignore-comments := true

# Create the virtualenv (uv) and build the extension in development mode.
setup:
    uv sync --group dev
    uv run maturin develop --uv

# Rebuild the Rust extension after changing src/ or libhegel.
build:
    uv run maturin develop --uv

build-release:
    uv run maturin develop --uv --release

test *ARGS:
    uv run pytest {{ARGS}}

# The package's own test suite.
check-tests:
    uv run pytest -q tests --ignore=tests/hypothesis_port

# The package's own test suite, requiring complete line and branch coverage
# of python/hegel. Lines marked "unreachable on py3.X" are excluded only when
# measuring on Python 3.X.
check-coverage:
    uv run coverage run -m pytest -q tests --ignore=tests/hypothesis_port
    HEGEL_COVERAGE_PYTHON=$(uv run python -c 'import sys; print("%d.%d" % sys.version_info[:2])') uv run coverage report

# The Hypothesis test suite, ported to the Hegel API.
check-hypothesis-port:
    uv run pytest -q tests/hypothesis_port -p no:cacheprovider

format:
    uv run ruff format python tests scripts
    uv run ruff check --fix python tests scripts

check-format:
    uv run ruff format --check python tests scripts

check-ruff:
    uv run ruff check python tests scripts

check-types:
    uv run mypy python/hegel

# Python-side lints; `cargo fmt` / `cargo clippy` run from the root justfile.
check-lint: check-format check-ruff check-types

check: check-lint check-coverage check-hypothesis-port
