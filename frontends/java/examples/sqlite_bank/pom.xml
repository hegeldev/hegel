<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Not a child of hegel-parent, so releases never touch this file. The frontend's build lists it
       as a module only under the sqlite-examples profile, and `just java::run-sqlite-bank` sets
       hegel.version to the frontend's version so the in-tree hegel is used. The default below is a
       published version, so IDEs can resolve the imports; it does not need to be kept current. -->
  <groupId>dev.hegel.examples</groupId>
  <artifactId>sqlite-bank</artifactId>
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <name>Hegel SQLite bank example</name>
  <description>Bank workload testing SQLite's ACID guarantees with Hegel's concurrent state machines</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>22</maven.compiler.release>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <hegel.version>0.11.2</hegel.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.hegel</groupId>
      <artifactId>hegel</artifactId>
      <version>${hegel.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.46.1</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>2.91.0</version>
            </palantirJavaFormat>
          </java>
        </configuration>
      </plugin>

      <!-- Writes the runtime classpath to target/classpath.txt, so the workload can be run with
           plain `java`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>write-classpath</id>
            <phase>package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputFile>${project.build.directory}/classpath.txt</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
