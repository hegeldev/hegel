<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.hegel</groupId>
    <artifactId>hegel-parent</artifactId>
    <version>0.10.2</version>
  </parent>

  <artifactId>hegel-lowlevel</artifactId>
  <packaging>jar</packaging>

  <name>hegel-java (low-level binding contract)</name>
  <description>The libhegel binding contract for people binding Hegel or building frontends on it: the Libhegel interface, the C ABI constants, and library resolution (Java 17+)</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>dev.hegel.lowlevel</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <!-- This module bundles no natives: instead of staging them, scripts/engine.py generates
           BuildInfo.ENGINE_VERSION from the in-tree libhegel's Cargo.toml. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>stage-natives</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>build-info</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${hegel.python}</executable>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/scripts/engine.py</argument>
                <argument>build-info</argument>
                <argument>--out</argument>
                <argument>${project.build.directory}/generated-sources/engine</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- This module has no shared sources: only the generated BuildInfo joins the compile path,
           and the shared test tree (which needs a binding and the engine) is not added. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-shared-sources</id>
            <configuration combine.self="override">
              <sources>
                <source>${project.build.directory}/generated-sources/engine</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-shared-test-sources</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <!-- No native is bundled here, so Libhegel.load() resolves the override path instead;
                 the file is never opened (the test SPI provider returns a stub). -->
            <HEGEL_LIBHEGEL_PATH>${project.basedir}/src/test/resources/dummy-libhegel</HEGEL_LIBHEGEL_PATH>
          </environmentVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
