<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.hegel</groupId>
  <artifactId>hegel-parent</artifactId>
  <version>0.10.3</version>
  <packaging>pom</packaging>

  <name>hegel-java parent</name>
  <description>Property-based testing for Java, built on Hypothesis</description>
  <url>https://github.com/hegeldev/hegel/tree/main/frontends/java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Liam DeVoe</name>
      <email>orionldevoe@gmail.com</email>
    </developer>
    <developer>
      <name>David R. MacIver</name>
      <email>david@drmaciver.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/hegeldev/hegel.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/hegeldev/hegel.git</developerConnection>
    <url>https://github.com/hegeldev/hegel/tree/main/frontends/java</url>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/hegeldev/hegel/issues</url>
  </issueManagement>

  <modules>
    <module>hegel-lowlevel</module>
    <module>hegel</module>
    <module>hegel-jna</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>22</maven.compiler.release>
    <junit.version>5.11.4</junit.version>
    <jacoco.version>0.8.14</jacoco.version>
    <!-- The engine is the in-tree libhegel (../../libhegel), built by `just java::build-libhegel`;
         scripts/engine.py stages it into each frontend jar's build output as the bundled native for
         the host (`local`), or every platform's library from the GitHub release of the libhegel
         version in ../../libhegel/Cargo.toml (`release`, which the release profile selects). -->
    <hegel.natives.source>local</hegel.natives.source>
    <!-- Set -Dhegel.natives.skip=true to skip the staging (e.g. to build the javadoc without an
         engine build). -->
    <hegel.natives.skip>false</hegel.natives.skip>
    <!-- The Python interpreter used to run scripts/engine.py; the windows-python
         profile overrides it, since Windows installs no python3 launcher. -->
    <hegel.python>python3</hegel.python>
    <!-- FFM (and JNA on Java 24+) requires native access; surefire passes this to the test JVM. -->
    <hegel.argLine>--enable-native-access=ALL-UNNAMED</hegel.argLine>
    <hegel.shared>${maven.multiModuleProjectDirectory}/shared</hegel.shared>
  </properties>

  <dependencies>
    <!-- JUnit 5: optional for users (they bring their own), but the @HegelTest
         extension implements Jupiter SPIs, so it is compile-scoped here and
         marked optional so it does not leak onto users who only use Hegel.check. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-testkit</artifactId>
      <version>1.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>

        <!-- Register the shared sources, shared tests, and the generated BuildInfo as
             compile/test source roots. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.0</version>
          <executions>
            <execution>
              <id>add-shared-sources</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>add-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>${hegel.shared}/src/main/java</source>
                  <source>${project.build.directory}/generated-sources/engine</source>
                </sources>
              </configuration>
            </execution>
            <execution>
              <id>add-shared-test-sources</id>
              <phase>generate-test-sources</phase>
              <goals>
                <goal>add-test-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>${hegel.shared}/src/test/java</source>
                </sources>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <!-- Stage the libhegel native libraries into the build output so they are packaged
             into the jar as classpath resources (native/<os>-<arch>/libhegel.<ext>). Runs
             before compile/test so the test JVM resolves the bundled native too. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>stage-natives</id>
              <phase>generate-resources</phase>
              <goals>
                <goal>exec</goal>
              </goals>
              <configuration>
                <skip>${hegel.natives.skip}</skip>
                <executable>${hegel.python}</executable>
                <arguments>
                  <argument>${maven.multiModuleProjectDirectory}/scripts/engine.py</argument>
                  <argument>stage</argument>
                  <argument>--source</argument>
                  <argument>${hegel.natives.source}</argument>
                  <argument>--out</argument>
                  <argument>${project.build.outputDirectory}</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <argLine>@{argLine} ${hegel.argLine}</argLine>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-invoker-plugin</artifactId>
          <version>3.9.0</version>
          <configuration>
            <projectsDirectory>src/it</projectsDirectory>
            <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
            <streamLogs>true</streamLogs>
          </configuration>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>2.46.1</version>
          <configuration>
            <java>
              <palantirJavaFormat>
                <version>2.91.0</version>
              </palantirJavaFormat>
            </java>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
          <configuration>
            <doclint>all,-missing</doclint>
            <quiet>true</quiet>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>INSTRUCTION</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>1.00</minimum>
                      </limit>
                      <limit>
                        <counter>BRANCH</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>1.00</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <inherited>false</inherited>
        <configuration>
          <java>
            <includes>
              <include>shared/src/main/java/**/*.java</include>
              <include>shared/src/test/java/**/*.java</include>
            </includes>
            <palantirJavaFormat>
              <version>2.91.0</version>
            </palantirJavaFormat>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Windows ships python.exe but no python3 launcher. -->
    <profile>
      <id>windows-python</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <hegel.python>python</hegel.python>
      </properties>
    </profile>

    <!-- Activated for publishing to Maven Central, via `mvn deploy -P release`. The jars bundle
         every platform's library from the libhegel GitHub release. -->
    <profile>
      <id>release</id>
      <properties>
        <hegel.natives.source>release</hegel.natives.source>
      </properties>
      <build>
        <plugins>
          <!-- Sources jar -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!-- Javadoc jar -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!-- sign all artifacts with our GPG key -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- Never read a passphrase from settings.xml. Our release key has no
                       passphrase, but actions/setup-java templates a gpg.passphrase server
                       entry into the runner's settings.xml whenever gpg-private-key is
                       supplied (even with no gpg-passphrase input), and resolving it dumps
                       a harmless-but-noisy SecDispatcherException stacktrace (no
                       ~/.m2/settings-security.xml) into the release logs. If the key ever
                       gains a passphrase, supply it via the MAVEN_GPG_PASSPHRASE
                       environment variable. -->
                  <bestPractices>true</bestPractices>
                  <gpgArguments>
                    <!--  don't ask for passphrase. might not be required-->
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- Upload to and publish on the Central Portal. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
