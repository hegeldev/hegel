# Recipes for the Rust frontend (the `hegeltest` crate and its proc-macro
# crate in macros/). Run as `just rust::<recipe>` from anywhere in the repo;
# recipes execute from this directory, so `cargo` commands default to this
# package.
set ignore-comments := true

check: check-lint check-tests check-tests-all-features

# Frontend-specific lints; workspace-wide ones live in the root justfile.
check-lint: check-generator-imports check-ffi-list

check-generator-imports:
    scripts/check-generator-imports.py

# The frontend's list of `hegel_*` functions is generated from the engine
# source; `just libhegel::header` refreshes it alongside the C header.
check-ffi-list:
    scripts/gen-ffi-list.py --check

test: check-tests

check-tests:
    RUST_BACKTRACE=1 cargo test -p hegeltest -p hegeltest-macros

check-tests-all-features:
    RUST_BACKTRACE=1 cargo test -p hegeltest -p hegeltest-macros --all-features

compile-examples:
    cargo build -p hegeltest --examples --all-features

check-docs:
    cargo +nightly docs-rs

docs:
    cargo +nightly docs-rs --open

# Run a fast core of the suite under Miri to catch undefined behaviour in the
# in-process C-ABI boundary hegeltest drives the engine through. The
# `test_miri` target exercises the main generator, combinator, derive,
# targeting, assume, and shrinking features end-to-end: every draw flows
# through the same `hegel_generate` / span / collection / target FFI
# primitives the other language bindings use, so this covers the unsafe
# boundary while staying tractable under Miri's interpreter (small example
# counts, no 100-example property loops or budget-exhaustion draws).
#
# Requires the nightly toolchain with the miri component:
# `rustup +nightly component add miri`.
#
# CI=1 disables the on-disk failure database (we don't want Miri writing
# files); isolation is disabled because the engine seeds its PRNG from OS
# entropy. --features static-engine links the engine in as an rlib: Miri
# cannot call into a real shared library, but this way it interprets the
# whole engine.
check-miri:
    CI=1 MIRIFLAGS="-Zmiri-disable-isolation" cargo +nightly miri test -p hegeltest --features static-engine --test test_miri

miri: check-miri
