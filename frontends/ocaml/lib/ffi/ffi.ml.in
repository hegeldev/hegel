(* Low-level ctypes bindings to libhegel, the native property-based testing
   engine exposed as a C library by hegeldev/hegel (libhegel/include/hegel.h).

   This module is a thin, mechanical 1:1 wrapper over the C ABI: it locates and
   [dlopen]s the shared library and exposes the functions used by the OCaml
   frontend. Wrappers copy borrowed C buffers into OCaml strings and
   translate negative status codes into exceptions. *)

open Ctypes

(* ------------------------------------------------------------------ *)
(* Locating and opening the shared library                            *)
(* ------------------------------------------------------------------ *)

(* [memoize] is a thread-safe lazy value, used to avoid an eager dlopen in code
   that wants to derive hegel generators but doesn't run the hegel engine and
   hence doesn't require libhegel. *)
let memoize f =
  let mutex = Mutex.create () in
  let value = lazy (f ()) in
  let forced = Atomic.make None in
  fun () ->
    match Atomic.get forced with
    | Some v -> v
    | None ->
      Mutex.protect mutex (fun () ->
        let v = Lazy.force value in
        Atomic.set forced (Some v);
        v)
;;

let lib =
  memoize (fun () ->
    let path = Loader.locate () in
    try Dl.dlopen ~filename:path ~flags:[ Dl.RTLD_NOW; Dl.RTLD_GLOBAL ] with
    | Dl.DL_error msg ->
      failwith (Printf.sprintf "hegel: failed to load libhegel from %s: %s" path msg))
;;

let binding_initializers = ref []

let foreign ?(release_runtime_lock = false) name typ =
  let binding =
    memoize (fun () -> Foreign.foreign ~from:(lib ()) ~release_runtime_lock name typ)
  in
  let initialize () =
    let (_ : _ -> _) = binding () in
    ()
  in
  binding_initializers := initialize :: !binding_initializers;
  fun arg ->
    let f = binding () in
    f arg
;;

(* [hegel_next_test_case] runs the engine on the calling thread. An engine call
   can take a while, so release the OCaml runtime lock for its duration to let
   other OCaml threads run. *)
let foreign_blocking name typ = foreign ~release_runtime_lock:true name typ

(* ------------------------------------------------------------------ *)
(* Handles                                                            *)
(* ------------------------------------------------------------------ *)

(* In OxCaml they cross portability and contention since libhegel's threading
   contract says a handle may move between threads and belongs to one thread at a
   time. ptr doesn't have a kind, but libhegel handles are captured in many places
   so we need to wrap it in a type with the kind value mod portable contended to keep
   portability and contention. *)
#ifdef OXCAML
type handle : value mod portable contended = H of unit ptr
[@@unboxed] [@@unsafe_allow_any_mode_crossing]
#else
type handle = H of unit ptr [@@unboxed]
#endif

let raw (H p) = p
let handle_t : handle typ = view ~read:(fun p -> H p) ~write:raw (ptr void)
let null_handle = H null

(* ------------------------------------------------------------------ *)
(* C structs returned by the typed draws                              *)
(* ------------------------------------------------------------------ *)

(* [hegel_generate_bytes_result_t]: an engine-allocated byte buffer, freed with
   [hegel_generate_bytes_result_free]. *)
module Bytes_result = struct
  type s

  let t : s structure typ = structure "hegel_generate_bytes_result_t"
  let data = field t "data" (ptr uint8_t)
  let len = field t "len" size_t
  let () = seal t
end

(* [hegel_string_t]: a UTF-8 string view passed by value, also the
   [hegel_owned_string_t] that [hegel_generate_string] returns. *)
module Str = struct
  type s

  let t : s structure typ = structure "hegel_string_t"
  let data = field t "data" (ptr char)
  let len = field t "len" size_t
  let () = seal t
end

(* The struct and its bytes share one buffer, so the struct value keeps the
   bytes alive. ctypes holds each argument's converted value until the call
   returns, which is what makes [str] and [str_opt] safe as argument types. *)
let str_of_string s =
  let n = String.length s in
  let header = sizeof Str.t in
  let buf = allocate_n char ~count:(header + n) in
  let bytes = buf +@ header in
  String.iteri (fun i c -> bytes +@ i <-@ c) s;
  let v = !@(coerce (ptr char) (ptr Str.t) buf) in
  setf v Str.data bytes;
  setf v Str.len (Unsigned.Size_t.of_int n);
  v
;;

let string_of_str v =
  match Unsigned.Size_t.to_int (getf v Str.len) with
  | 0 -> ""
  | n -> string_from_ptr (getf v Str.data) ~length:n
;;

let str : string typ = view ~read:string_of_str ~write:str_of_string Str.t

(* [const hegel_string_t *] where NULL means absent. *)
let str_opt : string option typ =
  view
    ~read:(fun p -> if is_null p then None else Some (string_of_str !@p))
    ~write:(function
      | None -> from_voidp Str.t null
      | Some s -> addr (str_of_string s))
    (ptr Str.t)
;;

(* [hegel_printer_value_result_t]: an engine-allocated UTF-8 buffer (not
   NUL-terminated), freed with [hegel_printer_value_result_free]. *)
module Printer_value_result = struct
  type s

  let t : s structure typ = structure "hegel_printer_value_result_t"
  let data = field t "data" (ptr char)
  let len = field t "len" size_t
  let () = seal t
end

(* [hegel_date_t]: proleptic Gregorian date. [year] in [-999999, 999999]
   (bounded by the range passed to [hegel_generate_date]), [month] in [1, 12],
   [day] in [1, 31]. *)
module Date_struct = struct
  type s

  let t : s structure typ = structure "hegel_date_t"
  let year = field t "year" int32_t
  let month = field t "month" uint8_t
  let day = field t "day" uint8_t
  let () = seal t
end

(* [hegel_time_t]: hour in [0, 23], minute/second in [0, 59], nanosecond in [0, 999999999]. *)
module Time_struct = struct
  type s

  let t : s structure typ = structure "hegel_time_t"
  let hour = field t "hour" uint8_t
  let minute = field t "minute" uint8_t
  let second = field t "second" uint8_t
  let nanosecond = field t "nanosecond" uint32_t
  let () = seal t
end

(* [hegel_datetime_t]: a [hegel_date_t] plus a [hegel_time_t]. *)
module Datetime_struct = struct
  type s

  let t : s structure typ = structure "hegel_datetime_t"
  let date = field t "date" Date_struct.t
  let time = field t "time" Time_struct.t
  let () = seal t
end

module Timestamp_struct = struct
  type s

  let t : s structure typ = structure "hegel_timestamp_t"
  let second = field t "second" int64_t
  let nanosecond = field t "nanosecond" uint32_t
  let () = seal t
end

module Duration_struct = struct
  type s

  let t : s structure typ = structure "hegel_duration_t"
  let seconds = field t "seconds" int64_t
  let nanoseconds = field t "nanoseconds" int32_t
  let () = seal t
end

module Offset_struct = struct
  type s

  let t : s structure typ = structure "hegel_offset_t"
  let seconds = field t "seconds" int32_t
  let known = field t "known" bool
  let () = seal t
end

module Span_struct = struct
  type s

  let t : s structure typ = structure "hegel_span_t"

  let units =
    List.map
      (fun name -> field t name int64_t)
      [ "years"
      ; "months"
      ; "weeks"
      ; "days"
      ; "hours"
      ; "minutes"
      ; "seconds"
      ; "milliseconds"
      ; "microseconds"
      ; "nanoseconds"
      ]
  ;;

  let () = seal t
end

module Resolution_struct = struct
  type s

  let t : s structure typ = structure "hegel_timezone_resolution_t"
  let kind = field t "kind" uint32_t
  let offset_before = field t "offset_before" int32_t
  let offset_after = field t "offset_after" int32_t
  let offset_seconds = field t "offset_seconds" int32_t
  let offset_known = field t "offset_known" bool
  let timestamp = field t "timestamp" Timestamp_struct.t
  let () = seal t
end

module Zone_offset_struct = struct
  type s

  let t : s structure typ = structure "hegel_timezone_offset_t"
  let offset_seconds = field t "offset_seconds" int32_t
  let offset_known = field t "offset_known" bool
  let is_dst = field t "is_dst" bool
  let abbreviation = field t "abbreviation" Str.t
  let () = seal t
end

module Zone_info_struct = struct
  type s

  let t : s structure typ = structure "hegel_timezone_info_t"
  let known = field t "known" bool
  let primary_name = field t "primary_name" Str.t
  let is_link = field t "is_link" bool
  let rank = field t "rank" uint16_t
  let tags = field t "tags" uint32_t
  let () = seal t
end

module Zoned_struct = struct
  type s

  let t : s structure typ = structure "hegel_zoned_datetime_t"
  let civil = field t "civil" Datetime_struct.t
  let offset_seconds = field t "offset_seconds" int32_t
  let offset_known = field t "offset_known" bool
  let fold = field t "fold" bool
  let kind = field t "kind" uint32_t
  let offset_before = field t "offset_before" int32_t
  let offset_after = field t "offset_after" int32_t
  let timestamp = field t "timestamp" Timestamp_struct.t
  let () = seal t
end

module Zone_type_struct = struct
  type s

  let t : s structure typ = structure "hegel_zone_type_t"
  let utoff = field t "utoff" int32_t
  let is_dst = field t "is_dst" bool
  let abbreviation = field t "abbreviation" Str.t
  let () = seal t
end

module Zone_transition_struct = struct
  type s

  let t : s structure typ = structure "hegel_zone_transition_t"
  let instant = field t "instant" int64_t
  let local_type = field t "local_type" Zone_type_struct.t
  let () = seal t
end

module Rule_date_struct = struct
  type s

  let t : s structure typ = structure "hegel_zone_rule_date_t"
  let kind = field t "kind" uint32_t
  let day = field t "day" uint16_t
  let month = field t "month" uint8_t
  let week = field t "week" uint8_t
  let weekday = field t "weekday" uint8_t
  let time = field t "time" int32_t
  let () = seal t
end

module Zone_data_struct = struct
  type s

  let t : s structure typ = structure "hegel_zone_data_t"
  let initial = field t "initial" Zone_type_struct.t
  let transitions = field t "transitions" (ptr Zone_transition_struct.t)
  let transition_count = field t "transition_count" size_t
  let after = field t "after" uint32_t
  let standard = field t "standard" Zone_type_struct.t
  let has_dst = field t "has_dst" bool
  let dst = field t "dst" Zone_type_struct.t
  let dst_start = field t "dst_start" Rule_date_struct.t
  let dst_end = field t "dst_end" Rule_date_struct.t
  let last_year = field t "last_year" int32_t
  let () = seal t
end

let offset_fn =
  Foreign.funptr
    (ptr void @-> handle_t @-> int64_t @-> ptr Zone_type_struct.t @-> returning int)
;;

let next_transition_fn =
  Foreign.funptr_opt
    (ptr void @-> handle_t @-> int64_t @-> ptr bool @-> ptr int64_t @-> returning int)
;;

let loader_fn =
  Foreign.funptr (ptr void @-> handle_t @-> handle_t @-> Str.t @-> returning int)
;;

module Zone_oracle_struct = struct
  type s

  let t : s structure typ = structure "hegel_zone_oracle_t"
  let offset_at = field t "offset_at" offset_fn
  let next_transition = field t "next_transition" next_transition_fn
  let user_data = field t "user_data" (ptr void)
  let first_year = field t "first_year" int32_t
  let last_year = field t "last_year" int32_t
  let after = field t "after" uint32_t
  let () = seal t
end

