(* ------------------------------------------------------------------ *)
(* Public types                                                        *)
(* ------------------------------------------------------------------ *)

type context = handle
type settings = handle
type run = handle
type test_case = handle
type run_result = handle
type failure = handle
type string_generator = handle
type collection = handle
type pool = handle
type state_machine = handle
type printer = handle
type printer_options = handle

type backend =
  | Default
  | Urandom

type verbosity =
  | Quiet
  | Normal
  | Verbose
  | Debug

type nondeterminism_strictness =
  | Nondeterminism_quiet
  | Nondeterminism_warn
  | Nondeterminism_error

type status =
  | Valid
  | Invalid
  | Overrun
  | Interesting

type run_status =
  | Run_passed
  | Run_failed
  | Run_error

exception Stop_test
exception Assume_rejected
exception Internal_error of string
exception Usage_error of string

(* Status codes returned by the C primitives [HEGEL_OK] / [HEGEL_E_*]. *)
let ok = 0
let e_stop_test = -1
let e_assume = -2
let e_backend = -3
let e_invalid_handle = -4
let e_invalid_arg = -5
let e_already_complete = -6
let e_not_complete = -7
let e_internal = -8
let e_concurrent_use = -9

(* Phase bitmask values [HEGEL_PHASE_*]. *)
let phase_explicit = 1
let phase_reuse = 1 lsl 1
let phase_generate = 1 lsl 2
let phase_target = 1 lsl 3
let phase_shrink = 1 lsl 4

(* Health-check bitmask values [HEGEL_HC_*]. *)
let hc_filter_too_much = 1
let hc_too_slow = 1 lsl 1
let hc_test_cases_too_large = 1 lsl 2
let hc_large_initial_test_case = 1 lsl 3

(* ------------------------------------------------------------------ *)
(* Helpers                                                             *)
(* ------------------------------------------------------------------ *)

let backend_to_int = function
  | Default -> 1
  | Urandom -> 2
;;

let verbosity_to_int = function
  | Normal -> 0
  | Quiet -> 1
  | Verbose -> 2
  | Debug -> 3
;;

let verbosity_of_int = function
  | 0 -> Normal
  | 1 -> Quiet
  | 2 -> Verbose
  | 3 -> Debug
  | n -> raise (Internal_error (Printf.sprintf "hegel: unknown verbosity %d" n))
;;

let nondeterminism_strictness_to_int = function
  | Nondeterminism_quiet -> 0
  | Nondeterminism_warn -> 1
  | Nondeterminism_error -> 2
;;

let nondeterminism_strictness_of_int = function
  | 0 -> Nondeterminism_quiet
  | 1 -> Nondeterminism_warn
  | 2 -> Nondeterminism_error
  | n ->
    raise (Internal_error (Printf.sprintf "hegel: unknown nondeterminism strictness %d" n))
;;

let backend_of_int = function
  | 1 -> Default
  | 2 -> Urandom
  | n -> raise (Internal_error (Printf.sprintf "hegel: unknown backend %d" n))
;;

let status_to_int = function
  | Valid -> 0
  | Invalid -> 1
  | Overrun -> 2
  | Interesting -> 3
;;

(* Translate a libhegel return code into success or an exception. *)
let check_rc ctx rc =
  if rc = ok
  then ()
  else if rc = e_stop_test
  then raise Stop_test
  else if rc = e_assume
  then raise Assume_rejected
  else if rc = e_invalid_arg
  then raise (Usage_error (c_last_error_message ctx))
  else (
    let label =
      if rc = e_backend
      then "backend error"
      else if rc = e_invalid_handle
      then "invalid handle"
      else if rc = e_already_complete
      then "test case already complete"
      else if rc = e_not_complete
      then "previous test case not complete"
      else if rc = e_internal
      then "internal error"
      else if rc = e_concurrent_use
      then "concurrent use of a test-case or collection handle"
      else Printf.sprintf "unknown error code %d" rc
    in
    let msg = c_last_error_message ctx in
    let detail = if String.length msg = 0 then "" else ": " ^ msg in
    raise (Internal_error (label ^ detail)))
;;

(* ------------------------------------------------------------------ *)
(* Diagnostics                                                         *)
(* ------------------------------------------------------------------ *)

let version ctx =
  let out = allocate str "" in
  check_rc ctx (c_version ctx out);
  !@out
;;

(* ------------------------------------------------------------------ *)
(* Test context                                                       *)
(* ------------------------------------------------------------------ *)

let context_free ctx = ignore (c_context_free ctx : int)

let initialize =
  memoize (fun () ->
    (* Resolve the full ABI before exposing a context. *)
    List.iter (fun initialize -> initialize ()) (List.rev !binding_initializers);
    binding_initializers := [])
;;

let context_new () =
  initialize ();
  c_context_new ()
;;

(* ------------------------------------------------------------------ *)
(* Settings                                                            *)
(* ------------------------------------------------------------------ *)

let settings_new ctx =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_settings_new ctx out);
  !@out
;;

let settings_free ctx s = check_rc ctx (c_settings_free ctx s)
let settings_backend ctx s b = check_rc ctx (c_settings_backend ctx s (backend_to_int b))

let settings_test_cases ctx s n =
  check_rc ctx (c_settings_test_cases ctx s (Unsigned.UInt64.of_int n))
;;

let settings_verbosity ctx s v =
  check_rc ctx (c_settings_verbosity ctx s (verbosity_to_int v))
;;

let settings_nondeterminism_strictness ctx s n =
  check_rc
    ctx
    (c_settings_nondeterminism_strictness ctx s (nondeterminism_strictness_to_int n))
;;

let settings_seed ctx s = function
  | Some seed -> check_rc ctx (c_settings_seed ctx s (Unsigned.UInt64.of_int seed) true)
  | None -> check_rc ctx (c_settings_seed ctx s Unsigned.UInt64.zero false)
;;

let settings_derandomize ctx s b = check_rc ctx (c_settings_derandomize ctx s b)

let settings_report_multiple_failures ctx s b =
  check_rc ctx (c_settings_report_multiple_failures ctx s b)
;;

let settings_stop_on_first_failure ctx s b =
  check_rc ctx (c_settings_stop_on_first_failure ctx s b)
;;

let settings_show_statistics ctx s b = check_rc ctx (c_settings_show_statistics ctx s b)
let settings_database ctx s d = check_rc ctx (c_settings_database ctx s d)
let settings_database_key ctx s k = check_rc ctx (c_settings_database_key ctx s k)

let settings_test_location ctx s ~file ~begin_line ~class_name ~function_name =
  check_rc
    ctx
    (c_settings_test_location
       ctx
       s
       file
       (Unsigned.UInt32.of_int begin_line)
       class_name
       function_name)
;;

let settings_phases ctx s mask =
  check_rc ctx (c_settings_phases ctx s (Unsigned.UInt32.of_int mask))
;;

let settings_suppress_health_check ctx s mask =
  check_rc ctx (c_settings_suppress_health_check ctx s (Unsigned.UInt32.of_int mask))
;;

let settings_print_blob ctx s b = check_rc ctx (c_settings_print_blob ctx s b)

let settings_new_for_profile ctx name =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_settings_new_for_profile ctx name out);
  !@out
;;

let settings_register_profile ctx name s =
  check_rc ctx (c_settings_register_profile ctx name s)
;;

let set_default_profile ctx name =
  check_rc ctx (c_set_default_profile ctx (Option.value name ~default:""))

let settings_get_test_cases ctx s =
  let out = allocate uint64_t Unsigned.UInt64.zero in
  check_rc ctx (c_settings_get_test_cases ctx s out);
  Unsigned.UInt64.to_int !@out
;;

let settings_get_verbosity ctx s =
  let out = allocate int 0 in
  check_rc ctx (c_settings_get_verbosity ctx s out);
  verbosity_of_int !@out
;;

let settings_get_seed ctx s =
  let seed = allocate uint64_t Unsigned.UInt64.zero in
  let has_seed = allocate bool false in
  check_rc ctx (c_settings_get_seed ctx s seed has_seed);
  if !@has_seed then Some (Unsigned.UInt64.to_int !@seed) else None
;;

let get_bool getter ctx s =
  let out = allocate bool false in
  check_rc ctx (getter ctx s out);
  !@out
;;

let settings_get_derandomize ctx s = get_bool c_settings_get_derandomize ctx s

let settings_get_database ctx s =
  let out = allocate str_opt None in
  check_rc ctx (c_settings_get_database ctx s out);
  !@out
;;

let get_mask getter ctx s =
  let out = allocate uint32_t Unsigned.UInt32.zero in
  check_rc ctx (getter ctx s out);
  Unsigned.UInt32.to_int !@out
;;

let settings_get_phases ctx s = get_mask c_settings_get_phases ctx s

let settings_get_suppress_health_check ctx s =
  get_mask c_settings_get_suppress_health_check ctx s
;;

let settings_get_report_multiple_failures ctx s =
  get_bool c_settings_get_report_multiple_failures ctx s
;;

let settings_get_stop_on_first_failure ctx s =
  get_bool c_settings_get_stop_on_first_failure ctx s
;;

let settings_get_show_statistics ctx s = get_bool c_settings_get_show_statistics ctx s
let settings_get_print_blob ctx s = get_bool c_settings_get_print_blob ctx s

let settings_get_backend ctx s =
  let out = allocate int 0 in
  check_rc ctx (c_settings_get_backend ctx s out);
  backend_of_int !@out
;;

let settings_get_nondeterminism_strictness ctx s =
  let out = allocate int 0 in
  check_rc ctx (c_settings_get_nondeterminism_strictness ctx s out);
  nondeterminism_strictness_of_int !@out
;;

(* ------------------------------------------------------------------ *)
(* Run lifecycle                                                       *)
(* ------------------------------------------------------------------ *)

let run_start ctx s =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_run_start ctx s null_handle null_handle out);
  !@out
;;

let run_start_blob ctx s blob =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_run_start_blob ctx s blob null_handle null_handle out);
  !@out
;;

let next_test_case ctx run =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_next_test_case ctx run out);
  if is_null (raw !@out) then None else Some !@out
;;

let run_result ctx run =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_run_result ctx run out);
  !@out
;;

let run_free ctx run = check_rc ctx (c_run_free ctx run)
let run_result_free ctx r = check_rc ctx (c_run_result_free ctx r)
let failure_free ctx f = check_rc ctx (c_failure_free ctx f)
let test_case_free ctx tc = check_rc ctx (c_test_case_free ctx tc)

let test_case_clone ctx tc =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_test_case_clone ctx tc out);
  !@out
;;

let test_case_set_worker ctx tc ~worker_index =
  check_rc ctx (c_test_case_set_worker ctx tc (Int64.of_int worker_index))
;;

let test_case_block ctx tc ~indent =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_test_case_block ctx tc (Unsigned.UInt64.of_int indent) out);
  !@out
;;

let test_case_should_capture ctx tc =
  let out = allocate bool false in
  check_rc ctx (c_test_case_should_capture ctx tc out);
  !@out
;;

(* ------------------------------------------------------------------ *)
(* Per-test-case primitives                                            *)
(* ------------------------------------------------------------------ *)

(* Marshal an OCaml string list into a [const hegel_string_t *] paired with a GC
   root that pins its backing memory. The caller MUST {!Ctypes.Root.release} the
   returned root once the C side has copied the names; until then the root keeps
   the name buffers and the struct table alive.

   The explicit root is necessary because [CArray.of_list] copies each struct's
   [data] pointer and leaves the name's buffer unrooted, so the GC may free the
   names out from under the engine and cause flaky tests *)
let to_string_array = function
  | [] -> from_voidp Str.t null, Root.create ()
  | names ->
    let structs = List.map str_of_string names in
    let table = CArray.of_list Str.t structs in
    CArray.start table, Root.create (structs, table)
;;

let generate_boolean ctx tc p forced =
  let out_ptr = allocate bool false in
  let rc =
    match forced with
    | Some b -> c_generate_boolean ctx tc p b true out_ptr
    | None -> c_generate_boolean ctx tc p false false out_ptr
  in
  check_rc ctx rc;
  !@out_ptr
;;

let generate_integer ctx tc ~min_value ~max_value =
  let out = allocate int64_t 0L in
  check_rc
    ctx
    (c_generate_integer ctx tc (Int64.of_int min_value) (Int64.of_int max_value) out);
  Int64.to_int !@out
;;

let generate_float
      ctx
      tc
      ~min_value
      ~max_value
      ~allow_nan
      ~allow_infinity
      ~exclude_min
      ~exclude_max
      ~smallest_nonzero_magnitude
  =
  let out = allocate double 0.0 in
  check_rc
    ctx
    (c_generate_float
       ctx
       tc
       (Unsigned.UInt32.of_int 64)
       min_value
       max_value
       allow_nan
       allow_infinity
       exclude_min
       exclude_max
       smallest_nonzero_magnitude
       out);
  !@out
;;

let generate_bytes ctx tc ~min_size ~max_size =
  let result = make Bytes_result.t in
  let max_u =
    match max_size with
    | Some m -> Unsigned.UInt64.of_int m
    | None -> Unsigned.UInt64.max_int
  in
  check_rc
    ctx
    (c_generate_bytes ctx tc (Unsigned.UInt64.of_int min_size) max_u (addr result));
  let n = Unsigned.Size_t.to_int (getf result Bytes_result.len) in
  let data = getf result Bytes_result.data in
  let s = string_from_ptr (coerce (ptr uint8_t) (ptr char) data) ~length:n in
  ignore (c_generate_bytes_result_free ctx (addr result) : int);
  s
;;

(* Marshal an optional string list into a [const hegel_string_t *] + length + GC
   root, distinguishing three cases the text-generator API cares about: [None] →
   NULL (no restriction); [Some []] → a non-NULL pointer with length 0 (an
   explicit *empty* set); [Some names] → the names. *)
let optional_string_array = function
  | None -> from_voidp Str.t null, Root.create (), Unsigned.Size_t.of_int 0
  | Some [] ->
    (* A non-NULL pointer with length 0: the C side treats NULL and non-NULL
       empty differently (empty alphabet vs no restriction). *)
    let dummy = CArray.make Str.t 1 in
    CArray.start dummy, Root.create dummy, Unsigned.Size_t.of_int 0
  | Some names ->
    let ptr, root = to_string_array names in
    ptr, root, Unsigned.Size_t.of_int (List.length names)
;;

let string_generator_text
      ctx
      ~min_size
      ~max_size
      ~codec
      ~min_codepoint
      ~max_codepoint
      ~categories
      ~exclude_categories
      ~include_characters
      ~exclude_characters
  =
  let max_u =
    match max_size with
    | Some m -> Unsigned.UInt64.of_int m
    | None -> Unsigned.UInt64.max_int
  in
  let cats_ptr, cats_root, cats_len = optional_string_array categories in
  let excats_ptr, excats_root, excats_len = optional_string_array exclude_categories in
  let out = allocate handle_t null_handle in
  let rc =
    c_string_generator_text
      ctx
      (Unsigned.UInt64.of_int min_size)
      max_u
      codec
      (Unsigned.UInt32.of_int min_codepoint)
      (Unsigned.UInt32.of_int max_codepoint)
      cats_ptr
      cats_len
      excats_ptr
      excats_len
      (Option.value include_characters ~default:"")
      (Option.value exclude_characters ~default:"")
      out
  in
  Root.release cats_root;
  Root.release excats_root;
  check_rc ctx rc;
  !@out
;;

let string_generator_regex ctx ~pattern ~fullmatch =
  let out = allocate handle_t null_handle in
  check_rc
    ctx
    (c_string_generator_regex ctx pattern fullmatch null_handle out);
  !@out
;;

let string_generator_email ctx =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_string_generator_email ctx out);
  !@out
;;

let string_generator_url ctx =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_string_generator_url ctx out);
  !@out
;;

let string_generator_domain ctx ~max_length =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_string_generator_domain ctx (Unsigned.UInt64.of_int max_length) out);
  !@out
;;

let string_generator_free ctx sg = ignore (c_string_generator_free ctx sg : int)

let generate_string ctx tc sg =
  let result = make Str.t in
  check_rc ctx (c_generate_string ctx tc sg (addr result));
  let s = string_of_str result in
  ignore (c_owned_string_free ctx (addr result) : int);
  s
;;

module T = Temporal_types
open Temporal_types

let sat_unsigned bits n =
  let top = (1 lsl bits) - 1 in
  if n < 0 || n > top then top else n
;;

let sat_int32 n =
  if n < Int32.to_int Int32.min_int || n > Int32.to_int Int32.max_int
  then Int32.max_int
  else Int32.of_int n
;;

let u8 n = Unsigned.UInt8.of_int (sat_unsigned 8 n)
let u16 n = Unsigned.UInt16.of_int (sat_unsigned 16 n)
let u32 n = Unsigned.UInt32.of_int (sat_unsigned 32 n)

let make_date ({ year; month; day } : T.date) =
  let d = make Date_struct.t in
  setf d Date_struct.year (sat_int32 year);
  setf d Date_struct.month (u8 month);
  setf d Date_struct.day (u8 day);
  d
;;

let make_time ({ hour; minute; second; nanosecond } : T.time) =
  let t = make Time_struct.t in
  setf t Time_struct.hour (u8 hour);
  setf t Time_struct.minute (u8 minute);
  setf t Time_struct.second (u8 second);
  setf t Time_struct.nanosecond (u32 nanosecond);
  t
;;

let make_datetime ({ date; time } : T.datetime) =
  let dt = make Datetime_struct.t in
  setf dt Datetime_struct.date (make_date date);
  setf dt Datetime_struct.time (make_time time);
  dt
;;

let make_timestamp ({ second; nanosecond } : T.instant) =
  let t = make Timestamp_struct.t in
  setf t Timestamp_struct.second (Int64.of_int second);
  setf t Timestamp_struct.nanosecond (u32 nanosecond);
  t
;;

let make_duration ({ seconds; nanoseconds } : T.signed_duration) =
  let d = make Duration_struct.t in
  setf d Duration_struct.seconds (Int64.of_int seconds);
  setf d Duration_struct.nanoseconds (sat_int32 nanoseconds);
  d
;;

let read_date d : T.date =
  { year = Int32.to_int (getf d Date_struct.year)
  ; month = Unsigned.UInt8.to_int (getf d Date_struct.month)
  ; day = Unsigned.UInt8.to_int (getf d Date_struct.day)
  }
;;

let read_time t : T.time =
  { hour = Unsigned.UInt8.to_int (getf t Time_struct.hour)
  ; minute = Unsigned.UInt8.to_int (getf t Time_struct.minute)
  ; second = Unsigned.UInt8.to_int (getf t Time_struct.second)
  ; nanosecond = Unsigned.UInt32.to_int (getf t Time_struct.nanosecond)
  }
;;

let read_datetime dt : T.datetime =
  { date = read_date (getf dt Datetime_struct.date)
  ; time = read_time (getf dt Datetime_struct.time)
  }
;;

let read_timestamp t : T.instant =
  { second = Int64.to_int (getf t Timestamp_struct.second)
  ; nanosecond = Unsigned.UInt32.to_int (getf t Timestamp_struct.nanosecond)
  }
;;

let read_duration d : T.signed_duration =
  { seconds = Int64.to_int (getf d Duration_struct.seconds)
  ; nanoseconds = Int32.to_int (getf d Duration_struct.nanoseconds)
  }
;;

let precision_to_int : T.precision -> int = function
  | Nanoseconds -> 0
  | Microseconds -> 1
  | Milliseconds -> 2
  | Seconds -> 3
  | Minutes -> 4
  | Hours -> 5
;;

let granularity_to_int : T.granularity -> int = function
  | Hours -> 0
  | Quarter_hours -> 1
  | Minutes -> 2
  | Seconds -> 3
;;

let ambiguous_to_int : T.ambiguous -> int = function
  | Both -> 0
  | Earlier -> 1
  | Later -> 2
;;

let span_sign_to_int : T.span_sign -> int = function
  | Uniform -> 0
  | Mixed -> 1
  | Non_negative -> 2
;;

let span_unit_to_int : T.span_unit -> int = function
  | Years -> 0
  | Months -> 1
  | Weeks -> 2
  | Days -> 3
  | Hours -> 4
  | Minutes -> 5
  | Seconds -> 6
  | Milliseconds -> 7
  | Microseconds -> 8
  | Nanoseconds -> 9
;;

let kind_of_int n : T.transition_kind =
  match Unsigned.UInt32.to_int n with
  | 0 -> Unique
  | 1 -> Gap
  | _ -> Fold
;;

let utc_offset seconds known : T.utc_offset =
  if known then Known (Int32.to_int seconds) else Unknown
;;

let all_tags : T.tag list =
  [ Fixed
  ; Whole_hour
  ; Fractional
  ; Seconds
  ; Dst
  ; Dst_other
  ; Multi
  ; Base_change
  ; Midnight
  ; Spans_midnight
  ; Whole_day
  ; Same_offset
  ; Undefined
  ; Link
  ; Legacy
  ; Inverted_sign
  ]
;;

type spec_kind =
  | Date_options
  | Timezone_spec
  | Zoned_spec
  | Span_spec

type spec
#ifdef OXCAML
  : value mod portable contended
#endif
  =
  { kind : spec_kind
  ; spec : handle
  }
#ifdef OXCAML
[@@unsafe_allow_any_mode_crossing]
#endif

let spec_free { kind; spec } =
  let free =
    match kind with
    | Date_options -> c_date_options_free
    | Timezone_spec -> c_timezone_spec_free
    | Zoned_spec -> c_zoned_spec_free
    | Span_spec -> c_span_spec_free
  in
  ignore (free null_handle spec : int)
;;

let build_spec ctx kind create configure =
  let out = allocate handle_t null_handle in
  check_rc ctx (create ctx out);
  let built = { kind; spec = !@out } in
  match configure built.spec with
  | () -> built
  | exception e ->
    spec_free built;
    raise e
;;

let free_when_unreachable free value = Gc.finalise free value
let zone_source_id source = Ctypes.raw_address_of_ptr (raw source)

let tzdb_version ctx =
  let out = allocate str "" in
  check_rc ctx (c_tzdb_version ctx out);
  !@out
;;

let date_options_new ctx ~weekdays ~months =
  build_spec ctx Date_options c_date_options_new (fun options ->
    check_rc ctx (c_date_options_set_weekdays ctx options (u32 weekdays));
    check_rc ctx (c_date_options_set_months ctx options (u32 months)))
;;

let generate_date ctx tc ~min_value ~max_value options =
  let result = make Date_struct.t in
  check_rc
    ctx
    (c_generate_date
       ctx
       tc
       (make_date min_value)
       (make_date max_value)
       options.spec
       (addr result));
  read_date result
;;

let generate_time ctx tc ~min_value ~max_value ~precision =
  let result = make Time_struct.t in
  check_rc
    ctx
    (c_generate_time
       ctx
       tc
       (make_time min_value)
       (make_time max_value)
       (u32 (precision_to_int precision))
       (addr result));
  read_time result
;;

let generate_datetime ctx tc ~min_value ~max_value ~precision =
  let result = make Datetime_struct.t in
  check_rc
    ctx
    (c_generate_datetime
       ctx
       tc
       (make_datetime min_value)
       (make_datetime max_value)
       (u32 (precision_to_int precision))
       (addr result));
  read_datetime result
;;

let generate_instant ctx tc ~min_value ~max_value ~precision =
  let result = make Timestamp_struct.t in
  check_rc
    ctx
    (c_generate_timestamp
       ctx
       tc
       (make_timestamp min_value)
       (make_timestamp max_value)
       (u32 (precision_to_int precision))
       (addr result));
  read_timestamp result
;;

let generate_offset ctx tc ~min_value ~max_value ~granularity ~unknown =
  let result = make Offset_struct.t in
  check_rc
    ctx
    (c_generate_offset
       ctx
       tc
       (sat_int32 min_value)
       (sat_int32 max_value)
       (u32 (granularity_to_int granularity))
       unknown
       (addr result));
  utc_offset (getf result Offset_struct.seconds) (getf result Offset_struct.known)
;;

let generate_duration ctx tc ~min_value ~max_value ~precision =
  let result = make Duration_struct.t in
  check_rc
    ctx
    (c_generate_duration
       ctx
       tc
       (make_duration min_value)
       (make_duration max_value)
       (u32 (precision_to_int precision))
       (addr result));
  read_duration result
;;

let span_spec_new ctx ~bounds ~sign =
  build_spec ctx Span_spec c_span_spec_new (fun spec ->
    check_rc ctx (c_span_spec_set_sign ctx spec (u32 (span_sign_to_int sign)));
    List.iter
      (fun (unit, min_value, max_value) ->
         check_rc
           ctx
           (c_span_spec_set_unit_bounds
              ctx
              spec
              (u32 (span_unit_to_int unit))
              (Int64.of_int min_value)
              (Int64.of_int max_value)))
      bounds)
;;

let generate_span ctx tc spec =
  (
    let result = make Span_struct.t in
    check_rc ctx (c_generate_span ctx tc spec.spec (addr result));
    let get i = Int64.to_int (getf result (List.nth Span_struct.units i)) in
    ({ years = get 0
     ; months = get 1
     ; weeks = get 2
     ; days = get 3
     ; hours = get 4
     ; minutes = get 5
     ; seconds = get 6
     ; milliseconds = get 7
     ; microseconds = get 8
     ; nanoseconds = get 9
     }
     : T.span))
;;

type zone_source = handle

let zone_source_bundled =
  memoize (fun () ->
    let ctx = context_new () in
    Fun.protect
      ~finally:(fun () -> context_free ctx)
      (fun () ->
         let out = allocate handle_t null_handle in
         check_rc ctx (c_zone_source_bundled ctx out);
         !@out))
;;

let zone_source_new ctx =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_zone_source_new ctx out);
  !@out
;;

let source_or_default = function
  | Some source -> source
  | None -> null_handle
;;

let read_resolution name civil r : T.zoned_datetime =
  { zone = { name; primary_name = name }
  ; civil
  ; kind = kind_of_int (getf r Resolution_struct.kind)
  ; offset_before =
      utc_offset
        (getf r Resolution_struct.offset_before)
        (getf r Resolution_struct.offset_known)
  ; offset_after =
      utc_offset
        (getf r Resolution_struct.offset_after)
        (getf r Resolution_struct.offset_known)
  ; fold = false
  ; offset =
      utc_offset
        (getf r Resolution_struct.offset_seconds)
        (getf r Resolution_struct.offset_known)
  ; instant = read_timestamp (getf r Resolution_struct.timestamp)
  }
;;

let timezone_resolve ctx source name civil =
  let result = make Resolution_struct.t in
  check_rc
    ctx
    (c_timezone_resolve_in
       ctx
       (source_or_default source)
       name
       (make_datetime civil)
       (addr result));
  read_resolution name civil result
;;

let timezone_offset_at ctx source name instant : T.zone_offset =
  let result = make Zone_offset_struct.t in
  check_rc
    ctx
    (c_timezone_offset_at_in
       ctx
       (source_or_default source)
       name
       (make_timestamp instant)
       (addr result));
  { offset =
      utc_offset
        (getf result Zone_offset_struct.offset_seconds)
        (getf result Zone_offset_struct.offset_known)
  ; is_dst = getf result Zone_offset_struct.is_dst
  ; abbreviation = string_of_str (getf result Zone_offset_struct.abbreviation)
  }
;;

let timezone_info ctx source name : T.zone_info option =
  let result = make Zone_info_struct.t in
  check_rc ctx (c_timezone_info_in ctx (source_or_default source) name (addr result));
  if getf result Zone_info_struct.known
  then (
    let mask = Unsigned.UInt32.to_int (getf result Zone_info_struct.tags) in
    Some
      { primary_name = string_of_str (getf result Zone_info_struct.primary_name)
      ; is_link = getf result Zone_info_struct.is_link
      ; rank = Unsigned.UInt16.to_int (getf result Zone_info_struct.rank)
      ; tags = List.filteri (fun bit _ -> mask land (1 lsl bit) <> 0) all_tags
      })
  else None
;;

let callback_message = function
  | Usage_error message | Failure message | Invalid_argument message -> message
  | exn -> Printexc.to_string exn
;;

let guarded ctx f =
  match f () with
  | () -> ok
  | exception exn ->
    if c_context_set_error ctx (callback_message exn) <> ok
    then
      ignore
        (c_context_set_error ctx "a zone source callback failed with a non-UTF-8 message"
         : int);
    e_invalid_arg
;;

let weekday_to_int : T.weekday -> int = function
  | Sunday -> 0
  | Monday -> 1
  | Tuesday -> 2
  | Wednesday -> 3
  | Thursday -> 4
  | Friday -> 5
  | Saturday -> 6
;;

let month_to_int : T.month -> int = function
  | January -> 1
  | February -> 2
  | March -> 3
  | April -> 4
  | May -> 5
  | June -> 6
  | July -> 7
  | August -> 8
  | September -> 9
  | October -> 10
  | November -> 11
  | December -> 12
;;

let set_zone_type target ({ offset_seconds; is_dst; abbreviation } : T.zone_type) =
  let abbreviation = str_of_string abbreviation in
  setf target Zone_type_struct.utoff (sat_int32 offset_seconds);
  setf target Zone_type_struct.is_dst is_dst;
  setf target Zone_type_struct.abbreviation abbreviation;
  abbreviation
;;

let set_rule_date target ({ day; time } : T.rule_date) =
  setf target Rule_date_struct.time (sat_int32 time);
  match day with
  | Julian day ->
    setf target Rule_date_struct.kind (u32 0);
    setf target Rule_date_struct.day (u16 day)
  | Zero_based day ->
    setf target Rule_date_struct.kind (u32 1);
    setf target Rule_date_struct.day (u16 day)
  | Month_week_day { month; week; weekday } ->
    setf target Rule_date_struct.kind (u32 2);
    setf target Rule_date_struct.month (u8 (month_to_int month));
    setf target Rule_date_struct.week (u8 week);
    setf target Rule_date_struct.weekday (u8 (weekday_to_int weekday))
;;

let zone_source_add_tzif ctx source name bytes =
  let buffer = str_of_string bytes in
  check_rc
    ctx
    (c_zone_source_add_tzif
       ctx
       source
       name
       (getf buffer Str.data)
       (getf buffer Str.len));
  ignore (Sys.opaque_identity buffer : Str.s structure)
;;

let zone_source_add_zone ctx source name ({ initial; transitions; after } : T.zone_data) =
  let data = make Zone_data_struct.t in
  let count = List.length transitions in
  let array = CArray.make Zone_transition_struct.t (max count 1) in
  let kept = ref [ set_zone_type (getf data Zone_data_struct.initial) initial ] in
  let keep abbreviation = kept := abbreviation :: !kept in
  List.iteri
    (fun i ({ instant; local_type } : T.zone_transition) ->
       let slot = CArray.get array i in
       setf slot Zone_transition_struct.instant (Int64.of_int instant);
       keep (set_zone_type (getf slot Zone_transition_struct.local_type) local_type);
       CArray.set array i slot)
    transitions;
  setf data Zone_data_struct.transitions (CArray.start array);
  setf data Zone_data_struct.transition_count (Unsigned.Size_t.of_int count);
  (match after with
   | Hold -> setf data Zone_data_struct.after (u32 0)
   | Rule { standard; dst } ->
     setf data Zone_data_struct.after (u32 1);
     keep (set_zone_type (getf data Zone_data_struct.standard) standard);
     (match dst with
      | None -> setf data Zone_data_struct.has_dst false
      | Some { local_type; starts; ends } ->
        setf data Zone_data_struct.has_dst true;
        keep (set_zone_type (getf data Zone_data_struct.dst) local_type);
        set_rule_date (getf data Zone_data_struct.dst_start) starts;
        set_rule_date (getf data Zone_data_struct.dst_end) ends)
   | Infer last_year ->
     setf data Zone_data_struct.after (u32 2);
     setf data Zone_data_struct.last_year (sat_int32 last_year));
  check_rc ctx (c_zone_source_add_zone ctx source name (addr data));
  ignore (Sys.opaque_identity (array, !kept) : _ * _)
;;

let zone_source_add_oracle
      ctx
      source
      name
      ~offset_at
      ~next_transition
      ~first_year
      ~last_year
      ~infer
  =
  let abbreviation = ref (str_of_string "") in
  let offset_callback _ callback_ctx instant out =
    guarded callback_ctx (fun () ->
      let local_type : T.zone_type = offset_at (Int64.to_int instant) in
      let text = str_of_string local_type.abbreviation in
      abbreviation := text;
      out |-> Zone_type_struct.utoff <-@ sat_int32 local_type.offset_seconds;
      out |-> Zone_type_struct.is_dst <-@ local_type.is_dst;
      out |-> Zone_type_struct.abbreviation <-@ text)
  in
  let next_callback =
    Option.map
      (fun next _ callback_ctx after found out ->
         guarded callback_ctx (fun () ->
           match next (Int64.to_int after) with
           | None -> found <-@ false
           | Some instant ->
             found <-@ true;
             out <-@ Int64.of_int instant))
      next_transition
  in
  let oracle = make Zone_oracle_struct.t in
  setf oracle Zone_oracle_struct.offset_at offset_callback;
  setf oracle Zone_oracle_struct.next_transition next_callback;
  setf oracle Zone_oracle_struct.user_data null;
  setf oracle Zone_oracle_struct.first_year (sat_int32 first_year);
  setf oracle Zone_oracle_struct.last_year (sat_int32 last_year);
  setf oracle Zone_oracle_struct.after (u32 (if infer then 2 else 0));
  check_rc ctx (c_zone_source_add_oracle ctx source name (addr oracle));
  ignore (Sys.opaque_identity (offset_callback, next_callback, abbreviation) : _ * _ * _)
;;

let zone_source_add_link ctx source name target =
  check_rc ctx (c_zone_source_add_link ctx source name target)
;;

let with_names names f =
  let strings = List.map str_of_string names in
  let array = CArray.of_list Str.t strings in
  let result = f (CArray.start array) (Unsigned.Size_t.of_int (List.length names)) in
  ignore (Sys.opaque_identity (strings, array) : _ * _);
  result
;;

let zone_source_declare ctx source names =
  with_names names (fun names count ->
    check_rc ctx (c_zone_source_declare ctx source names count))
;;

let loaders = ref []
let loaders_lock = Mutex.create ()

let zone_source_set_loader ctx source load =
  let callback _ callback_ctx _ name =
    guarded callback_ctx (fun () -> load (string_of_str name))
  in
  Mutex.protect loaders_lock (fun () -> loaders := callback :: !loaders);
  check_rc ctx (c_zone_source_set_loader ctx source callback null)
;;

let zone_source_set_version ctx source version =
  check_rc ctx (c_zone_source_set_version ctx source version)
;;

let zone_source_version ctx source =
  let out = allocate str "" in
  check_rc ctx (c_zone_source_version ctx source out);
  !@out
;;

let set_default_zone_source ctx source = check_rc ctx (c_set_default_zone_source ctx source)

type zone_query
#ifdef OXCAML
  : value mod portable contended
#endif
  =
  { names : string list option
  ; links : bool
  ; legacy : bool
  ; unknown : bool
  ; opaque : bool
  ; source : zone_source option
  }
#ifdef OXCAML
[@@unsafe_allow_any_mode_crossing]
#endif

type zoned_bounds =
  | Civil_bounds of T.datetime * T.datetime
  | Instant_bounds of T.instant * T.instant

type zoned_query =
  { bounds : zoned_bounds
  ; precision : T.precision
  ; allow_imaginary : bool
  ; ambiguous : T.ambiguous
  }

let timezone_spec_new ctx query =
  build_spec ctx Timezone_spec c_timezone_spec_new (fun spec ->
    let source =
      match query.source with
      | Some source -> source
      | None -> zone_source_bundled ()
    in
    check_rc ctx (c_timezone_spec_set_source ctx spec source);
    check_rc ctx (c_timezone_spec_set_opaque ctx spec query.opaque);
    Option.iter
      (fun names ->
         with_names names (fun names count ->
           check_rc ctx (c_timezone_spec_set_names ctx spec names count)))
      query.names;
    check_rc ctx (c_timezone_spec_set_links ctx spec query.links);
    check_rc ctx (c_timezone_spec_set_legacy ctx spec query.legacy);
    check_rc ctx (c_timezone_spec_set_unknown ctx spec query.unknown))
;;

let take_owned_string ctx s =
  let text = string_of_str s in
  ignore (c_owned_string_free ctx (addr s) : int);
  text
;;

let generate_timezone ctx tc spec =
  let result = make Str.t in
  check_rc ctx (c_generate_timezone ctx tc spec.spec (addr result));
  take_owned_string ctx result
;;

let zoned_spec_new ctx query =
  build_spec ctx Zoned_spec c_zoned_spec_new (fun spec ->
    check_rc ctx (c_zoned_spec_set_precision ctx spec (u32 (precision_to_int query.precision)));
    (match query.bounds with
     | Civil_bounds (min_value, max_value) ->
       check_rc
         ctx
         (c_zoned_spec_set_civil_bounds
            ctx
            spec
            (make_datetime min_value)
            (make_datetime max_value))
     | Instant_bounds (min_value, max_value) ->
       check_rc
         ctx
         (c_zoned_spec_set_instant_bounds
            ctx
            spec
            (make_timestamp min_value)
            (make_timestamp max_value)));
    check_rc
      ctx
      (c_zoned_spec_set_imaginary ctx spec (u32 (if query.allow_imaginary then 0 else 1)));
    check_rc
      ctx
      (c_zoned_spec_set_ambiguous ctx spec (u32 (ambiguous_to_int query.ambiguous))))
;;

let generate_zoned_datetime ctx tc tz_spec spec =
  (
      let value = make Zoned_struct.t in
      let name = make Str.t in
      check_rc
        ctx
        (c_generate_zoned_datetime ctx tc tz_spec.spec spec.spec (addr value) (addr name));
      let name = take_owned_string ctx name in
      let known = getf value Zoned_struct.offset_known in
      ({ zone = { name; primary_name = name }
       ; civil = read_datetime (getf value Zoned_struct.civil)
       ; kind = kind_of_int (getf value Zoned_struct.kind)
       ; offset_before = utc_offset (getf value Zoned_struct.offset_before) known
       ; offset_after = utc_offset (getf value Zoned_struct.offset_after) known
       ; fold = getf value Zoned_struct.fold
       ; offset = utc_offset (getf value Zoned_struct.offset_seconds) known
       ; instant = read_timestamp (getf value Zoned_struct.timestamp)
       }
       : T.zoned_datetime))
;;

let generate_ip_bytes ctx tc c_fn n =
  let buf = CArray.make uint8_t n in
  check_rc ctx (c_fn ctx tc (CArray.start buf));
  string_from_ptr (coerce (ptr uint8_t) (ptr char) (CArray.start buf)) ~length:n
;;

let generate_ipv4 ctx tc = generate_ip_bytes ctx tc c_generate_ipv4 4
let generate_ipv6 ctx tc = generate_ip_bytes ctx tc c_generate_ipv6 16

let start_span ctx tc label =
  check_rc ctx (c_start_span ctx tc (Unsigned.UInt64.of_int64 label))
;;

let label_from_name ctx name =
  let out = allocate uint64_t Unsigned.UInt64.zero in
  check_rc ctx (c_label_from_name ctx name out);
  Unsigned.UInt64.to_int64 !@out
;;

let label_combine ctx labels =
  let arr = CArray.of_list uint64_t (List.map Unsigned.UInt64.of_int64 labels) in
  let out = allocate uint64_t Unsigned.UInt64.zero in
  check_rc
    ctx
    (c_label_combine
       ctx
       (CArray.start arr)
       (Unsigned.Size_t.of_int (CArray.length arr))
       out);
  Unsigned.UInt64.to_int64 !@out
;;

let stop_span ctx tc discard = check_rc ctx (c_stop_span ctx tc discard)

let new_collection ctx tc ~min_size ~max_size =
  let out = allocate handle_t null_handle in
  let max_u =
    match max_size with
    | Some m -> Unsigned.UInt64.of_int m
    | None -> Unsigned.UInt64.max_int
  in
  check_rc ctx (c_new_collection ctx tc (Unsigned.UInt64.of_int min_size) max_u out);
  !@out
;;

let collection_more ctx tc collection =
  let out = allocate bool false in
  check_rc ctx (c_collection_more ctx tc collection out);
  !@out
;;

let collection_reject ctx tc collection why =
  check_rc ctx (c_collection_reject ctx tc collection why)
;;

let collection_free ctx collection = check_rc ctx (c_collection_free ctx collection)

let new_pool ctx tc =
  let out = allocate handle_t null_handle in
  check_rc ctx (c_new_pool ctx tc out);
  !@out
;;

let pool_add ctx tc ~pool =
  let out = allocate int64_t 0L in
  check_rc ctx (c_pool_add ctx tc pool out);
  Int64.to_int !@out
;;

let pool_generate ctx tc ~pool ~consume =
  let out = allocate int64_t 0L in
  check_rc ctx (c_pool_generate ctx tc pool consume out);
  Int64.to_int !@out
;;

let pool_restore ctx tc ~pool ~variable_id =
  check_rc ctx (c_pool_restore ctx tc pool (Int64.of_int variable_id))
;;

let pool_free ctx pool = check_rc ctx (c_pool_free ctx pool)

let new_state_machine ctx tc ~min_concurrency ~max_concurrency ~step_count =
  let out = allocate handle_t null_handle in
  check_rc
    ctx
    (c_new_state_machine
       ctx
       tc
       (Int64.of_int min_concurrency)
       (Int64.of_int max_concurrency)
       (Int64.of_int step_count)
       out);
  !@out
;;

let state_machine_add_rule ctx tc ~state_machine ~name ~weight ~groups =
  let groups = CArray.of_list int64_t (List.map Int64.of_int groups) in
  check_rc
    ctx
    (c_state_machine_add_rule
       ctx
       tc
       state_machine
       name
       weight
       (CArray.start groups)
       (Unsigned.Size_t.of_int (CArray.length groups)))
;;

let state_machine_add_invariant ctx tc ~state_machine ~name ~always_check =
  check_rc ctx (c_state_machine_add_invariant ctx tc state_machine name always_check)
;;

let state_machine_start ctx tc ~state_machine =
  let out = allocate int64_t 0L in
  check_rc ctx (c_state_machine_start ctx tc state_machine out);
  Int64.to_int !@out
;;

(* [HEGEL_STATE_MACHINE_DONE]: written to the out parameter by
   [hegel_state_machine_next_group] when the state machine has terminated and by
   [hegel_state_machine_next_rule] when the worker's round is over. *)
let state_machine_done = Int64.min_int

let read_index out =
  let v = !@out in
  if Int64.equal v state_machine_done then None else Some (Int64.to_int v)
;;

let state_machine_next_group ctx tc ~state_machine =
  let out = allocate int64_t 0L in
  check_rc ctx (c_state_machine_next_group ctx tc state_machine out);
  read_index out
;;

let state_machine_next_rule ctx tc ~state_machine ~worker_index =
  let out = allocate int64_t 0L in
  check_rc
    ctx
    (c_state_machine_next_rule ctx tc state_machine (Int64.of_int worker_index) out);
  read_index out
;;

let state_machine_rule_rejected ctx tc ~state_machine ~worker_index =
  check_rc
    ctx
    (c_state_machine_rule_rejected ctx tc state_machine (Int64.of_int worker_index))
;;

let state_machine_should_check_invariant ctx tc ~state_machine ~invariant_index =
  let out = allocate bool false in
  check_rc
    ctx
    (c_state_machine_should_check_invariant
       ctx
       tc
       state_machine
       (Int64.of_int invariant_index)
       out);
  !@out
;;

let state_machine_free ctx state_machine =
  check_rc ctx (c_state_machine_free ctx state_machine)
;;

let target ctx tc value label = check_rc ctx (c_target ctx tc value label)
let event ctx tc label = check_rc ctx (c_event ctx tc label)
let event_value ctx tc value label = check_rc ctx (c_event_value ctx tc value label)

