module Sexp = Sexplib0.Sexp

#ifdef OXCAML
#define CROSSING : value mod contended
#define MODE(m) @ m
#define KIND(k) : k
#define PORTABLE @@ portable
#define MODALITY(m) @@ m
#else
#define CROSSING
#define MODE(m)
#define KIND(k)
#define PORTABLE
#define MODALITY(m)
#endif

(** Span labels. A label identifies a generator to the engine, which treats
    two spans with the same label as coming from the same generator when it
    shrinks and mutates test cases, and does nothing else with it. [from_name]
    and [combine] are the hashes [hegel_label_from_name] and
    [hegel_label_combine] compute (64-bit FNV-1a over the name's bytes, or over
    the labels' little-endian bytes in order), done in OCaml so a generator
    definition doesn't load libhegel to compute the label.
    A composite generator computes its label by combining the labels of its
    component generators. *)
module Labels = struct
  let fnv_prime = 0x100000001b3L
  let fnv_offset_basis = 0xcbf29ce484222325L
  let step h c = Int64.mul (Int64.logxor h (Int64.of_int (Char.code c))) fnv_prime
  let from_name name = String.fold_left step fnv_offset_basis name

  let combine labels =
    let b = Bytes.create 8 in
    List.fold_left
      (fun h l ->
         Bytes.set_int64_le b 0 l;
         Bytes.fold_left step h b)
      fnv_offset_basis
      labels
  ;;

  let list = from_name "hegel_ocaml.list"
  let set = from_name "hegel_ocaml.set"
  let assoc_list = from_name "hegel_ocaml.assoc_list"
  let hash_table = from_name "hegel_ocaml.hash_table"
  let tuple = from_name "hegel_ocaml.tuple"
  let one_of = from_name "hegel_ocaml.one_of"
  let optional = from_name "hegel_ocaml.optional"
  let fixed_dict = from_name "hegel_ocaml.fixed_dict"
  let flat_map = from_name "hegel_ocaml.flat_map"
  let filter = from_name "hegel_ocaml.filter"
  let mapped = from_name "hegel_ocaml.map"
  let enum_variant = from_name "hegel_ocaml.enum_variant"
  let pool = from_name "hegel_ocaml.pool"
  let function_ = from_name "hegel_ocaml.function"
  let function_result = from_name "hegel_ocaml.function_result"
  let stateful_rule = from_name "hegel_ocaml.stateful.rule"
end

(** The pure generation structure of a generator, carrying no printer. A
    {!generator} is a {!core} paired (or not) with a printer; see {!generator}.

    - [Leaf] cores hold a [draw] closure that performs a single engine draw (via
      one of the typed {!Internal} primitives) and returns the typed value.
      Mapping a [Leaf] composes the closure in place, staying a leaf (no extra
      span), because the engine already wraps each primitive draw in its own
      span.
    - [Mapped] cores wrap a source and a transform function.
    - [FlatMapped] cores wrap a source and a function returning a core.
    - [Filtered] cores wrap a source and a predicate.
    - [CompositeList] cores use the collection protocol to generate lists of
      non-basic elements, creating a fresh collection per generate call.
    - [Composite] cores wrap a [generate_fn] thunk inside a span with the given
      [label]. Used for tuples and one_of with non-basic elements.

    Every core carries its span [label] (see {!Labels}), fixed at construction
    from the core's own kind and its components' labels. *)

type 'a core CROSSING =
  | Leaf :
      { draw : (Internal.test_case -> 'a)
      ; label : int64
      }
      -> 'a core
  | Mapped :
      { source : 'b core
      ; f : ('b -> 'a)
      ; label : int64
      }
      -> 'a core
  | FlatMapped :
      { source : 'b core
      ; f : ('b -> 'a core)
      ; label : int64
      }
      -> 'a core
  | Filtered :
      { source : 'a core
      ; predicate : ('a -> bool)
      ; label : int64
      }
      -> 'a core
  | CompositeList :
      { elements : 'a core
      ; min_size : int
      ; max_size : int option
      ; label : int64
      }
      -> 'a list core
  | Composite :
      { label : int64
      ; generate_fn : (Internal.test_case -> 'a)
      }
      -> 'a core
  | Values :
      { pool : Internal.pool
      ; consume : bool
      ; select : (Internal.test_case -> filter:(int64 * ('a -> bool)) option -> 'a)
      }
      -> 'a core
  | Function :
      { build : (name:string option -> Internal.test_case -> 'a)
      ; label : int64
      }
      -> 'a core

(** [label_of_core core] is the span label of [core]. *)
let label_of_core : type a. a core -> int64 = function
  | Leaf { label; _ } -> label
  | Mapped { label; _ } -> label
  | FlatMapped { label; _ } -> label
  | Filtered { label; _ } -> label
  | CompositeList { label; _ } -> label
  | Composite { label; _ } -> label
  | Values _ -> Labels.pool
  | Function { label; _ } -> label
;;

(** [opaque v] renders any value as [<opaque>]: the printer of a generator whose
    output type Hegel cannot print. *)
let opaque _ = Sexp.Atom "<opaque>"

(** A generator: a {!core} (how to generate) plus the printer {!draw} renders
    its value with on the final replay. Generators whose output type is the
    caller's ({!map}, {!just}, {!composite}, …) carry {!opaque} until
    {!with_printer} attaches a real one.

    Generators produce typed OCaml values and can be combined using {!map},
    {!flat_map}, and {!filter}. *)
type 'a generator CROSSING =
  { core : 'a core
  ; sexp_of : ('a -> Sexp.t)
  }

(** [leaf_label name] is the label of the primitive named [name]. *)
let leaf_label name = Labels.from_name ("hegel_ocaml." ^ name)

(** [leaf ~name ~draw ~sexp_of] builds a {!Leaf} generator. [draw] performs a
    single engine draw and returns the typed value; [sexp_of] renders it on the
    final replay; [name] identifies the primitive for its label. *)
let%template leaf
  : type a.
    name:string
    -> draw:(Internal.test_case -> a) MODE(m)
    -> sexp_of:(a -> Sexp.t) MODE(m)
    -> a generator MODE(m)
  =
  fun ~name ~draw ~sexp_of -> { core = Leaf { draw; label = leaf_label name }; sexp_of }
[@@mode m = (nonportable, portable)]
;;

(** [leaf_silent ~name ~draw] builds a {!Leaf} generator printing as {!opaque},
    for leaves whose output type has no known printer (e.g. {!just}). *)
let%template leaf_silent
  : type a. name:string -> draw:(Internal.test_case -> a) MODE(m) -> a generator MODE(m)
  =
  fun ~name ~draw -> { core = Leaf { draw; label = leaf_label name }; sexp_of = opaque }
[@@mode m = (nonportable, portable)]
;;

(** [label_of gen] is the span label of [gen]'s core. *)
let label_of : type a. a generator -> int64 = fun gen -> label_of_core gen.core

(** [with_printer sexp_of gen] attaches (or replaces) [gen]'s printer. This is
    how a [map]/[flat_map]/[sampled_from]/[just] result prints in full. *)
let%template with_printer
  : type a. (a -> Sexp.t) MODE(m) -> a generator MODE(m) -> a generator MODE(m)
  =
  fun sexp_of gen -> { core = gen.core; sexp_of }
[@@mode m = (nonportable, portable)]
;;

(** [printer gen] is the printer carried by [gen] ({!opaque} if none was
    attached). *)
let%template printer : type a. a generator MODE(m) -> (a -> Sexp.t) MODE(m) =
  fun gen -> gen.sexp_of
[@@mode m = (nonportable, portable)]
;;

(** [composite_with_label ~label generate_fn] builds a generator (printing as
    [<opaque>]) whose [generate_fn] draws run inside a span tagged [label]. Internal: it
    lets the library and the derive PPX tag composites with the right structural
    label (e.g. {!Labels.enum_variant}); user code uses {!composite}, which
    always tags the struct/record label. *)
let%template composite_with_label
  : type a.
    label:int64 -> (Internal.test_case -> a) MODE(m) -> a generator MODE(m)
  =
  fun ~label generate_fn -> { core = Composite { label; generate_fn }; sexp_of = opaque }
[@@mode m = (nonportable, portable)]
;;

(** [composite generate_fn] builds a generator (printing as [<opaque>]) from an imperative
    [generate_fn] that draws sub-values from the test case and returns a value.
    The draws run inside a {!Labels.fixed_dict} span (the struct/record
    grouping), so they are suppressed on the final replay and only an outer
    [draw] of the whole value prints. *)
let%template composite
  : type a. (Internal.test_case -> a) MODE(m) -> a generator MODE(m)
  =
  fun generate_fn ->
  (composite_with_label [@mode m]) ~label:Labels.fixed_dict generate_fn
[@@mode m = (nonportable, portable)]
;;

(** Maximum number of filter attempts before calling [assume false]. *)
let max_filter_attempts = 3

(** [group label data f] runs [f ()] inside a span with the given [label]. The
    span is stopped with [discard:false] regardless of whether [f] raises.

    A group also increments [draw_depth] for the duration of [f], marking [f]'s
    draws as nested so only the outermost value prints on the final replay. (A
    counter, not a flag, so nested groups compose.) *)
let group label data f =
  Internal.start_span ~label data;
  Internal.incr_draw_depth data;
  Fun.protect
    ~finally:(fun () ->
      Internal.decr_draw_depth data;
      Internal.stop_span data)
    f
;;

(** [discardable_group label data f] runs [f ()] inside a span with [label],
    incrementing [draw_depth] like {!group}. If [f] raises, the span is stopped
    with [discard:true]; otherwise [discard:false]. *)
let discardable_group label data f =
  Internal.start_span ~label data;
  Internal.incr_draw_depth data;
  match f () with
  | v ->
    Internal.decr_draw_depth data;
    Internal.stop_span data;
    v
  | exception e ->
    Internal.decr_draw_depth data;
    Internal.stop_span ~discard:true data;
    raise e
;;

(** A collection handle for generating variable-length sequences.

    Collections ask the engine when to stop generating elements. The [finished]
    flag short-circuits subsequent {!collection_more} calls once the engine
    signals completion. The engine-side collection is created on first use and
    released when the {!with_collection} scope that owns it ends. *)
type collection =
  { mutable finished : bool
  ; mutable handle : Internal.collection option
  ; min_size : int
  ; max_size : int option
  }

(** [get_collection coll data] initializes the engine-side collection and
    returns its handle. Raises {!Internal.Stop_test} on StopTest. *)
let get_collection coll data =
  match coll.handle with
  | Some h -> h
  | None ->
    let h =
      Internal.new_collection data ~min_size:coll.min_size ~max_size:coll.max_size
    in
    coll.handle <- Some h;
    h
;;

(** [with_collection ~min_size ?max_size data f] runs [f coll] with a new
    collection and releases the engine-side handle after. *)
let with_collection ~min_size ?max_size data f =
  let coll = { finished = false; handle = None; min_size; max_size } in
  Fun.protect
    ~finally:(fun () ->
      Option.iter
        (fun collection -> Internal.collection_free data ~collection)
        coll.handle)
    (fun () -> f coll)
;;

(** [collection_more coll data] returns [true] if more elements should be
    generated, [false] when the collection is complete. Once it returns [false],
    subsequent calls return [false] immediately. Raises
    {!Internal.Stop_test} on StopTest. *)
let collection_more coll data =
  if coll.finished
  then false
  else (
    let collection = get_collection coll data in
    let more = Internal.collection_more data ~collection in
    if not more then coll.finished <- true;
    more)
;;

(** [collection_reject coll data] rejects the last element of the collection.
    No-op if the collection is already finished. Raises
    {!Internal.Stop_test} on StopTest. *)
let collection_reject coll data =
  if not coll.finished
  then (
    let collection = get_collection coll data in
    Internal.collection_reject data ~collection)
;;

(* separated out for unit testing *)
let resolve_pool_draw ~find ~remove ~consume variable_id =
  match find variable_id with
  | Some v ->
    if consume then remove variable_id;
    v
  | None ->
    (* State diverged between the engine and the client, or a bug in the pool
       bookkeeping. *)
    raise Internal.Flaky_strategy
;;

let pick tc ~find ~remove ~is_empty pool ~consume =
  Internal.assume tc (not (is_empty ()));
  let variable_id = Internal.pool_generate tc ~pool ~consume () in
  variable_id, resolve_pool_draw ~find ~remove ~consume variable_id
;;

(* A filter on a consuming pool draw. Each attempt consumes its id in libhegel
   only. An accepted value is then removed from the OCaml pool, and every other
   consumed id is restored. *)
let filter_consumed ~size ~pick ~remove ~pool tc (label, predicate) =
  let rejected = ref [] in
  let restore () =
    List.iter (fun variable_id -> Internal.pool_restore tc ~pool ~variable_id) !rejected
  in
  let rec attempt i =
    if i > max_filter_attempts || size () <= List.length !rejected
    then raise Internal.Assume_rejected
    else (
      Internal.start_span ~label tc;
      let variable_id, value = pick tc in
      rejected := variable_id :: !rejected;
      (* unconditional cons b/c predicate can raise *)
      if predicate value
      then (
        remove variable_id;
        rejected := List.tl !rejected; (* pop accepted *)
        Internal.stop_span tc;
        value)
      else (
        Internal.stop_span ~discard:true tc;
        attempt (i + 1)))
  in
  match attempt 1 with
  | value ->
    restore ();
    value
  | exception exn ->
    let backtrace = Printexc.get_raw_backtrace () in
    restore ();
    Printexc.raise_with_backtrace exn backtrace
;;

(** Defined for convenience *)
module Int_key = struct
  type t = int

  let equal = Int.equal
  let hash = Stdlib.Hashtbl.hash
end

#ifdef OXCAML
module Int_table = Stdlib.Hashtbl.MakePortable (Int_key)
#else
module Int_table = Stdlib.Hashtbl.Make (Int_key)
#endif

(** [resolve_draw values ~consume variable_id] resolves a drawn pool id against
    an OCaml-side table, removing it when [consume]. Raises [Internal.Flaky_strategy] 
    on an unknown id. *)
let resolve_draw values ~consume variable_id =
  resolve_pool_draw
    ~find:(fun id -> Int_table.find_opt values id)
    ~remove:(fun id -> Int_table.remove values id)
    ~consume
    variable_id
;;

(** [Int_pool] is the pool for a sequential machine *)
module Int_pool = struct
  module Tbl = Int_table

  type 'a t =
    { pool : Internal.pool
    ; values : 'a Tbl.t
    ; clone : 'a -> 'a
    }

  let create tc ~clone = { pool = Internal.new_pool tc; values = Tbl.create 16; clone }

  let add t tc value =
    let variable_id = Internal.pool_add tc ~pool:t.pool in
    Tbl.replace t.values variable_id value
  ;;

  let size t = Tbl.length t.values

  let pool_values { pool; values; clone } ~consume =
    let clone = if consume then Fun.id else clone in
    let pick tc ~remove =
      pick
        tc
        ~find:(fun id -> Option.map clone (Tbl.find_opt values id))
        ~remove
        ~is_empty:(fun () -> Tbl.length values = 0)
        pool
        ~consume
    in
    { core =
        Values
          { pool
          ; consume
          ; select =
              (fun tc ~filter ->
                match filter with
                | None -> snd (pick tc ~remove:(Tbl.remove values))
                | Some filter ->
                  filter_consumed
                    ~size:(fun () -> Tbl.length values)
                    ~pick:(pick ~remove:ignore)
                    ~remove:(Tbl.remove values)
                    ~pool
                    tc
                    filter)
          }
    ; sexp_of = opaque
    }
  ;;
end

#ifdef OXCAML
module%template [@mode portable] Lock = Locked
module%template [@mode nonportable] Lock = Locked.Nonportable
#else
module Lock = Locked
#endif

(** [Int_pool_concurrent] is the thread-safe pool for a concurrent machine. Its
    portable instance locks with a capsule, and its nonportable one with a
    mutex. *)
module%template Int_pool_concurrent = struct
  module Tbl = Int_table
  module L = Lock [@mode m]

  type ('a KIND(value mod m c)) t KIND(value mod m c) =
    { pool : Internal.pool
    ; values : 'a Tbl.t L.t
    ; clone : ('a -> 'a) MODALITY(m)
    }

  let create tc ~clone =
    { pool = Internal.new_pool tc
    ; values = L.create (fun () -> Tbl.create 16)
    ; clone
    }
  ;;

  let add t tc value =
    L.protect t.values (fun values ->
      let variable_id = Internal.pool_add tc ~pool:t.pool in
      Tbl.replace values variable_id value)
  ;;

  let size t = L.protect t.values Tbl.length

  let pool_values { pool; values; clone } ~consume =
    let clone = if consume then Fun.id else clone in
    let pick tc values ~remove =
      pick
        tc
        ~find:(fun id -> Option.map clone (Tbl.find_opt values id))
        ~remove
        ~is_empty:(fun () -> Tbl.length values = 0)
        pool
        ~consume
    in
    { core =
        Values
          { pool
          ; consume
          ; select =
              (fun tc ~filter ->
                match filter with
                | None ->
                  L.protect values (fun values ->
                    snd (pick tc values ~remove:(Tbl.remove values)))
                | Some filter ->
                  filter_consumed
                    ~size:(fun () -> L.protect values Tbl.length)
                    ~pick:(fun tc ->
                      L.protect values (fun values -> pick tc values ~remove:ignore))
                    ~remove:(fun id -> L.protect values (fun values -> Tbl.remove values id))
                    ~pool
                    tc
                    filter)
          }
    ; sexp_of = opaque
    }
  ;;
end
[@@mode (m, c) = ((portable, contended), (nonportable, uncontended))]

(* A filter over a filter checks both predicates in one round of attempts, so a
   consuming pool under the chain sees every predicate at once. *)
let rec flatten_filter (core : 'a core) (predicate : 'a -> bool) =
  match core with
  | Filtered { source; predicate = inner; _ } ->
    flatten_filter source (fun value -> inner value && predicate value)
  | _ -> core, predicate
;;

(** [do_draw core data] produces a typed value from generation structure [core]
    using the given test case [data]. *)
let rec do_draw : type a. a core -> Internal.test_case -> a =
  fun core data ->
  match core with
  | Leaf { draw; _ } -> draw data
  | Mapped { source; f; label } ->
    group label data (fun () ->
      let value = do_draw source data in
      f value)
  | FlatMapped { source; f; label } ->
    discardable_group label data (fun () ->
      let first = do_draw source data in
      let second_core = f first in
      do_draw second_core data)
  | Filtered { source; predicate; label } ->
    (match flatten_filter source predicate with
     | Values { consume = true; select; _ }, predicate ->
       select data ~filter:(Some (label, predicate)) (* consuming pools *)
     | source, predicate -> (* any other generator *)
       let rec attempt i =
         if i > max_filter_attempts
         then raise Internal.Assume_rejected
         else (
           Internal.start_span ~label data;
           let value = do_draw source data in
           if predicate value
           then (
             Internal.stop_span data;
             value)
           else (
             Internal.stop_span ~discard:true data;
             attempt (i + 1)))
       in
       attempt 1)
  | CompositeList { elements; min_size; max_size; label } ->
    group label data (fun () ->
      with_collection ~min_size ?max_size data (fun coll ->
        let rec collect acc =
          if collection_more coll data
          then collect (do_draw elements data :: acc)
          else List.rev acc
        in
        collect []))
  | Composite { label; generate_fn } -> group label data (fun () -> generate_fn data)
  | Values { select; _ } -> select data ~filter:None
  | Function { build; _ } -> build ~name:None data
;;


(** [draw_named ~label ~repeatable tc gen] is the naming-aware draw the
    [let%hegel_test] PPX rewrites bindings to; it is not intended for direct use
    (prefer {!draw}). On the final replay of a failing test (or on every case
    under verbose output), an outermost draw prints its value to the test case's
    print region as [name = value], where [name] is [label], printed bare on its
    sole use and numbered ([label_1], [label_2], …) when [repeatable] is set —
    which the PPX does for a binding name that is reused or drawn in a loop.
    Draws nested inside a span (e.g. composite elements) are suppressed so only
    the outermost value shows. *)
let draw_named
  : type a.
    label:string
    -> ?loc:Lexing.position
    -> repeatable:bool
    -> Internal.test_case
    -> a generator
    -> a
  =
  let open Lexing in
  fun ~label ?loc ~repeatable tc gen ->
    let location =
      Option.fold
        ~none:""
        ~some:(fun loc ->
          Printf.sprintf " @ %s:%s" loc.pos_fname (string_of_int loc.pos_lnum))
        loc
    in
    let sexp_of = gen.sexp_of in
    match gen.core with
    | Function { build; _ } ->
      let name = Internal.draw_display_name tc ~label ~repeatable in
      let value = build ~name:(Some name) tc in
      if Internal.draw_depth tc = 0
      then
        Internal.print_line tc [ Text (name ^ location ^ " = "); Value (sexp_of value) ];
      value
    | core ->
      let value = do_draw core tc in
      if Internal.draw_depth tc = 0
      then (
        let name = Internal.draw_display_name tc ~label ~repeatable in
        Internal.print_line tc [ Text (name ^ location ^ " = "); Value (sexp_of value) ]);
      value
;;

(** [draw ?label ?loc tc gen] produces a typed value from the
    generator [gen] using test case [tc].

    On the final replay of a failing test (or on every case under verbose
    output), an outermost draw prints its value through {!Internal.note} as
    [name = value]. The [name] is [label] when given, else ["draw"]; an
    unlabeled draw is numbered ([draw_1], [draw_2], …) while a [label] is
    printed bare. When [loc] is provided, the draw is printed as [draw @ loc].
    Draws nested inside a span (e.g. composite elements) are suppressed so only
    the outermost value shows. A generator with no printer prints as [<opaque>];
    attach one with {!with_printer}, or use {!draw_silent} to print nothing. *)
let draw ?label ?loc tc gen =
  draw_named
    ~label:(Option.value label ~default:"draw")
    ?loc
    ~repeatable:(Option.is_none label)
    tc
    gen
;;

(** [draw_silent tc gen] produces a typed value from any generator [gen] without
    recording it for the final-replay output. Use it for draws whose value is
    not a useful part of the printed counterexample, or for generators that
    carry no printer. *)
let draw_silent : type a. Internal.test_case -> a generator -> a =
  fun tc gen -> do_draw gen.core tc
;;

(** [draw_silent_named ~name tc gen] is {!draw_silent} threading the draw-site
    [name] into a function generator ({!Generators.functions}). Not intended for
    direct use (prefer {!draw_silent}). *)
let draw_silent_named
  : type a. name:string -> Internal.test_case -> a generator -> a
  =
  fun ~name tc gen ->
  match gen.core with
  | Function { build; _ } -> build ~name:(Some name) tc
  | core -> do_draw core tc
;;

(** [map f gen] transforms values from [gen] using [f]. The result prints as
    [<opaque>] (the output type is the user's); use {!with_printer} to print it
    in full.

    When [gen]'s core is a [Leaf], the draw closure is composed in place (no
    extra span); otherwise a [Mapped] core is created. *)
let%template map
  : type a b. (a -> b) MODE(m) -> a generator MODE(m) -> b generator MODE(m)
  =
  fun f gen ->
  match gen.core with
  | Leaf { draw; label } ->
    { core =
        Leaf
          { draw = (fun tc -> f (draw tc))
          ; label = Labels.combine [ Labels.mapped; label ]
          }
    ; sexp_of = opaque
    }
  | other ->
    { core =
        Mapped
          { source = other
          ; f
          ; label = Labels.combine [ Labels.mapped; label_of_core other ]
          }
    ; sexp_of = opaque
    }
[@@mode m = (nonportable, portable)]
;;

(** [flat_map f gen] creates a dependent generator. [f] receives the generated
    value and returns a generator whose value is the final result. The result
    prints as [<opaque>]; use {!with_printer} to print it in full. *)
let%template flat_map
  : type a b.
    (a -> b generator) MODE(m)
    -> a generator MODE(m)
    -> b generator MODE(m)
  =
  fun f gen ->
  let source = gen.core in
  { core =
      FlatMapped
        { source
        ; f = (fun x -> (f x).core)
        ; label = Labels.combine [ Labels.flat_map; label_of_core source ]
        }
  ; sexp_of = opaque
  }
[@@mode m = (nonportable, portable)]
;;

(** [filter predicate gen] filters values from [gen] using [predicate], keeping
    [gen]'s printer. Tries up to {!max_filter_attempts} times; calls
    [assume false] if all attempts fail. *)
let%template filter
  : type a. (a -> bool) MODE(m) -> a generator MODE(m) -> a generator MODE(m)
  =
  fun predicate gen ->
  { core =
      Filtered
        { source = gen.core
        ; predicate
        ; label = Labels.combine [ Labels.filter; label_of_core gen.core ]
        }
  ; sexp_of = gen.sexp_of
  }
[@@mode m = (nonportable, portable)]
;;

