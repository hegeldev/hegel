module Public = struct
  include Generators_core
  include Generators_primitives
  include Generators_collections
  include Generators_combinators
  include Generators_functions
end

include Public

#ifdef OXCAML
(* The compiler fills these arguments at the caller, including through aliases
   such as Hegel.draw. Forward explicitly so the core sees the original site. *)
let draw ?label ~(loc : [%call_pos]) tc gen =
  Generators_core.draw ?label ~loc tc gen
;;

let draw_named ~label ~(loc : [%call_pos]) ~repeatable tc gen =
  Generators_core.draw_named ~label ~loc ~repeatable tc gen
;;
#else
let draw = Generators_core.draw
let draw_named = Generators_core.draw_named
#endif

module Private = struct
  module Labels = Generators_core.Labels

  type collection = Generators_core.collection =
    { mutable finished : bool
    ; mutable handle : Internal.collection option
    ; min_size : int
    ; max_size : int option
    }

  let group = Generators_core.group
  let discardable_group = Generators_core.discardable_group
  let with_collection = Generators_core.with_collection
  let collection_more = Generators_core.collection_more
  let collection_reject = Generators_core.collection_reject
  let label_of = Generators_core.label_of

  let render_draw tc gen =
    let result = ref None in
    let shown =
      Printer.Out.with_document (fun printer ->
        result := Some (Generators_core.draw_and_print tc printer gen))
    in
    Option.get !result, shown
  ;;
end

module Ppx_internal = struct
  module Labels = Generators_core.Labels

  let draw_and_print (type a p) tc printer (gen : (a, p) Generators_core.generator) ~sexp_of =
    match gen with
    | Generators_core.Printable { core; _ } -> Generators_core.do_draw core tc printer
    | Generators_core.Unprintable { core } ->
      let value = Generators_core.do_draw core tc Printer.Out.noop in
      Printer.Out.sexp printer sexp_of value;
      value
  ;;

  let explicit_draw tc ~name ~source value (_ : _ Generators_core.generator) =
    Internal.explicit_draw tc ~name ~source value
  ;;

  let%template composite_with_label = (Generators_core.composite_with_label [@mode m])
  [@@mode m = (nonportable, portable)]
  ;;

  let%template with_printers = (Generators_core.with_printers [@mode m])
  [@@mode m = (nonportable, portable)]
  ;;

  let%template with_sexp_of = (Generators_core.with_sexp_of [@mode m])
  [@@mode m = (nonportable, portable)]
  ;;
end
