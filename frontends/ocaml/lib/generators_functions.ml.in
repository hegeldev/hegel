(** Generators for functions as test inputs, after Koen Claessen's
    {i Shrinking and Showing Functions}.

    A drawn function is backed by a per-test-case memo table. The first time it
    is applied to a given argument it draws a fresh result from [returns] and
    stores it, so repeated applications to the same argument return the same
    value.

    On the failing final replay each top-level application of the generated
    function is printed to the print region as [name arg = result] (see
    {!functions}). Applications nested inside a span (draw depth > 0) are
    suppressed, like any nested draw. [name] is the [?name] passed to the
    generator, else the draw-site binding name (via [let%hegel_test]), else
    ["function"]. *)

open Generators_core

#ifdef OXCAML
#define MODE(m) @ m
#else
#define MODE(m)
#endif

(* [make explicit_name print_args returns adapt] builds the shared function
   generator behind {!functions}/{!functions2}/{!functions3}. [adapt] is the
   identity function, or currying for the multi-argument variants.
   [print_args] displays the argument (or argument tuple) as the arguments of
   an application. The memo table keys on the argument itself via structural
   hash/equality. The shown name is [explicit_name] when the caller passed
   [~name], else the draw-site [name] (the binding, via the PPX), else
   ["function"]. *)
let%template make
  : type a b c p.
    string option
    -> (a -> Printer.doc list) MODE(m)
    -> (b, p) generator MODE(m)
    -> ((a -> b) -> c) MODE(m)
    -> (c, unprintable) generator MODE(m)
  =
  fun explicit_name print_args returns adapt ->
  let returns = (core_of [@mode m]) returns in
  let result_label = Labels.combine [ Labels.function_result; label_of_core returns ] in
  let build ~name tc =
    let display =
      match explicit_name with
      | Some n -> n
      | None -> Option.value name ~default:"function"
    in
    let table : (a, b * show) Stdlib.Hashtbl.t = Stdlib.Hashtbl.create 16 in
    let base arg =
      let (ret, show), is_fresh =
        match Stdlib.Hashtbl.find_opt table arg with
        | Some drawn -> drawn, false
        | None ->
          let drawn = group result_label tc (fun () -> do_draw returns tc) in
          Stdlib.Hashtbl.replace table arg drawn;
          drawn, true
      in
      (* print every function call in verbose/debug verbosity, print only the
         first invocation in normal verbosity. *)
      if Internal.draw_depth tc = 0 && (is_fresh || Internal.is_high_verbosity tc)
      then
        Internal.print_line
          tc
          (Printer.concat
             [ Printer.apply (Printer.text display) (print_args arg)
             ; Printer.text " = "
             ; show ()
             ]);
      ret
    in
    adapt base
  in
  Unprintable
    { core =
        Function
          { build; label = Labels.combine [ Labels.function_; label_of_core returns ] }
    }
[@@mode m = (nonportable, portable)]
;;

let%template sexp_or : type a. (a -> Sexp.t) option MODE(m) -> (a -> Sexp.t) MODE(m)
  = function
  | Some sexp_of -> sexp_of
  | None -> fun _ -> Sexp.Atom "<opaque>"
[@@mode m = (nonportable, portable)]
;;

(** [functions ?name ?sexp_of_arg ~returns ()] creates a generator for functions
    ['a -> 'b] whose results are drawn from [returns].

    The result carries no printer (its output type is a function), so draw it
    with {!Hegel.draw_silent}. Applying the drawn function to an argument draws
    a result from [returns] the first time that argument is seen and memoizes
    it.

    On the failing final replay each top-level application prints as
    [name arg = result] (applications nested inside a span are suppressed).
    [name] is [?name] when you pass it — an explicit label always wins — else
    the draw-site binding name, else ["function"].

    The memo table keys on the argument itself, so distinct arguments always get
    independent results. [sexp_of_arg] only renders the argument in the
    printed application, as an s-expression; an omitted [sexp_of_arg] shows
    [<opaque>]. The result prints as [returns] prints what it draws. *)
let%template functions
      ?name
      ?(sexp_of_arg : ('a -> Sexp.t) option MODE(m))
      ~(returns : ('b, _) generator MODE(m))
      ()
  : ('a -> 'b, unprintable) generator MODE(m)
  =
  let sexp_of_arg = (sexp_or [@mode m]) sexp_of_arg in
  (make [@mode m]) name (fun a -> [ Printer.of_sexp sexp_of_arg a ]) returns (fun f -> f)
[@@mode m = (nonportable, portable)]
;;

(** [functions2 ?name ?sexp_of_arg1 ?sexp_of_arg2 ~returns ()] creates a generator
    for curried two-argument functions ['a -> 'b -> 'c].

    Sugar over {!functions} keyed on the argument pair: the two arguments form
    one memo key, and an application prints uncurried, as
    [name (arg1 arg2) = result]. *)
let%template functions2
      ?name
      ?(sexp_of_arg1 : ('a -> Sexp.t) option MODE(m))
      ?(sexp_of_arg2 : ('b -> Sexp.t) option MODE(m))
      ~(returns : ('c, _) generator MODE(m))
      ()
  : ('a -> 'b -> 'c, unprintable) generator MODE(m)
  =
  let s1 = (sexp_or [@mode m]) sexp_of_arg1
  and s2 = (sexp_or [@mode m]) sexp_of_arg2 in
  let sexp_of_args (a, b) = Sexp.List [ s1 a; s2 b ] in
  (make [@mode m])
    name
    (fun args -> [ Printer.of_sexp sexp_of_args args ])
    returns
    (fun f a b -> f (a, b))
[@@mode m = (nonportable, portable)]
;;

(** [functions3 ?name ?sexp_of_arg1 ?sexp_of_arg2 ?sexp_of_arg3 ~returns ()] creates
    a generator for curried three-argument functions ['a -> 'b -> 'c -> 'd].

    Like {!functions2}, keyed on the argument triple, and an application
    prints as [name (arg1 arg2 arg3) = result]. *)
let%template functions3
      ?name
      ?(sexp_of_arg1 : ('a -> Sexp.t) option MODE(m))
      ?(sexp_of_arg2 : ('b -> Sexp.t) option MODE(m))
      ?(sexp_of_arg3 : ('c -> Sexp.t) option MODE(m))
      ~(returns : ('d, _) generator MODE(m))
      ()
  : ('a -> 'b -> 'c -> 'd, unprintable) generator MODE(m)
  =
  let s1 = (sexp_or [@mode m]) sexp_of_arg1
  and s2 = (sexp_or [@mode m]) sexp_of_arg2
  and s3 = (sexp_or [@mode m]) sexp_of_arg3 in
  let sexp_of_args (a, b, c) = Sexp.List [ s1 a; s2 b; s3 c ] in
  (make [@mode m])
    name
    (fun args -> [ Printer.of_sexp sexp_of_args args ])
    returns
    (fun f a b c -> f (a, b, c))
[@@mode m = (nonportable, portable)]
;;
