#ifdef OXCAML
@@ portable
#define MODE(m) @ m
#else
#define MODE(m)
#endif
(** The type [foo] resolves to [hegel_generator_foo], and the type [t] in a
    module [M] resolves to [M.hegel_generator].

    [open Hegel] is required in each file that uses
    [@@deriving hegel_generator]:

    {[
    open Hegel

    type point =
      { x : int
      ; y : int
      }
    [@@deriving hegel_generator]
    ]}

    A derived generator prints what it draws as OCaml syntax, built from the
    printing of the generators of its parts: a record as [{ x = 1; y = 2 }], a
    variant as [Leaf] or [Node (l, r)], a tuple as [(1, "a")].

    On OxCaml, [[@@deriving hegel_generator ~portable]] makes the generator
    portable, so a concurrent rule body can capture it. On upstream OCaml,
    [~portable] has no effect.

    A different module in scope can shadow these names to change the defaults.
    For example, [Hegel_jane.Derive] resolves the same names to [Core]-typed
    generators.

    {2 Extend the defaults}

    Use [@@deriving hegel_generator] for types defined in your project. For
    external types and modules, define a module including the type and a
    [hegel_generator]. Give the generator a printer, so the derived
    generators that use it print its values instead of [<abstr>]:

    {[
    module M_Wrapper = struct
      include External_M

      let hegel_generator =
        map External_M.f (integers ~min_value:0 ~max_value:1_000_000 ())
        |> with_printer (Printer.of_to_string External_M.to_string)
      ;;
    end

    type my_type =
      { x : M_Wrapper.t
      ; y : string
      }
    [@@deriving hegel_generator]
    ]} *)

(**/**)

val hegel_generator_int : int Generators.generator
val hegel_generator_bool : bool Generators.generator
val hegel_generator_float : float Generators.generator
val hegel_generator_string : string Generators.generator
val hegel_generator_char : char Generators.generator

val%template hegel_generator_list
  :  'a Generators.generator MODE(m)
  -> 'a list Generators.generator MODE(m)
[@@mode m = (nonportable, portable)]

val%template hegel_generator_option
  :  'a Generators.generator MODE(m)
  -> 'a option Generators.generator MODE(m)
[@@mode m = (nonportable, portable)]

(**/**)
