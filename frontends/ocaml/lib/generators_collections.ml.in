open Generators_core

#ifdef OXCAML
#define MODE(m) @ m
#else
#define MODE(m)
#endif

(* [validate_size_bounds ~min_size ~max_size] rejects negative collection size
   bounds. *)
let validate_size_bounds ~min_size ~max_size =
  if min_size < 0
  then
    raise
      (Internal.Usage_error (Printf.sprintf "min_size=%d must be non-negative" min_size));
  match max_size with
  | Some ms when ms < 0 ->
    raise (Internal.Usage_error (Printf.sprintf "max_size=%d must be non-negative" ms))
  | _ -> ()
;;

(* [draw_association_pairs keys values ~min_size ~max_size data] drives the
   collection protocol to produce unique-keyed [(key, value)] pairs in draw
   order, with the display of the pairs as an association list. Duplicate keys
   are rejected client-side, compared structurally. *)
let draw_association_pairs
  : type a b.
    a generator
    -> b generator
    -> min_size:int
    -> max_size:int option
    -> Internal.test_case
    -> (a * b) list * show
  =
  fun keys values ~min_size ~max_size data ->
  with_collection ~min_size ?max_size data (fun coll ->
    let rec collect acc shows =
      if collection_more coll data
      then (
        let k, show_k = do_draw keys data in
        if List.exists (fun (k', _) -> k' = k) acc
        then (
          collection_reject coll data;
          collect acc shows)
        else (
          let v, show_v = do_draw values data in
          collect ((k, v) :: acc) ((fun () -> Printer.tuple [ show_k (); show_v () ]) :: shows)))
      else List.rev acc, show_list (List.rev shows)
    in
    collect [] [])
;;

(** [assoc_lists keys values ?min_size ?max_size ()] creates a generator for
    association lists over [keys] and [values]: [(key, value)] pairs, in
    generation order, whose keys are unique.

    Key-value pairs are generated one at a time via the collection protocol,
    with duplicate keys rejected client-side. *)
let%template assoc_lists
      (keys : 'a generator MODE(m))
      (values : 'b generator MODE(m))
      ?(min_size = 0)
      ?(max_size : int option)
      ()
  : ('a * 'b) list generator MODE(m)
  =
  validate_size_bounds ~min_size ~max_size;
  Composite
    { label = Labels.combine [ Labels.assoc_list; label_of keys; label_of values ]
    ; generate_fn =
        (fun data -> draw_association_pairs keys values ~min_size ~max_size data)
    }
[@@mode m = (nonportable, portable)]
;;

(** [make_hash_tables ~of_pairs ~print_of_pairs keys values ?min_size ?max_size ()]
    builds a hash-table generator over any table type ['t]. [print_of_pairs]
    turns the display of the drawn association list into the display of the
    table built from it. *)
let%template make_hash_tables
      ~(of_pairs : (('a * 'b) list -> 't) MODE(m))
      ~(print_of_pairs : (Printer.doc -> Printer.doc) MODE(m))
      (keys : 'a generator MODE(m))
      (values : 'b generator MODE(m))
      ?(min_size = 0)
      ?(max_size : int option)
      ()
  : 't generator MODE(m)
  =
  validate_size_bounds ~min_size ~max_size;
  Composite
    { label = Labels.combine [ Labels.hash_table; label_of keys; label_of values ]
    ; generate_fn =
        (fun data ->
          let pairs, show = draw_association_pairs keys values ~min_size ~max_size data in
          of_pairs pairs, fun () -> print_of_pairs (show ()))
    }
[@@mode m = (nonportable, portable)]
;;

(** [hash_tables keys values ?min_size ?max_size ()] creates a generator for
    polymorphic [Stdlib.Hashtbl.t] tables over [keys] and [values]. A drawn
    table shows as [Hashtbl.of_seq (List.to_seq \[(k, v); …\])]. *)
let%template hash_tables
      (keys : 'a generator MODE(m))
      (values : 'b generator MODE(m))
      ?min_size
      ?max_size
      ()
  : ('a, 'b) Stdlib.Hashtbl.t generator MODE(m)
  =
  (make_hash_tables [@mode m])
    ~of_pairs:(fun pairs ->
      let table = Stdlib.Hashtbl.create (List.length pairs) in
      List.iter (fun (k, v) -> Stdlib.Hashtbl.replace table k v) pairs;
      table)
    ~print_of_pairs:(fun pairs ->
      Printer.apply
        (Printer.text "Hashtbl.of_seq")
        [ Printer.apply (Printer.text "List.to_seq") [ pairs ] ])
    keys
    values
    ?min_size
    ?max_size
    ()
[@@mode m = (nonportable, portable)]
;;

(** [lists elements ?min_size ?max_size ?unique ()] creates a generator for
    lists of [elements].

    Elements are generated one at a time via the collection protocol inside a
    {!Labels.list} span. When [unique] is [true], duplicate elements are
    rejected client-side so the generated list contains only distinct elements. *)
let%template lists
      (elements : 'a generator MODE(m))
      ?(min_size = 0)
      ?(max_size : int option)
      ?(unique = false)
      ()
  : 'a list generator MODE(m)
  =
  validate_size_bounds ~min_size ~max_size;
  if not unique
  then
    CompositeList
      { elements
      ; min_size
      ; max_size
      ; label = Labels.combine [ Labels.list; label_of elements ]
      }
  else
    (* With uniqueness, drive the collection protocol and reject duplicates.
       The engine's own rejection limit sends StopTest when too many
       duplicates occur, which [collection_reject] converts to
       [Internal.Stop_test]. *)
    Composite
      { label = Labels.combine [ Labels.set; label_of elements ]
      ; generate_fn =
          (fun data ->
            with_collection ~min_size ?max_size data (fun coll ->
              let rec collect acc shows =
                if collection_more coll data
                then (
                  let elem, show = do_draw elements data in
                  if List.mem elem acc
                  then (
                    collection_reject coll data;
                    collect acc shows)
                  else collect (elem :: acc) (show :: shows))
                else List.rev acc, show_list (List.rev shows)
              in
              collect [] []))
      }
[@@mode m = (nonportable, portable)]
;;
