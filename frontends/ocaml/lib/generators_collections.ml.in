open Generators_core

#ifdef OXCAML
#define MODE(m) @ m
#else
#define MODE(m)
#endif

(* [validate_size_bounds ~min_size ~max_size] rejects negative collection size
   bounds. *)
let validate_size_bounds ~min_size ~max_size =
  if min_size < 0
  then
    raise
      (Internal.Usage_error (Printf.sprintf "min_size=%d must be non-negative" min_size));
  match max_size with
  | Some ms when ms < 0 ->
    raise (Internal.Usage_error (Printf.sprintf "max_size=%d must be non-negative" ms))
  | _ -> ()
;;

(* [draw_elements coll data printer draw] draws elements with [draw acc] while
   the collection asks for more, where [acc] holds the elements accepted so
   far, newest first, and prints them to [printer] separated by [;]. An
   element [draw] returns [None] for is rejected, and its printing
   discarded. *)
let draw_elements coll data printer draw =
  let rec collect acc =
    if collection_more coll data
    then (
      let accepted =
        Out.speculate printer (fun printer ->
          if not (List.is_empty acc) then Out.separator printer ";";
          match draw acc printer with
          | Some _ as accepted -> accepted, `Commit
          | None ->
            collection_reject coll data;
            None, `Abort)
      in
      collect (Option.fold ~none:acc ~some:(fun x -> x :: acc) accepted))
    else List.rev acc
  in
  collect []
;;

(* [draw_association_pairs keys values ~min_size ~max_size data printer]
   drives the collection protocol to produce unique-keyed [(key, value)]
   pairs in draw order, printing them as an association list. Duplicate keys
   are rejected client-side, compared structurally. *)
let draw_association_pairs
  : type a b.
    a core
    -> b core
    -> min_size:int
    -> max_size:int option
    -> Internal.test_case
    -> Out.t
    -> (a * b) list
  =
  fun keys values ~min_size ~max_size data printer ->
  with_collection ~min_size ?max_size data (fun coll ->
    Out.group printer "[" "]" (fun printer ->
      draw_elements coll data printer (fun acc printer ->
        Out.group printer "(" ")" (fun printer ->
          let k = do_draw keys data printer in
          if List.exists (fun (k', _) -> k' = k) acc
          then None
          else (
            Out.separator printer ",";
            Some (k, do_draw values data printer))))))
;;

(** [assoc_lists keys values ?min_size ?max_size ()] creates a generator for
    association lists over printable [keys] and [values]: [(key, value)] pairs,
    in generation order, whose keys are unique.

    Key-value pairs are generated one at a time via the collection protocol,
    with duplicate keys rejected client-side. *)
let%template assoc_lists
      (keys : ('a, printable) generator MODE(m))
      (values : ('b, printable) generator MODE(m))
      ?(min_size = 0)
      ?(max_size : int option)
      ()
  : (('a * 'b) list, printable) generator MODE(m)
  =
  validate_size_bounds ~min_size ~max_size;
  let pk = (printer [@mode m]) keys
  and pv = (printer [@mode m]) values in
  let keys = (core_of [@mode m]) keys
  and values = (core_of [@mode m]) values in
  Printable
    { core =
        Composite
          { label = Labels.combine [ Labels.dict; label_of_core keys; label_of_core values ]
          ; generate_fn = draw_association_pairs keys values ~min_size ~max_size
          }
    ; sexp_of = (fun kvs -> Sexp.List (List.map (fun (k, v) -> Sexp.List [ pk k; pv v ]) kvs))
    }
[@@mode m = (nonportable, portable)]
;;

(* [print_calls printer names body] prints the nested application
   [n1 (n2 (… body))] of the functions [names], outermost first, around what
   [body] prints. *)
let rec print_calls printer names body =
  match names with
  | [] -> body printer
  | name :: names ->
    Out.parens_if_argument printer (fun printer ->
      Out.group printer ~indent:2 "" "" (fun printer ->
        Out.text printer name;
        Out.breakable printer " ";
        print_calls (Out.argument printer) names body))
;;

(* [tables ~of_pairs ~sexp_of_t ~print keys values ?min_size ?max_size ()]
   builds a hash-table generator over any table type ['t]. [print] is
   [`Calls names] to print a drawn table as its association list wrapped in
   calls to the functions [names] (see [print_calls]), or [`Sexp] to print it
   as the s-expression [sexp_of_t] gives. *)
let%template tables
      ~(of_pairs : (('a * 'b) list -> 't) MODE(m))
      ~(sexp_of_t : (('a -> Sexp.t) -> ('b -> Sexp.t) -> 't -> Sexp.t) MODE(m))
      ~print
      (keys : ('a, printable) generator MODE(m))
      (values : ('b, printable) generator MODE(m))
      ?(min_size = 0)
      ?(max_size : int option)
      ()
  : ('t, printable) generator MODE(m)
  =
  validate_size_bounds ~min_size ~max_size;
  let pk = (printer [@mode m]) keys
  and pv = (printer [@mode m]) values in
  let keys = (core_of [@mode m]) keys
  and values = (core_of [@mode m]) values in
  let draw = draw_association_pairs keys values ~min_size ~max_size in
  Printable
    { core =
        Composite
          { label = Labels.combine [ Labels.dict; label_of_core keys; label_of_core values ]
          ; generate_fn =
              (fun data printer ->
                match print with
                | `Calls names -> of_pairs (print_calls printer names (draw data))
                | `Sexp ->
                  let table = of_pairs (draw data Out.noop) in
                  Out.sexp printer (sexp_of_t pk pv) table;
                  table)
          }
    ; sexp_of = (fun table -> sexp_of_t pk pv table)
    }
[@@mode m = (nonportable, portable)]
;;

(** [make_hash_tables_printed ~of_pairs ~sexp_of_t ~wrap keys values
    ?min_size ?max_size ()] builds a hash-table generator over any table type
    ['t], whose drawn tables print as their association list wrapped in calls
    to the functions [wrap], outermost first. *)
let%template make_hash_tables_printed ~of_pairs ~sexp_of_t ~wrap =
  (tables [@mode m]) ~of_pairs ~sexp_of_t ~print:(`Calls wrap)
[@@mode m = (nonportable, portable)]
;;

(** [make_hash_tables ~of_pairs ~sexp_of_t keys values ?min_size ?max_size ()]
    builds a hash-table generator over any table type ['t]. A drawn table
    prints as the s-expression [sexp_of_t] gives. *)
let%template make_hash_tables ~of_pairs ~sexp_of_t =
  (tables [@mode m]) ~of_pairs ~sexp_of_t ~print:`Sexp
[@@mode m = (nonportable, portable)]
;;

(** [hash_tables keys values ?min_size ?max_size ()] creates a generator for
    polymorphic [Stdlib.Hashtbl.t] tables over printable [keys] and [values]. A
    drawn table shows as [Hashtbl.of_seq (List.to_seq \[(k, v); …\])]. *)
let%template hash_tables
      (keys : ('a, printable) generator MODE(m))
      (values : ('b, printable) generator MODE(m))
      ?min_size
      ?max_size
      ()
  : (('a, 'b) Stdlib.Hashtbl.t, printable) generator MODE(m)
  =
  (make_hash_tables_printed [@mode m])
    ~of_pairs:(fun pairs ->
      let table = Stdlib.Hashtbl.create (List.length pairs) in
      List.iter (fun (k, v) -> Stdlib.Hashtbl.replace table k v) pairs;
      table)
    ~sexp_of_t:(fun pk pv table ->
      Sexp.List
        (Stdlib.Hashtbl.fold (fun k v acc -> Sexp.List [ pk k; pv v ] :: acc) table []))
    ~wrap:[ "Hashtbl.of_seq"; "List.to_seq" ]
    keys
    values
    ?min_size
    ?max_size
    ()
[@@mode m = (nonportable, portable)]
;;

(** [draw_unique ~key elements ~min_size ~max_size data printer] drives the
    collection protocol to draw elements whose keys are pairwise distinct
    (compared structurally), rejecting duplicates client-side and discarding
    their printing. The engine's own rejection limit sends StopTest when too
    many duplicates occur, which [collection_reject] converts to
    [Internal.Stop_test]. *)
let draw_unique ~key elements ~min_size ~max_size data printer =
  with_collection ~min_size ?max_size data (fun coll ->
    Out.group printer "[" "]" (fun printer ->
      List.map
        fst
        (draw_elements coll data printer (fun acc printer ->
           let elem = do_draw elements data printer in
           let k = key elem in
           if List.exists (fun (_, k') -> k' = k) acc then None else Some (elem, k)))))
;;

(** [lists elements ?min_size ?max_size ?unique ?unique_by ()] creates a
    generator for lists of printable [elements].

    Elements are generated one at a time via the collection protocol inside a
    {!Labels.list} span. When [unique] is [true], or [unique_by] is given,
    elements (or their [unique_by] keys) that duplicate an earlier one are
    rejected client-side. *)
let%template lists
      (elements : ('a, printable) generator MODE(m))
      ?(min_size = 0)
      ?(max_size : int option)
      ?(unique = false)
      ?(unique_by : ('a -> 'k) option MODE(m))
      ()
  : ('a list, printable) generator MODE(m)
  =
  validate_size_bounds ~min_size ~max_size;
  let elt = (printer [@mode m]) elements in
  let elements = (core_of [@mode m]) elements in
  let label = Labels.combine [ Labels.list; label_of_core elements ] in
  let generate (type k) (key : ('a -> k) MODE(m)) =
    Composite
      { label
      ; generate_fn = draw_unique ~key elements ~min_size ~max_size
      }
  in
  let core =
    match unique, unique_by with
    | true, Some _ ->
      raise (Internal.Usage_error "unique and unique_by are mutually exclusive")
    | false, Some key -> generate key
    | true, None -> generate Fun.id
    | false, None -> CompositeList { elements; min_size; max_size; label }
  in
  Printable { core; sexp_of = (fun xs -> Sexp.List (List.map elt xs)) }
[@@mode m = (nonportable, portable)]
;;

(** [arrays elements ?min_size ?max_size ()] creates a generator for arrays of
    printable [elements], drawn like {!lists}. A drawn array shows as
    [\[|1; 2|\]]. *)
let%template arrays
      (elements : ('a, printable) generator MODE(m))
      ?(min_size = 0)
      ?(max_size : int option)
      ()
  : ('a array, printable) generator MODE(m)
  =
  validate_size_bounds ~min_size ~max_size;
  let elt = (printer [@mode m]) elements in
  let elements = (core_of [@mode m]) elements in
  Printable
    { sexp_of = (fun xs -> Sexp.List (List.map elt (Array.to_list xs)))
    ; core =
        Composite
          { label = Labels.combine [ Labels.array; label_of_core elements ]
          ; generate_fn =
              (fun data printer ->
                with_collection ~min_size ?max_size data (fun coll ->
                  Out.group printer "[|" "|]" (fun printer ->
                    Array.of_list
                      (draw_elements coll data printer (fun _ printer ->
                         Some (do_draw elements data printer))))))
          }
    }
[@@mode m = (nonportable, portable)]
;;

(** [sets ?module_name (module S) elements ?min_size ?max_size ()] creates a
    generator for sets of printable [elements], built with [S.add]. Elements
    already in the set (by [S.mem]) are rejected client-side. A drawn set
    shows as [<module_name>.of_list \[…\]]. *)
let sets
      (type elt t)
      ?(module_name = "Set")
      (module S : Set.S with type elt = elt and type t = t)
      (elements : (elt, printable) generator)
      ?(min_size = 0)
      ?(max_size : int option)
      ()
  : (t, printable) generator
  =
  validate_size_bounds ~min_size ~max_size;
  let elt = printer elements in
  let elements = core_of elements in
  Printable
    { sexp_of = (fun set -> Sexp.List (List.map elt (S.elements set)))
    ; core =
        Composite
          { label = Labels.combine [ Labels.set; label_of_core elements ]
          ; generate_fn =
              (fun data printer ->
                with_collection ~min_size ?max_size data (fun coll ->
                  print_calls printer [ module_name ^ ".of_list" ] (fun printer ->
                    Out.group printer "[" "]" (fun printer ->
                      let set = ref S.empty in
                      ignore
                        (draw_elements coll data printer (fun _ printer ->
                           let elem = do_draw elements data printer in
                           if S.mem elem !set
                           then None
                           else (
                             set := S.add elem !set;
                             Some ()))
                         : unit list);
                      !set))))
          }
    }
;;
