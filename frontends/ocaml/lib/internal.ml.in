(** Test runner and lifecycle management for Hegel.

    This module implements the client-side logic for running property-based
    tests against the native libhegel engine (via {!Hegel_ffi.Ffi}). It manages:
    - Test lifecycle (run_start, test-case loop, mark_complete, run_result)
    - The per-test-case handle threaded through the test function
    - Helper functions (assume, note, target, the typed generate_* draws)
    - Origin extraction for error reporting *)

module Ffi = Hegel_ffi.Ffi

#ifdef OXCAML
#define LOCAL(x) (x @ local)
#define PORTABLE @@ portable
#define KIND(k) : k
#else
#define LOCAL(x) x
#define PORTABLE
#define KIND(k)
#endif

#ifdef OXCAML
module DLS = Stdlib.Domain.Safe.DLS
#else
module DLS = Stdlib.Domain.DLS
#endif


(** Engine signal to stop the current test case, including choice exhaustion. *)
exception Stop_test = Ffi.Stop_test

(** Raised when an assumption or engine draw rejects the case. *)
exception Assume_rejected = Ffi.Assume_rejected

(** Raised when the client-side pool table diverges from the engine's pool (an
    id the engine drew is unknown to the client). The case is marked invalid. *)
exception Flaky_strategy

(** Raised by [Hegel.repeat] once the engine ends the loop: the test case
    completed normally. *)
exception Repeat_done

open Settings

module Label = struct
  type desc =
    | Name of string
    | Combined of t list
    | Deferred of t option Atomic.t

  and t =
    { desc : desc
    ; resolved : int64 option Atomic.t
    }

  let of_name name = { desc = Name name; resolved = Atomic.make None }
  let combine labels = { desc = Combined labels; resolved = Atomic.make None }
  let deferred () =
    let cell = Atomic.make None in
    { desc = Deferred cell; resolved = Atomic.make None }, fun inner -> Atomic.set cell (Some inner)
  ;;

  let deferred_name = of_name "hegel.deferred"

  (* [visiting] holds the deferred labels being resolved further up. A deferred
     label met again while it is being resolved stands for "hegel.deferred",
     so a recursive generator's label is finite. Only values computed outside
     every deferred label are cached: a value computed inside one depends on
     where the resolution started. *)
  let rec compute context visiting label =
    match Atomic.get label.resolved with
    | Some value -> value
    | None ->
      let cacheable, value =
        match label.desc with
        | Name name -> true, Ffi.label_from_name context name
        | Combined labels ->
          ( List.is_empty visiting
          , Ffi.label_combine context (List.map (compute context visiting) labels) )
        | Deferred cell ->
          (match Atomic.get cell with
           | Some inner when not (List.memq label visiting) ->
             List.is_empty visiting, compute context (label :: visiting) inner
           | Some _ | None -> false, compute context visiting deferred_name)
      in
      if cacheable then Atomic.set label.resolved (Some value);
      value
  ;;

  let resolve context label = compute context [] label
end

(** A source location identifying a single test. See [Hegel.test_location]. *)
type test_location =
  { function_name : string
  ; file : string
  ; begin_line : int
  }

(** Draw-name bookkeeping: the per-name occurrence counter that numbers
    repeatable draws ([label_1], [label_2], …). Shared across every clone of a
    test case (see {!clone}) behind its lock, so concurrent clones number
    their draws in sequence. *)
type draw_state = (string, int) Hashtbl.t Locked.t

(** Resources the test case owns and frees once the case is complete.
    A clone or block shares this record with its parent test case. *)
type owned_state =
  { mutable pools : Ffi.pool list
  ; mutable clones : (Ffi.context * Ffi.test_case) list
  }

type owned = owned_state Locked.t

(** The state of an explicit example's test case: the names of the draws it
    has given values for so far, and the lines it printed, newest first. *)
type explicit =
  { mutable drawn : string list
  ; mutable lines : string list
  }

(** Per-test-case state passed explicitly to the test function. Holds the
    native test-case handle, the final-replay flag, whether verbose output is
    on, abort state, the current generation-span depth (used to print only the
    outermost drawn value), the {!draw_state} numbering repeatable draws,
    and the {!type:owned} engine resources. *)
type test_case KIND(value mod portable contended) =
  { handle : Ffi.test_case
  ; context : Ffi.context
  ; should_capture : bool
  ; verbosity : Settings.verbosity
  ; test_aborted : bool Atomic.t
  ; draw_depth : int Atomic.t
  ; draw_state : draw_state
  ; owned : owned
  ; explicit : explicit Locked.t option
  }

(* Accessors so other library modules can read the internal fields they need
   without the record being exposed (the type is abstract in the interface). *)
let is_high_verbosity (tc : test_case) =
  match tc.verbosity with
  | Debug | Verbose -> true
  | _ -> false
;;

(** [free_owned tc] releases every resource the case owns *)
let free_owned (tc : test_case) =
  let clones, pools =
    Locked.protect tc.owned (fun owned ->
      let c, p = owned.clones, owned.pools in
      owned.clones <- [];
      owned.pools <- [];
      ((c, p) : (Ffi.context * Ffi.test_case) list * Ffi.pool list))
  in
  List.iter
    (fun (context, handle) ->
       Ffi.test_case_free context handle;
       Ffi.context_free context)
    clones;
  List.iter (Ffi.pool_free tc.context) pools
;;

(** [own_clone tc context handle] records a clone handle for {!free_owned}. *)
let own_clone (tc : test_case) context handle =
  Locked.protect tc.owned (fun owned -> owned.clones <- (context, handle) :: owned.clones)
;;

(** [owned_clone_count tc] is the number of clone handles the case currently
    owns. *)
let owned_clone_count (tc : test_case) =
  Locked.protect tc.owned (fun owned -> List.length owned.clones)
;;

let draw_depth (tc : test_case) = Atomic.get tc.draw_depth
let incr_draw_depth (tc : test_case) = Atomic.incr tc.draw_depth
let decr_draw_depth (tc : test_case) = Atomic.decr tc.draw_depth
let set_test_aborted (tc : test_case) v = Atomic.set tc.test_aborted v

let explicit_unsupported =
  "Explicit example: the test generated data. In an explicit example every draw must be \
   a [let x = draw tc ...] binding the example gives a value for"
;;

(** [is_explicit tc] is [true] when [tc] is an explicit example's test case. *)
let is_explicit (tc : test_case) = Option.is_some tc.explicit

(** [require_engine tc] raises {!Usage_error} when [tc] is an explicit
    example's test case, which has no engine behind it. *)
let require_engine (tc : test_case) =
  if Option.is_some tc.explicit then raise (Ffi.Usage_error explicit_unsupported)
;;

(** [check_drawable tc ~label] raises {!Usage_error} when [tc] is an explicit
    example's test case: a draw there must be given its value by the example. *)
let check_drawable (tc : test_case) ~label =
  if Option.is_some tc.explicit
  then
    raise
      (Ffi.Usage_error
         (Printf.sprintf
            "Explicit example: no value for the draw %s. Give the example a value for \
             it, as [@@example { %s = ... }] on a [let %s = draw tc ...] binding"
            label
            label
            label))
;;

(** [explicit_draw tc ~name ~source value] is [value], the value an explicit
    example gives for the draw bound to [name], written [source]. *)
let explicit_draw (tc : test_case) ~name ~source value =
  match tc.explicit with
  | None ->
    raise
      (Ffi.Usage_error
         "Explicit example values can only be drawn in an explicit example's test case")
  | Some explicit ->
    let line = Printf.sprintf "%s = %s" name source in
    Locked.protect explicit (fun e ->
      e.drawn <- name :: e.drawn;
      e.lines <- line :: e.lines);
    value
;;

(** [clone tc] forks a fresh {!test_case} onto an independent choice stream of the
    same underlying native test case (see {!Ffi.test_case_clone}), paired with its
    own native context so it can be drawn from on another thread concurrently with
    [tc]. The clone shares [tc]'s outcome and budget but generates from its own
    stream. The {!draw_state} (repeatable-draw numbering) is {e shared} with [tc]
    behind its lock, and the span depth is copied so draws forked mid-span stay
    nested. Only the per-stream abort flag starts fresh, and the immutable
    configuration is copied.

    The native handle and context are owned by the test case (see
    {!type:owned}) and freed once it completes, so a clone may be captured and
    used freely within the case. *)
let clone (tc : test_case) =
  require_engine tc;
  let context = Ffi.context_new () in
  let handle = Ffi.test_case_clone tc.context tc.handle in
  own_clone tc context handle;
  { handle
  ; context
  ; should_capture = tc.should_capture
  ; verbosity = tc.verbosity
  ; test_aborted = Atomic.make false
  ; draw_depth = Atomic.make (Atomic.get tc.draw_depth)
  ; draw_state = tc.draw_state
  ; owned = tc.owned
  ; explicit = None
  }
;;

(** [with_block tc ~indent f] runs [f] on a {!test_case} for an indented
    section of [tc]'s output. *)
let with_block (tc : test_case) ~indent LOCAL(f) =
  require_engine tc;
  let context = Ffi.context_new () in
  let handle = Ffi.test_case_block tc.context tc.handle ~indent in
  let b =
    { handle
    ; context
      ; should_capture = tc.should_capture
    ; verbosity = tc.verbosity
    ; test_aborted = Atomic.make false
    ; draw_depth = Atomic.make 0
    ; draw_state = Locked.create (fun () -> Hashtbl.create 16)
    ; owned = tc.owned
    ; explicit = None
    }
  in
  let free () =
    Ffi.test_case_free context handle;
    Ffi.context_free context
  in
  match f b with
  | result ->
    free ();
    result
  | exception exn ->
    free ();
    raise exn
;;

let set_worker_index (tc : test_case) worker_index =
  require_engine tc;
  Ffi.test_case_set_worker tc.context tc.handle ~worker_index
;;

(** Domain-local flag to detect nested test cases. *)
let in_test_context : bool DLS.key = DLS.new_key (fun () -> false)

(** [extract_origin exn] extracts an InterestingOrigin string from an exception.
    Uses the backtrace if available. The origin is derived from the exception
    type plus the {e innermost user frame}, so the shrinker
    groups probes for the same bug while keeping failures at distinct source
    lines apart (see {!Ffi.mark_complete}).

    Frames of the stdlib and of the hegel libraries are skipped. Their code
    paths can change between replays of the same failure, and the engine then
    treats the failure as nondeterministic. *)
let extract_origin exn =
  let bt = Stdlib.Printexc.get_raw_backtrace () in
  let library_modules =
    [ "Hegel"; "Hegel_ffi"; "Hegel_jane"; "Hegel_jane_async"; "Hegel_jane_concurrent" ]
  in
  let is_library_frame name =
    String.starts_with name ~prefix:"Stdlib"
    || String.starts_with name ~prefix:"Camlinternal"
    || List.exists
         (fun m ->
            String.starts_with name ~prefix:(m ^ ".")
            || String.starts_with name ~prefix:(m ^ "__"))
         library_modules
  in
  let user_location =
    match Stdlib.Printexc.backtrace_slots bt with
    | None -> None
    | Some slots ->
      Array.find_map
        (fun slot ->
           match Stdlib.Printexc.Slot.(name slot, location slot) with
           | Some name, Some (loc : Stdlib.Printexc.location)
             when not (is_library_frame name) -> Some (loc.filename, loc.line_number)
           | _ -> None)
        slots
  in
  match user_location with
  | None -> Printf.sprintf "%s at :0" (Stdlib.Printexc.exn_slot_name exn)
  | Some (file, line) ->
    Printf.sprintf "%s at %s:%d" (Stdlib.Printexc.exn_slot_name exn) file line
;;

exception Usage_error = Ffi.Usage_error
exception Internal_error = Ffi.Internal_error

(** [with_stop_guard tc f] marks the test case aborted on engine control
    exceptions and propagates them unchanged. *)
let with_stop_guard tc f =
  require_engine tc;
  try f () with
  | (Stop_test | Assume_rejected | Usage_error _) as exn ->
    Atomic.set tc.test_aborted true;
    raise_notrace exn
  | Internal_error _ as exn ->
    (* requires an libhegel/binding fault *)
    (Atomic.set tc.test_aborted true;
     raise_notrace exn)
    [@coverage off]
;;

(** [generate_boolean tc p forced] draws a boolean with probability [p] of
    [true]. If [forced] is [Some b] the value is forced to [b]. Raises
    {!Stop_test} on StopTest. *)
let generate_boolean tc p forced =
  with_stop_guard tc (fun () -> Ffi.generate_boolean tc.context tc.handle p forced)
;;

(** [generate_integer tc ~min_value ~max_value] draws an integer in the inclusive
    range. Raises {!Stop_test} on StopTest. *)
let generate_integer tc ~min_value ~max_value =
  with_stop_guard tc (fun () ->
    Ffi.generate_integer tc.context tc.handle ~min_value ~max_value)
;;

(** [generate_float tc ...] draws a width-64 float under the given policy. Raises
    {!Stop_test} on StopTest. *)
let generate_float
      tc
      ~width
      ~min_value
      ~max_value
      ~allow_nan
      ~allow_infinity
      ~exclude_min
      ~exclude_max
      ~smallest_nonzero_magnitude
  =
  with_stop_guard tc (fun () ->
    Ffi.generate_float
      tc.context
      tc.handle
      ~width
      ~min_value
      ~max_value
      ~allow_nan
      ~allow_infinity
      ~exclude_min
      ~exclude_max
      ~smallest_nonzero_magnitude)
;;

(** [generate_bytes tc ~min_size ~max_size] draws a byte string. Raises
    {!Stop_test} on StopTest. *)
let generate_bytes tc ~min_size ~max_size =
  with_stop_guard tc (fun () ->
    Ffi.generate_bytes tc.context tc.handle ~min_size ~max_size)
;;

(** [with_string_generator tc make draw] builds a string-generator handle with
    [make tc.context], draws from it with [draw], and always frees the handle.
    Raises {!Stop_test} on StopTest and {!Assume_rejected} when the draw
    rejects itself. *)
let with_string_generator tc make =
  with_stop_guard tc (fun () ->
    let sg = make tc.context in
    Fun.protect
      ~finally:(fun () -> Ffi.string_generator_free tc.context sg)
      (fun () -> Ffi.generate_string tc.context tc.handle sg))
;;

(** [generate_text tc ...] draws a text string over the described alphabet. *)
let generate_text
      tc
      ~min_size
      ~max_size
      ~codec
      ~min_codepoint
      ~max_codepoint
      ~categories
      ~exclude_categories
      ~include_characters
      ~exclude_characters
  =
  with_string_generator tc (fun ctx ->
    Ffi.string_generator_text
      ctx
      ~min_size
      ~max_size
      ~codec
      ~min_codepoint
      ~max_codepoint
      ~categories
      ~exclude_categories
      ~include_characters
      ~exclude_characters)
;;

(** The character set of a text generator, as {!generate_text} takes it. *)
type alphabet =
  { codec : string option
  ; min_codepoint : int
  ; max_codepoint : int
  ; categories : string list option
  ; exclude_categories : string list option
  ; include_characters : string option
  ; exclude_characters : string option
  }

(** [with_alphabet ctx alphabet f] runs [f] on a single-character text
    generator over [alphabet] ([None] when there is none), freed afterwards. *)
let with_alphabet ctx alphabet f =
  match alphabet with
  | None -> f None
  | Some (a : alphabet) ->
    let handle =
      Ffi.string_generator_text
        ctx
        ~min_size:1
        ~max_size:(Some 1)
        ~codec:a.codec
        ~min_codepoint:a.min_codepoint
        ~max_codepoint:a.max_codepoint
        ~categories:a.categories
        ~exclude_categories:a.exclude_categories
        ~include_characters:a.include_characters
        ~exclude_characters:a.exclude_characters
    in
    Fun.protect
      ~finally:(fun () -> Ffi.string_generator_free ctx handle)
      (fun () -> f (Some handle))
;;

(** [generate_regex tc ~pattern ~fullmatch ~alphabet] draws a string matching
    [pattern], every character of it from [alphabet] when one is given. *)
let generate_regex tc ~pattern ~fullmatch ~alphabet =
  with_string_generator tc (fun ctx ->
    with_alphabet ctx alphabet (fun alphabet ->
      Ffi.string_generator_regex ctx ~pattern ~fullmatch ~alphabet))
;;

type grammar_spec KIND(value mod portable contended) =
  { grammar_text : string
  ; start : string option
  ; grammar_max_size : int
  ; max_depth : int
  ; grammar_alphabet : alphabet option
  ; explicit_terminals : string list
  ; import_path : string option
  }

(** A grammar compiled on its first draw and kept for the next ones. The
    compiled handle is freed by a finaliser on the record, so every draw
    keeps the record alive until the engine is done with the handle. *)
type grammar KIND(value mod portable contended) =
  { spec : grammar_spec
  ; compiling : unit Locked.t
  ; compiled : Ffi.grammar option Atomic.t
  }

let free_compiled compiled =
  Option.iter
    (fun handle ->
      let ctx = Ffi.context_new () in
      Ffi.grammar_free ctx handle;
      Ffi.context_free ctx)
    (Atomic.get compiled)
;;

let grammar spec =
  let g = { spec; compiling = Locked.create (fun () -> ()); compiled = Atomic.make None } in
#ifdef OXCAML
  Gc.Safe.finalise (fun g -> free_compiled g.compiled) g;
#else
  Gc.finalise (fun g -> free_compiled g.compiled) g;
#endif
  g
;;

(** [read_grammar_file dir path] is the text of the file [path] under [dir],
    or [None] when there is no such file. *)
let read_grammar_file dir path =
  let file = Filename.concat dir path in
  if Sys.file_exists file
  then (
    try Some (In_channel.with_open_bin file In_channel.input_all) with
    | Sys_error message ->
      raise (Usage_error (Printf.sprintf "Could not read grammar %S: %s" file message)))
  else None
;;

let compile_grammar ctx spec =
  let builder = Ffi.grammar_builder_new ctx spec.grammar_text in
  Fun.protect
    ~finally:(fun () -> Ffi.grammar_builder_free ctx builder)
    (fun () ->
      let rec provide index =
        Option.iter
          (fun path ->
            Ffi.grammar_builder_provide
              ctx
              builder
              index
              (Option.bind spec.import_path (fun dir -> read_grammar_file dir path));
            provide (index + 1))
          (Ffi.grammar_builder_file ctx builder index)
      in
      provide 0;
      with_alphabet ctx spec.grammar_alphabet (fun alphabet ->
        Ffi.grammar_new
          ctx
          builder
          ~start:spec.start
          ~max_size:spec.grammar_max_size
          ~max_depth:spec.max_depth
          ~alphabet
          ~explicit:spec.explicit_terminals))
;;

let compiled_grammar tc g =
  Locked.protect g.compiling (fun () ->
    match Atomic.get g.compiled with
    | Some handle -> handle
    | None ->
      let handle = compile_grammar tc.context g.spec in
      Atomic.set g.compiled (Some handle);
      handle)
;;

let generate_grammar tc g ~provide =
  with_stop_guard tc (fun () ->
    let handle = compiled_grammar tc g in
    let draw = Ffi.grammar_draw_new tc.context handle ~max_size:0 in
    Fun.protect
      ~finally:(fun () ->
        Ffi.grammar_draw_free tc.context draw;
        ignore (Sys.opaque_identity g : grammar))
      (fun () ->
        let rec next () =
          match Ffi.grammar_draw_next tc.context tc.handle draw with
          | Some terminal ->
            Ffi.grammar_draw_provide tc.context draw (provide terminal);
            next ()
          | None -> Ffi.grammar_draw_result tc.context draw
        in
        next ()))
;;

(** [generate_email tc] draws an RFC 5321/5322 email address. *)
let generate_email tc = with_string_generator tc Ffi.string_generator_email

(** [generate_url tc] draws an RFC 3986 http/https URL. *)
let generate_url tc = with_string_generator tc Ffi.string_generator_url

(** [generate_domain tc ~max_length] draws an RFC 1035 domain name. *)
let generate_domain tc ~max_length =
  with_string_generator tc (fun ctx -> Ffi.string_generator_domain ctx ~max_length)
;;

(** A proleptic Gregorian calendar date, as drawn by {!generate_date}. *)
type date = Ffi.date =
  { year : int
  ; month : int
  ; day : int
  }

(** A time of day at nanosecond resolution, as drawn by {!generate_time}. *)
type time = Ffi.time =
  { hour : int
  ; minute : int
  ; second : int
  ; nanosecond : int
  }

(** [generate_date tc ~min_value ~max_value] draws a Gregorian date in the
    inclusive range. *)
let generate_date tc ~min_value ~max_value =
  with_stop_guard tc (fun () ->
    Ffi.generate_date tc.context tc.handle ~min_value ~max_value)
;;

(** [generate_time tc ~min_value ~max_value] draws a time in the inclusive
    range. *)
let generate_time tc ~min_value ~max_value =
  with_stop_guard tc (fun () ->
    Ffi.generate_time tc.context tc.handle ~min_value ~max_value)
;;

(** [generate_datetime tc ~min_value ~max_value] draws a naive datetime in the
    inclusive range as a [(date, time)] pair. *)
let generate_datetime tc ~min_value ~max_value =
  with_stop_guard tc (fun () ->
    Ffi.generate_datetime tc.context tc.handle ~min_value ~max_value)
;;

(** [generate_ipv4 tc] draws an IPv4 address as its 4 network-order bytes. *)
let generate_ipv4 tc =
  with_stop_guard tc (fun () -> Ffi.generate_ipv4 tc.context tc.handle)
;;

(** [generate_ipv6 tc] draws an IPv6 address as its 16 network-order bytes. *)
let generate_ipv6 tc =
  with_stop_guard tc (fun () -> Ffi.generate_ipv6 tc.context tc.handle)
;;

(** [generate_uuid tc ~version] draws a UUID as its 16 big-endian bytes. *)
let generate_uuid tc ~version =
  with_stop_guard tc (fun () -> Ffi.generate_uuid tc.context tc.handle ~version)
;;

(** [generate_integer_big tc ~min_value ~max_value] draws an integer in the
    inclusive range, as two's-complement little-endian bytes. *)
let generate_integer_big tc ~min_value ~max_value =
  with_stop_guard tc (fun () ->
    Ffi.generate_integer_big tc.context tc.handle ~min_value ~max_value)
;;

type recursion = Ffi.recursion

exception Retry = Ffi.Retry

let new_recursion tc ~max_depth ~max_leaves =
  with_stop_guard tc (fun () ->
    Ffi.new_recursion tc.context tc.handle ~max_depth ~max_leaves)
;;

let recursion_branch tc recursion ~depth =
  with_stop_guard tc (fun () -> Ffi.recursion_branch tc.context tc.handle recursion ~depth)
;;

let recursion_leaf tc recursion =
  with_stop_guard tc (fun () -> Ffi.recursion_leaf tc.context tc.handle recursion)
;;

let recursion_retry tc recursion =
  with_stop_guard tc (fun () -> Ffi.recursion_retry tc.context tc.handle recursion)
;;

let recursion_finish tc recursion =
  with_stop_guard tc (fun () -> Ffi.recursion_finish tc.context tc.handle recursion)
;;

let recursion_free tc recursion = Ffi.recursion_free tc.context recursion

(* ------------------------------------------------------------------ *)
(* ANSI colors                                                         *)
(* ------------------------------------------------------------------ *)

(** ANSI color code for {!stderr_color}. *)
let ansi_red = "31"

(** [color_enabled ~override ~isatty] decides whether ANSI colors are on: an
    [override] of ["1"]/["0"] (the [HEGEL_COLOR] variable) forces it on/off;
    otherwise follow [isatty]. *)
let color_enabled ~override ~isatty =
  match override with
  | Some "1" -> true
  | Some "0" -> false
  | Some _ | None -> isatty
;;

(** [stderr_color_enabled ()] is {!color_enabled} for the failure report's
    stream: it reads [HEGEL_COLOR] afresh (tests toggle it) and checks whether
    stderr is a terminal. *)
let stderr_color_enabled () =
  color_enabled ~override:(Sys.getenv_opt "HEGEL_COLOR") ~isatty:(Unix.isatty Unix.stderr)
;;

(** [stderr_color code s] wraps [s] in the ANSI SGR [code] when colors are
    enabled for stderr (see {!stderr_color_enabled}), else returns [s]
    unchanged. *)
let stderr_color code s =
  if stderr_color_enabled () then Printf.sprintf "\027[%sm%s\027[0m" code s else s
;;

(** [assume tc condition] rejects the current test case if [condition] is
    [false]. The [tc] handle is accepted for API symmetry with the other
    per-test-case primitives; the rejection is client-side (raising
    {!Assume_rejected}) and does not consult [tc]. *)
let assume _tc condition = if not condition then raise Assume_rejected

(** [should_print tc] says whether {!note} output is visible for this test
    case under the run's {!type:verbosity}: never under [Quiet], only on the
    final (failing) replay under [Normal], and on every test case under
    [Verbose] or [Debug]. *)
let should_print tc =
  match tc.verbosity with
  | Quiet -> false
  | Normal -> tc.should_capture
  | Verbose | Debug -> true
;;

(** [note tc message] appends [message] to the test case's
    print region of the engine's family document, subject to {!should_print};
    the document is printed once the case completes (see [capture_document]). *)
let note tc message =
  match tc.explicit with
  | Some explicit -> Locked.protect explicit (fun e -> e.lines <- message :: e.lines)
  | None -> if should_print tc then Ffi.note tc.context tc.handle message
;;

(** [print_line tc doc] appends [doc] as one line to the test case's print
    region, subject to {!should_print}. *)
let print_line tc doc =
  require_engine tc;
  if should_print tc
  then (
    let ctx = tc.context in
    let printer = Ffi.test_case_printer ctx tc.handle None in
    Fun.protect
      ~finally:(fun () -> Ffi.printer_free ctx printer)
      (fun () ->
         Printer.render ctx printer doc;
         Ffi.printer_hard_break ctx printer))
;;

(** [require tc ?msg condition] fails the current test case when [condition] is
    [false] by raising [Failure msg]. *)
let require _tc ?(msg = "require: condition was false") condition =
  if not condition then failwith msg
;;

(** [draw_display_name tc ~label ~repeatable] returns the display name to print
    for a drawn value, bumping the occurrence counter for [label]. A [repeatable]
    name is numbered on every occurrence ([label_1], [label_2], …), while a
    non-repeatable name is printed bare. The counter is shared across test cases. *)
let draw_display_name tc ~label ~repeatable =
  let n =
    Locked.protect tc.draw_state (fun counts ->
      let n = Option.value (Hashtbl.find_opt counts label) ~default:0 + 1 in
      Hashtbl.replace counts label n;
      n)
  in
  if repeatable then Printf.sprintf "%s_%d" label n else label
;;

(** [target tc ~label ~value] records a targeting observation to guide the search
    engine toward higher values. *)
let target tc ~label ~value =
  if Option.is_none tc.explicit
  then with_stop_guard tc (fun () -> Ffi.target tc.context tc.handle value label)
;;

(** [event tc ~label] records [label] as observed on this test case for the
    end-of-run statistics report. *)
let event tc ~label =
  if Option.is_none tc.explicit
  then with_stop_guard tc (fun () -> Ffi.event tc.context tc.handle label)
;;

(** [event_value tc ~label ~value] records the finite observation [value] under
    [label] for the end-of-run statistics report. *)
let event_value tc ~label ~value =
  if Option.is_none tc.explicit
  then with_stop_guard tc (fun () -> Ffi.event_value tc.context tc.handle value label)
;;

(** [start_span ~label tc] starts a generation span for better shrinking. *)
let start_span ~label tc =
  if Atomic.get tc.test_aborted
  then ()
  else
    with_stop_guard tc (fun () ->
      Ffi.start_span tc.context tc.handle (Label.resolve tc.context label))
;;

(** [stop_span ?discard tc] ends the current generation span. *)
let stop_span ?(discard = false) tc =
  if Atomic.get tc.test_aborted
  then ()
  else with_stop_guard tc (fun () -> Ffi.stop_span tc.context tc.handle discard)
;;

type collection = Ffi.collection
type pool = Ffi.pool
type state_machine = Ffi.state_machine

let new_state_machine_with_concurrency
      tc
      ~rule_names
      ~rule_groups
      ~rule_weights
      ~invariant_names
      ~invariants_always_check
      ~step_count
      ~min_concurrency
      ~max_concurrency
  =
  with_stop_guard tc (fun () ->
    Ffi.new_state_machine
      tc.context
      tc.handle
      ~rule_names
      ~rule_groups
      ~rule_weights
      ~invariant_names
      ~invariants_always_check
      ~step_count
      ~min_concurrency
      ~max_concurrency)
;;

(** [new_collection tc ~min_size ~max_size] starts an engine-managed collection.
    Release it with {!collection_free}. Raises {!Stop_test} on StopTest. *)
let new_collection tc ~min_size ~max_size =
  with_stop_guard tc (fun () ->
    Ffi.new_collection tc.context tc.handle ~min_size ~max_size)
;;

(** [collection_more tc ~collection] returns whether the engine wants another
    element. Raises {!Stop_test} on StopTest. *)
let collection_more tc ~collection =
  with_stop_guard tc (fun () -> Ffi.collection_more tc.context tc.handle collection)
;;

(** [collection_reject tc ~collection] rejects the collection's last element.
    Raises {!Stop_test} on StopTest. *)
let collection_reject tc ~collection =
  with_stop_guard tc (fun () ->
    Ffi.collection_reject tc.context tc.handle collection None)
;;

let collection_free tc ~collection = Ffi.collection_free tc.context collection

let new_pool tc =
  let pool = with_stop_guard tc (fun () -> Ffi.new_pool tc.context tc.handle) in
  Locked.protect tc.owned (fun owned -> owned.pools <- pool :: owned.pools);
  pool
;;

(** [pool_add tc ~pool] adds a fresh variable to [pool] and returns the new
    variable id. *)
let pool_add tc ~pool =
  with_stop_guard tc (fun () -> Ffi.pool_add tc.context tc.handle ~pool)
;;

(** [pool_generate tc ~pool ?consume ()] draws a variable id from [pool]. When
    [consume] is [true], the variable is also removed from the pool. Drawing
    from an empty pool raises {!Assume_rejected}. *)
let pool_generate tc ~pool ?(consume = false) () =
  with_stop_guard tc (fun () -> Ffi.pool_generate tc.context tc.handle ~pool ~consume)
;;

(** [pool_restore tc ~pool ~variable_id] puts back a variable that a consuming
    {!pool_generate} removed from [pool]. *)
let pool_restore tc ~pool ~variable_id =
  with_stop_guard tc (fun () ->
    Ffi.pool_restore tc.context tc.handle ~pool ~variable_id)
;;

let state_machine_next_group tc ~state_machine =
  with_stop_guard tc (fun () ->
    Ffi.state_machine_next_group tc.context tc.handle ~state_machine)
;;

let state_machine_next_rule_for_worker tc ~state_machine ~worker_index =
  with_stop_guard tc (fun () ->
    Ffi.state_machine_next_rule tc.context tc.handle ~state_machine ~worker_index)
;;

let state_machine_rule_rejected_for_worker tc ~state_machine ~worker_index =
  with_stop_guard tc (fun () ->
    Ffi.state_machine_rule_rejected tc.context tc.handle ~state_machine ~worker_index)
;;

(** [state_machine_should_check_invariant tc ~state_machine ~invariant_index]
    decides whether to run invariant [invariant_index] after the current round.
    Raises {!Stop_test} when the engine's choice budget is exhausted. *)
let state_machine_should_check_invariant tc ~state_machine ~invariant_index =
  with_stop_guard tc (fun () ->
    Ffi.state_machine_should_check_invariant
      tc.context
      tc.handle
      ~state_machine
      ~invariant_index)
;;

let state_machine_free tc ~state_machine = Ffi.state_machine_free tc.context state_machine

(* ------------------------------------------------------------------ *)
(* Settings translation                                                *)
(* ------------------------------------------------------------------ *)

(** [build_ffi_settings ctx settings ~database_key ~test_location] allocates the
    native settings handle for a run: [Settings.to_ffi], plus the test's
    location when one is known. libhegel uses the location to report the
    run's result as an Antithesis assertion (see [Ffi.settings_test_location]);
    without one it reports nothing. The "class" is the file path without the .ml
    extension. The caller must free the handle. *)
let build_ffi_settings ctx (settings : Settings.t) ~database_key ~test_location =
  let s = Settings.to_ffi ctx settings ~database_key in
  Option.iter
    (fun (loc : test_location) ->
       Ffi.settings_test_location
         ctx
         s
         ~file:loc.file
         ~begin_line:loc.begin_line
         ~class_name:(Filename.remove_extension loc.file)
         ~function_name:loc.function_name)
    test_location;
  s
;;

type interesting_case =
  { origin : string
  ; exn : exn
  ; backtrace : Printexc.raw_backtrace
  }

type result =
  | Valid
  | Invalid
  | Overrun
  | Failed of interesting_case

type case_outcome =
  { result : result
  ; output : string
  ; should_capture : bool
  }

(** [capture_document tc] renders the document of a test case, its clones,
    and blocks.. *)
let capture_document (tc : test_case) =
  if not (should_print tc)
  then ""
  else (
    let printer = Ffi.test_case_printer tc.context tc.handle None in
    Fun.protect
      ~finally:(fun () -> Ffi.printer_free tc.context printer)
      (fun () ->
         (* Resolve splices from clone documents. *)
         match Ffi.printer_resolve tc.context printer with
         | () -> Ffi.printer_value tc.context printer
         | exception Usage_error _ -> Ffi.printer_value tc.context printer))
;;

(** Width the framed failure report's header rule is padded to. *)
let frame_width = 80

let print_failure_header test_location =
  let title =
    match test_location with
    | None -> "Failure"
    | Some (loc : test_location) ->
      Printf.sprintf "Failure: %s (%s:%d)" loc.function_name loc.file loc.begin_line
  in
  let prefix = Printf.sprintf "--- %s " title in
  let rule = prefix ^ String.make (max 3 (frame_width - String.length prefix)) '-' in
  Printf.eprintf "%s\n%!" (stderr_color ansi_red rule)
;;

type rerun_hint =
  | Argument
  | Attribute
  | Command_line

let print_failure_body ~(settings : Settings.t) ~rerun_hint ~blob ~caveat ~exn ~output =
  if not (String.equal output "") then Printf.eprintf "\n%s\n%!" output;
  Printf.eprintf "Exception: %s\n%!" (Stdlib.Printexc.to_string exn);
  Option.iter (fun caveat -> Printf.eprintf "note: %s\n%!" caveat) caveat;
  if settings.print_blob
  then
    Option.iter
      (fun blob ->
         match rerun_hint with
         | Argument -> Printf.eprintf "rerun with: ~failure_blobs:[ \"%s\" ]\n%!" blob
         | Attribute -> Printf.eprintf "rerun with: [@@failure_blobs [ \"%s\" ]]\n%!" blob
         | Command_line -> Printf.eprintf "rerun with: --failure-blob %s\n%!" blob)
      blob
;;

let reraise failure = Printexc.raise_with_backtrace failure.exn failure.backtrace

exception
  Failed_health_check of
    { check : Settings.health_check option
    ; message : string
    }

exception Flaky of string
exception Unsatisfiable of string
exception Run_error of string
exception Multiple_failures of exn list
exception Did_not_reproduce of string

let run_error_exn ((kind : Ffi.run_error_kind), health_check) message =
  match kind with
  | Run_error_health_check ->
    Failed_health_check { check = Settings.health_check_of_bit health_check; message }
  | Run_error_flaky -> Flaky message
  | Run_error_unsatisfiable -> Unsatisfiable message
  | Run_error_other -> Run_error message
;;

(** [run_example ~settings ~test_location index (names, body)] runs the
    explicit example [body], which gives values for the draws bound to
    [names], on a test case with no engine behind it. A failure is reported
    and returned. *)
let run_example ~(settings : Settings.t) ~test_location index (names, body) =
  let explicit = Locked.create (fun () -> { drawn = []; lines = [] }) in
  let (tc : test_case) =
    { handle = Ffi.null_test_case
    ; context = Ffi.null_context
    ; should_capture = true
    ; verbosity = settings.verbosity
    ; test_aborted = Atomic.make false
    ; draw_depth = Atomic.make 0
    ; draw_state = Locked.create (fun () -> Hashtbl.create 16)
    ; owned = Locked.create (fun () -> { pools = []; clones = [] })
    ; explicit = Some explicit
    }
  in
  let outcome =
    DLS.set in_test_context true;
    Fun.protect
      ~finally:(fun () -> DLS.set in_test_context false)
      (fun () ->
         match body tc with
         | () | (exception Repeat_done) -> `Passed
         | exception Assume_rejected ->
           raise
             (Usage_error
                (Printf.sprintf
                   "Explicit test cases must not be rejected, but explicit example %d \
                    was rejected"
                   index))
         | exception ((Usage_error _ | Internal_error _) as error) -> raise error
         | exception exn ->
           let backtrace = Printexc.get_raw_backtrace () in
           `Failed { origin = extract_origin exn; exn; backtrace })
  in
  match outcome with
  | `Passed ->
    (match
       let drawn = Locked.protect explicit (fun e -> e.drawn) in
       List.filter (fun name -> not (List.mem name drawn)) names
     with
     | [] -> None
     | unused ->
       raise
         (Usage_error
            (Printf.sprintf
               "Explicit example %d gives values that were never drawn: %s"
               index
               (String.concat ", " unused))))
  | `Failed failure ->
    if settings.verbosity <> Quiet
    then (
      let title =
        match test_location with
        | None -> Printf.sprintf "Explicit example %d" index
        | Some (loc : test_location) ->
          Printf.sprintf
            "Explicit example %d: %s (%s:%d)"
            index
            loc.function_name
            loc.file
            loc.begin_line
      in
      let prefix = Printf.sprintf "--- %s " title in
      Printf.eprintf
        "%s\n%!"
        (stderr_color
           ansi_red
           (prefix ^ String.make (max 3 (frame_width - String.length prefix)) '-'));
      (match List.rev (Locked.protect explicit (fun e -> e.lines)) with
       | [] -> ()
       | lines -> Printf.eprintf "\n%s\n%!" (String.concat "\n" lines));
      Printf.eprintf "\nException: %s\n%!" (Stdlib.Printexc.to_string failure.exn));
    Some failure
;;

let did_not_reproduce_message =
  "The failure blob did not reproduce an error. The failure is fixed, or a \
   nondeterministic failure did not occur again in the replays."
;;

(** [run_test ~settings ?test_location ?database_key ?failure_blobs test_fn] runs
    a property test using the given settings against the native engine.

    With an empty [failure_blobs] (the default) it executes the database replay,
    generation, and shrinking phases. With a non-empty [failure_blobs] the
    engine replays each blob in turn, until a replay of it fails, and every
    failure the blobs reproduced is reported.

    @param test_location
      source location of the test. Passed to libhegel, which inside Antithesis
      reports the run's result as an assertion at that location. It is also the
      default database key. Provided automatically by the [let%hegel_test]
      PPX. When omitted, nothing is reported.
    @param rerun_hint
      the form of the [rerun with:] hint: the [~failure_blobs] argument a plain
      caller would use (the default), the [[@@failure_blobs [...]]] attribute
      for the [let%hegel_test] PPX, or the [--failure-blob] flag for a
      [Hegel.main] binary.
    @param on_failure
      called after a failure is reported and before its exception is
      re-raised. [Hegel.main] exits from it.
    @param database_key
      optional key scoping persisted/replayed failing examples and, under [derandomize],
      the per-test seed. Defaults to the test's [test_location] (as
      [file:function_name]) so each [let%hegel_test] gets a stable, distinct
      key; pass an explicit key to override. When both are absent, the run has
      no database key, so failures are neither stored nor replayed.
    @param failure_blobs
      a list of base64 encoded strings (blobs), where each string encodes the
      choices made in a failing test run. Every blob is replayed. A blob is only
      guaranteed to reproduce a failure within a specific version of Hegel. A
      run that replays blobs replays only them: the explicit examples do not
      run. *)
let run_test
      ~(settings : Settings.t)
      ?test_location
      ?(rerun_hint = Argument)
      ?(on_failure = ignore)
      ?database_key
      ?(failure_blobs = [])
      ?(examples = [])
      test_fn
  =
  if DLS.get in_test_context
  then raise (Usage_error "Cannot nest test cases - already inside a test case");
  (* Default the database key to the test's identity so each [let%hegel_test]
     gets a stable, distinct key: this scopes its persisted corpus and, under
     [derandomize], its per-test seed. An explicit [database_key] wins. *)
  let database_key =
    match database_key with
    | Some _ as k -> k
    | None ->
      Option.map
        (fun (loc : test_location) -> Printf.sprintf "%s:%s" loc.file loc.function_name)
        test_location
  in
  let ctx = Ffi.context_new () in
  let ffi_settings = build_ffi_settings ctx settings ~database_key ~test_location in
  let captured = Hashtbl.create 4 in
  let run_case handle =
    let should_capture = Ffi.test_case_should_capture ctx handle in
    let (tc : test_case) =
      { handle
      ; context = ctx
      ; should_capture
      ; verbosity = settings.verbosity
      ; test_aborted = Atomic.make false
      ; draw_depth = Atomic.make 0
      ; draw_state = Locked.create (fun () -> Hashtbl.create 16)
      ; owned = Locked.create (fun () -> { pools = []; clones = [] })
      ; explicit = None
      }
    in
    let run_body () =
      match test_fn tc with
      | () | (exception Repeat_done) -> Valid
      | exception Assume_rejected -> Invalid
      | exception Stop_test -> Overrun
      | exception Flaky_strategy -> Invalid
      | exception ((Usage_error _ | Internal_error _) as control) -> raise control
      | exception exn ->
        let backtrace = Printexc.get_raw_backtrace () in
        Failed { origin = extract_origin exn; exn; backtrace }
    in
    DLS.set in_test_context true;
    let result =
      Fun.protect
        ~finally:(fun () ->
          DLS.set in_test_context false;
          free_owned tc)
        run_body
    in
    let status, origin =
      match result with
      | Valid -> Ffi.Valid, None
      | Invalid -> Ffi.Invalid, None
      | Overrun -> Ffi.Overrun, None
      | Failed failure -> Ffi.Interesting, Some failure.origin
    in
    Ffi.mark_complete ctx handle status origin;
    { result; output = capture_document tc; should_capture }
  in
  (* Keep the newest stamped failure of each origin for the report. *)
  let update_captured failure outcome =
    match Hashtbl.find_opt captured failure.origin with
    | Some (_, curr_outcome) when curr_outcome.should_capture && not outcome.should_capture -> ()
    | Some _ | None -> Hashtbl.replace captured failure.origin (failure, outcome)
  in
  let report_failure failure =
    let origin = Ffi.failure_origin ctx failure in
    let failure_case, outcome = Hashtbl.find captured origin in
    print_failure_body
      ~settings
      ~rerun_hint
      ~blob:(Ffi.failure_blob ctx failure)
      ~caveat:(Ffi.failure_caveat ctx failure)
      ~exn:failure_case.exn
      ~output:outcome.output;
    failure_case
  in
  let run_error result =
    run_error_exn
      (Ffi.result_error_kind ctx result)
      (Option.value (Ffi.result_error ctx result) ~default:"hegel: run error (no message)")
  in
  let handle_result result =
    match Ffi.result_status ctx result with
    | Ffi.Run_passed -> []
    | Ffi.Run_error -> raise (run_error result)
    | Ffi.Run_failed ->
      let failures = Ffi.result_failures ctx result in
      Fun.protect
        ~finally:(fun () -> List.iter (fun f -> Ffi.failure_free ctx f) failures)
        (fun () ->
           print_failure_header test_location;
           match failures with
           | [ failure ] -> [ report_failure failure ]
           | failures ->
             let count = List.length failures in
             List.mapi
               (fun i failure ->
                  Printf.eprintf
                    "\n%s%!"
                    (stderr_color
                       ansi_red
                       (Printf.sprintf "Failure %d of %d:" (i + 1) count));
                  report_failure failure)
               failures)
  in
  let drive run =
    Hashtbl.reset captured;
    Fun.protect
      ~finally:(fun () -> Ffi.run_free ctx run)
      (fun () ->
         let rec loop () =
           match Ffi.next_test_case ctx run with
           | None -> ()
           | Some handle ->
             (* Free the case before moving on to the next one. *)
             let outcome =
               Fun.protect
                 ~finally:(fun () -> Ffi.test_case_free ctx handle)
                 (fun () -> run_case handle)
             in
             (match settings.verbosity with
              | Verbose | Debug -> Printf.eprintf "%s%!" outcome.output
              | Quiet | Normal -> ());
             (match outcome.result with
              | Failed failure -> update_captured failure outcome
              | Valid | Invalid | Overrun -> ());
             loop ()
         in
         loop ();
         let result = Ffi.run_result ctx run in
         Fun.protect
           ~finally:(fun () -> Ffi.run_result_free ctx result)
           (fun () -> handle_result result))
  in
  let raise_failures = function
    | [] -> ()
    | [ failure ] ->
      on_failure ();
      reraise failure
    | failures ->
      on_failure ();
      raise (Multiple_failures (List.map (fun failure -> failure.exn) failures))
  in
  Fun.protect
    ~finally:(fun () ->
      Ffi.settings_free ctx ffi_settings;
      Ffi.context_free ctx)
    (fun () ->
       let rec run_examples index = function
         | [] -> []
         | example :: rest ->
           (match run_example ~settings ~test_location index example with
            | None -> run_examples (index + 1) rest
            | Some failure when settings.report_multiple_failures ->
              failure :: run_examples (index + 1) rest
            | Some failure -> [ failure ])
       in
       match failure_blobs with
       | [] ->
         let explicit_failures =
           if List.mem Explicit settings.phases then run_examples 1 examples else []
         in
         if (not (List.is_empty explicit_failures))
            && not settings.report_multiple_failures
         then raise_failures explicit_failures
         else raise_failures (explicit_failures @ drive (Ffi.run_start ctx ffi_settings))
       | blobs ->
         (match
            List.concat_map
              (fun blob -> drive (Ffi.run_start_blob ctx ffi_settings blob))
              blobs
          with
          | [] -> raise (Did_not_reproduce did_not_reproduce_message)
          | failures -> raise_failures failures))
;;

(** [run_hegel_test ?settings ?test_location ?database_key ?failure_blobs test_fn]
    is {!run_test} with [settings] defaulting to [Settings.default ()]. This is the
    public entry point the [let%hegel_test] PPX targets and is re-exported as
    [Hegel.run_hegel_test].

    @param database_key
      overrides the key scoping this test's persisted corpus and [derandomize]
      seed. When omitted it defaults to the test's [test_location] (see
      {!run_test}), so each [let%hegel_test] is scoped by its own identity. *)
let run_hegel_test
      ?(settings = Settings.default ())
      ?test_location
      ?rerun_hint
      ?database_key
      ?failure_blobs
      ?examples
      test_fn
  =
  run_test
    ~settings
    ?test_location
    ?rerun_hint
    ?database_key
    ?failure_blobs
    ?examples
    test_fn
;;
