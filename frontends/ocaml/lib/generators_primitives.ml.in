open Sexplib0.Sexp_conv
open Generators_core

#ifdef OXCAML
#define MODE(m) @ m
#define ABSTRACT(a, k) (type (a : k))
#else
#define MODE(m)
#define ABSTRACT(a, k) (type a)
#endif

(** [integers ?min_value ?max_value ()] creates a generator for integers within
    the given bounds. When a bound is omitted it defaults to the corresponding
    OCaml native [int] limit. *)
let integers ?(min_value = Int.min_int) ?(max_value = Int.max_int) (): _ MODE(portable) =
  (leaf [@mode portable])
    ~name:"integers"
    ~draw:(fun tc -> Internal.generate_integer tc ~min_value ~max_value)
    ~sexp_of:sexp_of_int
    ~print:Printer.int
;;

(** [booleans ?p ()] creates a generator for boolean values, [true] with
    probability [p] (default [0.5]). *)
let booleans ?(p = 0.5) (): _ MODE(portable) =
  (leaf [@mode portable])
    ~name:"booleans"
    ~draw:(fun tc -> Internal.generate_boolean tc p None)
    ~sexp_of:sexp_of_bool
    ~print:Printer.bool
;;

(** [floats ?width ?min_value ?max_value ?exclude_min ?exclude_max ?allow_nan ?allow_infinity ()] creates a generator for floating-point values.

    With [~width:`W32] every drawn value is exactly representable as a 32-bit
    float, and the bounds must be too. The smallest positive subnormal of the
    width is passed as [smallest_nonzero_magnitude], so the engine places no
    magnitude restriction on drawn floats.

    Unbounded ends are sent to the engine as [neg_infinity] / [infinity].

    Defaults:
    - [exclude_min]: [false]
    - [exclude_max]: [false]
    - [allow_nan]: [true] only when no bounds are set
    - [allow_infinity]: [true] when at most one bound is set *)
let floats
      ?(width = `W64)
      ?(min_value : float option)
      ?(max_value : float option)
      ?(exclude_min = false)
      ?(exclude_max = false)
      ?(allow_nan : bool option)
      ?(allow_infinity : bool option)
      ()
 : _ MODE(portable) =
  let has_min = Option.is_some min_value in
  let has_max = Option.is_some max_value in
  let eff_allow_nan =
    match allow_nan with
    | Some v -> v
    | None -> (not has_min) && not has_max
  in
  let eff_allow_infinity =
    match allow_infinity with
    | Some v -> v
    | None -> (not has_min) || not has_max
  in
  let min_value = Option.value min_value ~default:neg_infinity in
  let max_value = Option.value max_value ~default:infinity in
  let width, smallest_nonzero_magnitude =
    match width with
    | `W64 -> 64, 5e-324
    | `W32 -> 32, Float.ldexp 1.0 (-149)
  in
  (leaf [@mode portable])
    ~name:"floats"
    ~draw:(fun tc ->
      Internal.generate_float
        tc
        ~width
        ~min_value
        ~max_value
        ~allow_nan:eff_allow_nan
        ~allow_infinity:eff_allow_infinity
        ~exclude_min
        ~exclude_max
        ~smallest_nonzero_magnitude)
    ~sexp_of:sexp_of_float
    ~print:Printer.float
;;

(** [text_generator ~min_size ~max_size ...] is the shared {!Leaf} builder
    behind {!text} and {!characters}: it draws a text string over the described
    alphabet, which the engine validates. The engine applies [exclude_categories]
    only when [categories] is absent, so giving both is rejected here rather
    than ignoring one. *)
let text_generator
      ~min_size
      ~max_size
      ?(codec : string option)
      ?(min_codepoint : int option)
      ?(max_codepoint : int option)
      ?(categories : string list option)
      ?(exclude_categories : string list option)
      ?(include_characters : string option)
      ?(exclude_characters : string option)
      ()
 : _ MODE(portable) =
  if Option.is_some categories && Option.is_some exclude_categories
  then
    raise (Internal.Usage_error "categories and exclude_categories are mutually exclusive");
  (leaf [@mode portable])
    ~name:"text"
    ~draw:(fun tc ->
      Internal.generate_text
        tc
        ~min_size
        ~max_size
        ~codec
        ~min_codepoint:(Option.value min_codepoint ~default:0)
        ~max_codepoint:(Option.value max_codepoint ~default:0xFFFFFFFF)
        ~categories
        ~exclude_categories
        ~include_characters
        ~exclude_characters)
    ~sexp_of:sexp_of_string
    ~print:Printer.string
;;

(** [text ?min_size ?max_size ?codec ?min_codepoint ?max_codepoint ?categories ?exclude_categories ?include_characters ?exclude_characters ?alphabet ()]
    creates a generator for Unicode text strings.

    Character filtering options restrict which characters may appear. The
    [alphabet] parameter is mutually exclusive with all individual character
    filtering parameters. The engine always excludes surrogate codepoints, so
    the drawn strings are valid UTF-8. *)
let text
      ?(min_size = 0)
      ?max_size
      ?codec
      ?min_codepoint
      ?max_codepoint
      ?categories
      ?exclude_categories
      ?include_characters
      ?exclude_characters
      ?alphabet
      ()
 : _ MODE(portable) =
  if min_size < 0
  then
    raise
      (Internal.Usage_error (Printf.sprintf "min_size=%d must be non-negative" min_size));
  (match max_size with
   | Some ms when ms < 0 ->
     raise (Internal.Usage_error (Printf.sprintf "max_size=%d must be non-negative" ms))
   | _ -> ());
  let has_char_param =
    List.mem
      true
      [ Option.is_some codec
      ; Option.is_some min_codepoint
      ; Option.is_some max_codepoint
      ; Option.is_some categories
      ; Option.is_some exclude_categories
      ; Option.is_some include_characters
      ; Option.is_some exclude_characters
      ]
  in
  (match alphabet with
   | Some _ when has_char_param ->
     raise
       (Internal.Usage_error
          "alphabet is mutually exclusive with individual character filtering parameters")
   | _ -> ());
  match alphabet with
  | Some alph ->
    (* An explicit alphabet: an empty base category set plus exactly these
       characters unioned in. *)
    text_generator ~min_size ~max_size ~categories:[] ~include_characters:alph ()
  | None ->
    text_generator
      ~min_size
      ~max_size
      ?codec
      ?min_codepoint
      ?max_codepoint
      ?categories
      ?exclude_categories
      ?include_characters
      ?exclude_characters
      ()
;;

(** [characters ?codec ?min_codepoint ?max_codepoint ?categories ?exclude_categories ?include_characters ?exclude_characters ()] creates a
    generator for single Unicode characters (as single-character UTF-8 strings).

    Character filtering options restrict which characters may appear. The engine
    always excludes surrogate codepoints, so the drawn strings are valid UTF-8. *)
let characters
      ?codec
      ?min_codepoint
      ?max_codepoint
      ?categories
      ?exclude_categories
      ?include_characters
      ?exclude_characters
      ()
 : _ MODE(portable) =
  text_generator
    ~min_size:1
    ~max_size:(Some 1)
    ?codec
    ?min_codepoint
    ?max_codepoint
    ?categories
    ?exclude_categories
    ?include_characters
    ?exclude_characters
    ()
;;

(** [draw_char tc] draws one character over the full native [char] range
    (codepoints 0-255, i.e. Latin-1). A codepoint above 127 encodes to two
    UTF-8 bytes, so the drawn string is decoded rather than indexed. libhegel 
    draw cannot be in [of_char] closure or {!chars} becomes nonportable. *)
let draw_char tc =
  let s =
    Internal.generate_text
      tc
      ~min_size:1
      ~max_size:(Some 1)
      ~codec:None
      ~min_codepoint:0
      ~max_codepoint:0xFF
      ~categories:None
      ~exclude_categories:None
      ~include_characters:None
      ~exclude_characters:None
  in
  let decoded = String.get_utf_8_uchar s 0 in
  Char.chr (Uchar.to_int (Uchar.utf_decode_uchar decoded))
;;

(** [make_characters ~of_char ~sexp_of ()] builds a generator for single
    characters over any representation ['a], covering the full native [char]
    range (codepoints 0-255, i.e. Latin-1). Drawn characters print as the
    s-expressions [sexp_of] gives. *)
let%template make_characters
  : type a. of_char:(char -> a) MODE(m) -> sexp_of:(a -> Sexp.t) MODE(m) -> unit -> (a, printable) generator MODE(m)
  =
  fun ~of_char ~sexp_of () ->
  (leaf [@mode m])
    ~name:"characters"
    ~draw:(fun tc -> of_char (draw_char tc))
    ~sexp_of
    ~print:(fun v -> Printer.of_sexp sexp_of v)
[@@mode m = (nonportable, portable)]
;;

(** [chars ()] creates a generator for single characters (codepoints 0-255, i.e.
    Latin-1) as native [char] values. *)
let chars () : _ MODE(portable) =
  (leaf [@mode portable])
    ~name:"characters"
    ~draw:draw_char
    ~sexp_of:sexp_of_char
    ~print:Printer.char
;;

(** [binary ?min_size ?max_size ()] creates a generator for binary byte strings. *)
let binary ?(min_size = 0) ?(max_size : int option) (): _ MODE(portable) =
  if min_size < 0
  then
    raise
      (Internal.Usage_error (Printf.sprintf "min_size=%d must be non-negative" min_size));
  (match max_size with
   | Some ms when ms < 0 ->
     raise (Internal.Usage_error (Printf.sprintf "max_size=%d must be non-negative" ms))
   | _ -> ());
  (leaf [@mode portable])
    ~name:"binary"
    ~draw:(fun tc -> Internal.generate_bytes tc ~min_size ~max_size)
    ~sexp_of:sexp_of_string
    ~print:Printer.bytes
;;

(** [just value] creates a generator that always produces [value].

    The output type is chosen by the caller, so no printer is carried. *)
let%template just ABSTRACT(a, value mod c) (value : a MODE(m))
  : (a, unprintable) generator MODE(m)
  =
  (leaf_silent [@mode m]) ~name:"just" ~draw:(fun _ -> value)
[@@mode (m, c) = ((nonportable, uncontended), (portable, contended))]
;;

(** [char_alphabet ?codec ... ?alphabet ()] is the character set the
    filtering options of {!text} describe, for a generator that draws every
    character from it ([None] when no option is given). *)
let char_alphabet
      ?codec
      ?min_codepoint
      ?max_codepoint
      ?categories
      ?exclude_categories
      ?include_characters
      ?exclude_characters
      ?alphabet
      ()
  : Internal.alphabet option
  =
  if Option.is_some categories && Option.is_some exclude_categories
  then
    raise (Internal.Usage_error "categories and exclude_categories are mutually exclusive");
  let has_char_param =
    List.mem
      true
      [ Option.is_some codec
      ; Option.is_some min_codepoint
      ; Option.is_some max_codepoint
      ; Option.is_some categories
      ; Option.is_some exclude_categories
      ; Option.is_some include_characters
      ; Option.is_some exclude_characters
      ]
  in
  match alphabet with
  | Some _ when has_char_param ->
    raise
      (Internal.Usage_error
         "alphabet is mutually exclusive with individual character filtering parameters")
  | Some chars ->
    Some
      { codec = None
      ; min_codepoint = 0
      ; max_codepoint = 0xFFFFFFFF
      ; categories = Some []
      ; exclude_categories = None
      ; include_characters = Some chars
      ; exclude_characters = None
      }
  | None when has_char_param ->
    Some
      { codec
      ; min_codepoint = Option.value min_codepoint ~default:0
      ; max_codepoint = Option.value max_codepoint ~default:0xFFFFFFFF
      ; categories
      ; exclude_categories
      ; include_characters
      ; exclude_characters
      }
  | None -> None
;;

(** [from_regex pattern ?fullmatch ?codec ... ?alphabet ()] creates a
    generator for strings matching a regular expression [pattern], written in
    the syntax of Python's [re] module. When [fullmatch] is [true] (the
    default) the whole string must match [pattern]; otherwise a match anywhere
    suffices. The character filtering options restrict the characters of the
    drawn string as they do for {!text}. *)
let from_regex
      pattern
      ?(fullmatch = true)
      ?codec
      ?min_codepoint
      ?max_codepoint
      ?categories
      ?exclude_categories
      ?include_characters
      ?exclude_characters
      ?alphabet
      ()
  : _ MODE(portable)
  =
  let alphabet =
    char_alphabet
      ?codec
      ?min_codepoint
      ?max_codepoint
      ?categories
      ?exclude_categories
      ?include_characters
      ?exclude_characters
      ?alphabet
      ()
  in
  (leaf [@mode portable])
    ~name:"from_regex"
    ~draw:(fun tc -> Internal.generate_regex tc ~pattern ~fullmatch ~alphabet)
    ~sexp_of:sexp_of_string
    ~print:Printer.string
;;

(** [format_uuid bytes] renders 16 big-endian bytes as a lowercase hyphenated
    UUID. *)
let format_uuid bytes =
  let hex i j =
    String.concat
      ""
      (List.init (j - i) (fun k -> Printf.sprintf "%02x" (Char.code bytes.[i + k])))
  in
  String.concat "-" [ hex 0 4; hex 4 6; hex 6 8; hex 8 10; hex 10 16 ]
;;

(** [uuids ?version ()] creates a generator for UUIDs, as lowercase hyphenated
    strings. With [version] (1 to 5), the version and variant are set as in
    RFC 4122. The nil UUID is never generated. *)
let uuids ?version () : _ MODE(portable) =
  (match version with
   | Some v when v < 1 || v > 5 ->
     raise
       (Internal.Usage_error (Printf.sprintf "version=%d must be between 1 and 5" v))
   | _ -> ());
  (leaf [@mode portable])
    ~name:"uuids"
    ~draw:(fun tc -> format_uuid (Internal.generate_uuid tc ~version))
    ~sexp_of:sexp_of_string
    ~print:Printer.string
;;

(** [emails ()] creates a generator for valid email address strings.

    Addresses follow RFC 5321/5322: a local part of 1 to 64 characters from the
    RFC 5322 [atext] set, an [@], and a domain from {!domains}, with the overall
    address length capped at 254 octets (RFC 5321 §4.5.3.1.3). *)
let emails () : _ MODE(portable) = (leaf [@mode portable]) ~name:"emails" ~draw:Internal.generate_email ~sexp_of:sexp_of_string ~print:Printer.string

(** [urls ()] creates a generator for valid URL strings.

    URLs follow RFC 3986, of the form [scheme://domain[:port]/path[#fragment]]
    with [scheme] one of [http]/[https], the domain drawn from {!domains} (up to
    255 characters), an optional port in [1, 65535], zero or more [/]-separated
    path segments of up to 100 characters each, and an optional fragment of up
    to 100 characters. Path and fragment characters are percent-encoded. *)
let urls () : _ MODE(portable) = (leaf [@mode portable]) ~name:"urls" ~draw:Internal.generate_url ~sexp_of:sexp_of_string ~print:Printer.string

(** [domains ?max_length ()] creates a generator for domain name strings.

    Domains are RFC 1035 fully-qualified domain names: a top-level domain
    sampled from the IANA TLD list followed by up to 126 dot-separated labels,
    each 1 to 63 characters matching [[a-zA-Z]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?]
    (punycode [xn--] labels reserved by RFC 5890 are excluded). Generated
    domains never exceed [max_length] (default 255, per RFC 1035 §2.3.4); when
    provided, [max_length] must be in [4, 255]. *)
let domains ?(max_length : int option) (): _ MODE(portable) =
  let max_length = Option.value max_length ~default:255 in
  (leaf [@mode portable])
    ~name:"domains"
    ~draw:(fun tc -> Internal.generate_domain tc ~max_length)
    ~sexp_of:sexp_of_string
    ~print:Printer.string
;;

type date = Internal.date =
  { year : int
  ; month : int
  ; day : int
  }

type time = Internal.time =
  { hour : int
  ; minute : int
  ; second : int
  ; nanosecond : int
  }

let format_date { year; month; day } = Printf.sprintf "%04d-%02d-%02d" year month day

let format_time { hour; minute; second; nanosecond } =
  Printf.sprintf "%02d:%02d:%02d.%09d" hour minute second nanosecond
;;

let format_datetime (date, time) = format_date date ^ "T" ^ format_time time
let first_date = { year = 1; month = 1; day = 1 }
let last_date = { year = 9999; month = 12; day = 31 }
let first_time = { hour = 0; minute = 0; second = 0; nanosecond = 0 }
let last_time = { hour = 23; minute = 59; second = 59; nanosecond = 999_999_999 }

(** [make_dates ~of_date ~sexp_of ?min_date ?max_date ()] builds a generator
    for dates in [[min_date, max_date]] over any representation. [of_date]
    converts each drawn {!date} to the desired representation, and drawn dates
    print as the s-expressions [sexp_of] gives. The default range is
    [[0001-01-01, 9999-12-31]]. [make_dates_printed] also takes the [print]
    that displays them. *)
let%template make_dates_printed
      ~(of_date : (date -> 'a) MODE(m))
      ~(sexp_of : ('a -> Sexp.t) MODE(m))
      ~(print : ('a -> Printer.doc) MODE(m))
      ?(min_date = first_date)
      ?(max_date = last_date)
      ()
  : ('a, printable) generator MODE(m)
  =
  (leaf [@mode m])
    ~name:"dates"
    ~draw:(fun tc ->
      of_date (Internal.generate_date tc ~min_value:min_date ~max_value:max_date))
    ~sexp_of
    ~print
[@@mode m = (nonportable, portable)]
;;

let%template make_dates
      ~(of_date : (date -> 'a) MODE(m))
      ~(sexp_of : ('a -> Sexp.t) MODE(m))
      ?min_date
      ?max_date
      ()
  : ('a, printable) generator MODE(m)
  =
  (make_dates_printed [@mode m])
    ~of_date
    ~sexp_of
    ~print:(fun v -> Printer.of_sexp sexp_of v)
    ?min_date
    ?max_date
    ()
[@@mode m = (nonportable, portable)]
;;

(** [make_times ~of_time ~sexp_of ?min_time ?max_time ()] builds a generator
    for times of day in [[min_time, max_time]] over any representation.
    [of_time] converts each drawn {!time} to the desired representation, and
    drawn times print as the s-expressions [sexp_of] gives. The default range
    is [[00:00:00.000000000, 23:59:59.999999999]]. [make_times_printed] also
    takes the [print] that displays them. *)
let%template make_times_printed
      ~(of_time : (time -> 'a) MODE(m))
      ~(sexp_of : ('a -> Sexp.t) MODE(m))
      ~(print : ('a -> Printer.doc) MODE(m))
      ?(min_time = first_time)
      ?(max_time = last_time)
      ()
  : ('a, printable) generator MODE(m)
  =
  (leaf [@mode m])
    ~name:"times"
    ~draw:(fun tc ->
      of_time (Internal.generate_time tc ~min_value:min_time ~max_value:max_time))
    ~sexp_of
    ~print
[@@mode m = (nonportable, portable)]
;;

let%template make_times
      ~(of_time : (time -> 'a) MODE(m))
      ~(sexp_of : ('a -> Sexp.t) MODE(m))
      ?min_time
      ?max_time
      ()
  : ('a, printable) generator MODE(m)
  =
  (make_times_printed [@mode m])
    ~of_time
    ~sexp_of
    ~print:(fun v -> Printer.of_sexp sexp_of v)
    ?min_time
    ?max_time
    ()
[@@mode m = (nonportable, portable)]
;;

(** [make_datetimes ~of_datetime ~sexp_of ?min_datetime ?max_datetime ()]
    builds a generator for naive datetimes in [[min_datetime, max_datetime]]
    over any representation. [of_datetime] converts each drawn [(date, time)]
    pair to the desired representation, and drawn datetimes print as the
    s-expressions [sexp_of] gives. The default range is
    [[0001-01-01T00:00:00.000000000, 9999-12-31T23:59:59.999999999]].
    [make_datetimes_printed] also takes the [print] that displays them. *)
let%template make_datetimes_printed
      ~(of_datetime : (date * time -> 'a) MODE(m))
      ~(sexp_of : ('a -> Sexp.t) MODE(m))
      ~(print : ('a -> Printer.doc) MODE(m))
      ?(min_datetime = first_date, first_time)
      ?(max_datetime = last_date, last_time)
      ()
  : ('a, printable) generator MODE(m)
  =
  (leaf [@mode m])
    ~name:"datetimes"
    ~draw:(fun tc ->
      of_datetime
        (Internal.generate_datetime tc ~min_value:min_datetime ~max_value:max_datetime))
    ~sexp_of
    ~print
[@@mode m = (nonportable, portable)]
;;

let%template make_datetimes
      ~(of_datetime : (date * time -> 'a) MODE(m))
      ~(sexp_of : ('a -> Sexp.t) MODE(m))
      ?min_datetime
      ?max_datetime
      ()
  : ('a, printable) generator MODE(m)
  =
  (make_datetimes_printed [@mode m])
    ~of_datetime
    ~sexp_of
    ~print:(fun v -> Printer.of_sexp sexp_of v)
    ?min_datetime
    ?max_datetime
    ()
[@@mode m = (nonportable, portable)]
;;

(** [dates ?min_date ?max_date ()] creates a generator for ISO 8601 [YYYY-MM-DD]
    date strings in [[min_date, max_date]]. The default range is
    [[0001-01-01, 9999-12-31]]. *)
let dates ?min_date ?max_date () : _ MODE(portable) =
  (make_dates_printed [@mode portable])
    ~of_date:format_date
    ~sexp_of:sexp_of_string
    ~print:Printer.string
    ?min_date
    ?max_date
    ()
;;

(** [times ?min_time ?max_time ()] creates a generator for ISO 8601
    [HH:MM:SS.fffffffff] time-of-day strings in [[min_time, max_time]]. The
    default range is [[00:00:00.000000000, 23:59:59.999999999]]. *)
let times ?min_time ?max_time () : _ MODE(portable) =
  (make_times_printed [@mode portable])
    ~of_time:format_time
    ~sexp_of:sexp_of_string
    ~print:Printer.string
    ?min_time
    ?max_time
    ()
;;

(** [datetimes ?min_datetime ?max_datetime ()] creates a generator for naive ISO
    8601 [YYYY-MM-DDTHH:MM:SS.fffffffff] datetime strings in
    [[min_datetime, max_datetime]]. The default range is
    [[0001-01-01T00:00:00.000000000, 9999-12-31T23:59:59.999999999]]. *)
let datetimes ?min_datetime ?max_datetime () : _ MODE(portable) =
  (make_datetimes_printed [@mode portable])
    ~of_datetime:format_datetime
    ~sexp_of:sexp_of_string
    ~print:Printer.string
    ?min_datetime
    ?max_datetime
    ()
;;
