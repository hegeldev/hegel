#ifdef OXCAML
#define MODE(m) @ m
#else
#define MODE(m)
#endif

type 'ctx t (** @canonical Hegel.Concurrency.t *)

type outcome = (exn * Printexc.raw_backtrace) option

type 'ctx dispatch =
  n:int
  -> (f:('ctx MODE(local) -> int -> outcome) MODE(portable)
      -> outcome list MODE(contended))
     MODE(local)

#ifdef OXCAML
type 'ctx pool_runner =
  { run : 'a. f:('ctx dispatch @ local -> 'a) @ local unyielding -> 'a }

val of_pool_runner : 'ctx pool_runner @ local -> 'ctx t @ local @@ portable
val of_dispatch : 'ctx dispatch MODE(local) -> 'ctx t MODE(local) @@ portable
#endif

#ifdef OXCAML
val with_pool : 'ctx t @ local -> f:('ctx dispatch @ local -> 'a) @ local unyielding -> 'a

#else
val with_pool : 'ctx t -> f:('ctx dispatch -> 'a) -> 'a
#endif

val thread_pool : create:((unit -> unit) -> unit -> Thread.t) -> unit t

#ifndef OXCAML
val domain_pool
  :  max_domains:int
  -> create_thread:((unit -> unit) -> unit -> Thread.t)
  -> spawn_domain:((unit -> unit) -> unit Domain.t)
  -> unit t

#endif
val create
  :  spawn_join_n:
       (n:int
        -> (f:('ctx MODE(local) -> int -> outcome) MODE(portable)
            -> outcome list MODE(contended))
           MODE(local))
  -> 'ctx t

val threads : unit t

#ifndef OXCAML
val domains : unit t
#endif
