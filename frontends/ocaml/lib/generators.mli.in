#ifdef OXCAML
@@ portable
#define MODE(m) @ m
#define KIND(k) : k
#else
#define MODE(m)
#define KIND(k)
#endif
(** This module provides a composable generator API for property-based testing.
    Generators produce typed OCaml values.

    All examples in this documentation assume [open Hegel].

    The usual way to build a compound value is to {!Hegel.draw} its parts in
    sequence:

    {[
      type point = { x : int; y : int }

      let%hegel_test points_stay_in_range tc =
        let x = draw tc (integers ~min_value:0 ~max_value:100 ()) in
        let y = draw tc (integers ~min_value:0 ~max_value:100 ()) in
        let p = { x; y } in
        require tc ~msg:"point coordinates stay in range"
          (p.x <= 100 && p.y <= 100)
      ;;
    ]}

    Generator combinators are higher-order functions that take generators and/or
    functions as input and assemble them into a single generator:

    - {!map} transforms every generated value with a function.
    - {!flat_map} builds a {e dependent} generator, where a later generator is
      chosen from an earlier value. For example, draw a length [n], then a list
      of exactly [n] elements.
    - {!filter} keeps only values satisfying a predicate.
    - {!one_of} and {!sampled_from} choose among alternatives.

    Every generator can be drawn with {!Hegel.draw}, which prints the drawn
    value as OCaml syntax on a failing replay (see {!Printer}). *)

(** A generator producing values of type ['a]. *)
type 'a generator
#ifdef OXCAML
  : value mod contended
#endif

(**/**)

(** [draw ?label ?loc tc gen] produces a typed value from the generator [gen]
    using test case [tc].

    On the final replay of a failing test (or on every case under verbose
    output), an outermost draw prints its value as OCaml syntax (see
    {!Printer}) as [name = value] when no location is supplied. The [name] is
    [label] when given, else ["draw"]. An unlabeled draw is numbered
    ([draw_1], [draw_2], …). Draws nested inside a span (e.g. composite
    elements) are suppressed so only the outermost value shows. A value with no
    printer shows as [<abstr>]; attach one with {!with_printer}. To draw
    without printing, use {!draw_silent}. A drawn function ({!functions})
    prints no line of its own; each application of it prints instead.

    [?loc] adds the source filename and line to the printed draw. In OxCaml, the
    compiler automatically supplies the caller's position when omitted. Providing
    [loc] overrides that position. The draw is then printed as
    [name @ filename:line = value].

    Inside a [let%hegel_test], the PPX supplies the binding name as the label, so
    [let x = draw tc gen] prints its value as [x = value]. When the same name is
    shadowed or drawn in a loop, its draws are numbered [x_1], [x_2], … in draw
    order. Pass [?label] to override the name (e.g. [draw ~label:"y" tc gen]).

    {[
      let%hegel_test draw_example tc =
        let n = draw tc (integers ~min_value:0 ~max_value:100 ()) in
        assert (n >= 0)
      ;;
    ]} *)
val draw
  :  ?label:string
#ifdef OXCAML
  -> loc:[%call_pos]
#else
  -> ?loc:Lexing.position
#endif
  -> Internal.test_case
  -> 'a generator
  -> 'a

(** [draw_named ~label ~repeatable tc gen] is the naming-aware draw the
    [let%hegel_test] PPX rewrites bindings to; not intended for direct use
    (prefer {!draw}). It prints [label = value] (bare), or [label_1 = value],
    [label_2 = value], … when [repeatable] is set. The PPX sets [repeatable = true]
    for a binding name that is reused or drawn in a loop. *)
val draw_named
  :  label:string
#ifdef OXCAML
  -> loc:[%call_pos]
#else
  -> ?loc:Lexing.position
#endif
  -> repeatable:bool
  -> Internal.test_case
  -> 'a generator
  -> 'a

(** [draw_silent tc gen] produces a typed value from a generator without
    recording it for the final-replay output. Use it for draws whose value is
    not a useful part of the printed counterexample.

    {[
      let%hegel_test draw_silent_example tc =
        let n =
          draw_silent
            tc
            (map (fun x -> x * 2) (integers ~min_value:0 ~max_value:9 ()))
        in
        assert (n >= 0)
      ;;
    ]} *)
val draw_silent : Internal.test_case -> 'a generator -> 'a

(** [draw_silent_named ~name tc gen] is {!draw_silent} threading the draw-site
    [name] into a function generator ({!functions}). Not intended for
    direct use (prefer {!draw_silent}). *)
val draw_silent_named : name:string -> Internal.test_case -> 'a generator -> 'a

(** [with_printer print gen] displays [gen]'s drawn values with [print],
    replacing the display [gen] had. This is how a [map]/[sampled_from]/
    [just]/[composite] result, whose values otherwise show as [<abstr>], prints
    its values.

    {[
      let%hegel_test with_printer_example tc =
        let doubled =
          map (fun x -> x * 2) (integers ~min_value:0 ~max_value:9 ())
        in
        let n = draw tc (with_printer Printer.int doubled) in
        assert (n >= 0)
      ;;
    ]} *)
val%template with_printer
  :  ('a -> Printer.doc) MODE(m)
  -> 'a generator MODE(m)
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [leaf ~name ~draw ~print] builds a generator from a single typed engine
    draw, labeled from [name], whose values [print] displays. Not part of the
    public API. *)
val%template leaf
  :  name:string
  -> draw:(Internal.test_case -> 'a) MODE(m)
  -> print:('a -> Printer.doc) MODE(m)
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(**/**)

(**/**)

(** The generator constructors. {!Hegel} re-exports them unqualified. *)
module Public : sig
(** {2 Primitive generators} *)

(** [booleans ?p ()] creates a generator for boolean values, [true] with
    probability [p] (default [0.5]). [p] must be between 0 and 1.

    {[
      let%hegel_test booleans_example tc =
        let b = draw tc (booleans ~p:0.9 ()) in
        assert (b = true || b = false)
      ;;
    ]} *)
val booleans : ?p:float -> unit -> bool generator MODE(portable)

(** [integers ?min_value ?max_value ()] creates a generator for integers within
    the given bounds.

    Defaults:
    - [min_value]: OCaml native int min
    - [max_value]: OCaml native int max

    {[
      let%hegel_test integers_example tc =
        let n = draw tc (integers ~min_value:1 ~max_value:6 ()) in
        assert (n >= 1 && n <= 6)
      ;;
    ]} *)
val integers : ?min_value:int -> ?max_value:int -> unit -> int generator MODE(portable)

(** [floats ?width ?min_value ?max_value ?exclude_min ?exclude_max ?allow_nan
     ?allow_infinity ()] creates a generator for floating-point values.

    With [~width:`W32], every drawn value is exactly representable as a 32-bit
    float ([Int32.float_of_bits (Int32.bits_of_float f) = f] for finite [f]),
    and the bounds must be too, or the draw raises [Usage_error].

    Defaults:
    - [width]: [`W64]
    - [min_value] / [max_value]: unbounded. With [allow_infinity = false] the
      range is [[-max_float, max_float]].
    - [exclude_min]: [false]
    - [exclude_max]: [false]
    - [allow_nan]: [true] only when no bounds are set
    - [allow_infinity]: [true] when at most one bound is set

    Bounds that only allow infinity to be generated while [allow_infinity] is [false], 
    such as [~min_value:infinity], raise [Usage_error].

    {[
      let%hegel_test floats_example tc =
        let f = draw tc (floats ~min_value:0.0 ~max_value:1.0 ()) in
        assert (Float.compare f 0.0 >= 0)
      ;;
    ]} *)
val floats
  :  ?width:[ `W32 | `W64 ]
  -> ?min_value:float
  -> ?max_value:float
  -> ?exclude_min:bool
  -> ?exclude_max:bool
  -> ?allow_nan:bool
  -> ?allow_infinity:bool
  -> unit
  -> float generator MODE(portable)

(** [text ?min_size ?max_size ?codec ?min_codepoint ?max_codepoint ?categories
     ?exclude_categories ?include_characters ?exclude_characters ?alphabet ()]
    creates a generator for Unicode text strings.

    A string has between [min_size] (default 0) and [max_size] characters.
    Without [max_size], the engine picks the maximum: 100, or [min_size + 100]
    when [min_size] is above 100.

    Character filtering options restrict which characters may appear:
    - [codec]: restrict to characters encodable in this codec (e.g. ["ascii"],
      ["utf-8"], ["latin-1"])
    - [min_codepoint], [max_codepoint]: restrict Unicode codepoint range
    - [categories]: whitelist of Unicode general categories (e.g.
      [["L"; "Nd"]]). Mutually exclusive with [exclude_categories].
    - [exclude_categories]: blacklist of Unicode general categories. Mutually
      exclusive with [categories].
    - [include_characters]: add these characters even if the codepoint range or
      categories exclude them. Each must be encodable in [codec] and must not
      also appear in [exclude_characters], or the draw raises [Usage_error].
    - [exclude_characters]: always exclude these characters
    - [alphabet]: fixed set of allowed characters. Mutually exclusive with all
      individual character filtering parameters.

    Surrogate codepoints (category Cs) are always excluded, so the drawn strings
    are valid UTF-8. Constraints that leave no characters raise [Usage_error]
    when drawn.

    {[
      let%hegel_test text_example tc =
        let s = draw tc (text ~min_size:1 ~max_size:8 ~codec:"ascii" ()) in
        assert (String.length s >= 1)
      ;;
    ]} *)
val text
  :  ?min_size:int
  -> ?max_size:int
  -> ?codec:string
  -> ?min_codepoint:int
  -> ?max_codepoint:int
  -> ?categories:string list
  -> ?exclude_categories:string list
  -> ?include_characters:string
  -> ?exclude_characters:string
  -> ?alphabet:string
  -> unit
  -> string generator MODE(portable)

(** [characters ?codec ?min_codepoint ?max_codepoint ?categories
     ?exclude_categories ?include_characters ?exclude_characters ()] creates a
    generator for single Unicode characters (as single-character UTF-8 strings).

    Accepts the same character filtering options as {!text} except [min_size],
    [max_size], and [alphabet]. Surrogate codepoints (category Cs) are always
    excluded, so the drawn strings are valid UTF-8.

    {[
      let%hegel_test characters_example tc =
        let c = draw tc (characters ~codec:"ascii" ()) in
        assert (String.length c >= 1)
      ;;
    ]} *)
val characters
  :  ?codec:string
  -> ?min_codepoint:int
  -> ?max_codepoint:int
  -> ?categories:string list
  -> ?exclude_categories:string list
  -> ?include_characters:string
  -> ?exclude_characters:string
  -> unit
  -> string generator MODE(portable)

(** [make_characters ~of_char ~print ()] builds a generator for single
    characters over any representation ['a], covering the full native [char]
    range (codepoints 0-255, i.e. Latin-1), displayed with [print]. *)
val%template make_characters
  :  of_char:(char -> 'a) MODE(m)
  -> print:('a -> Printer.doc) MODE(m)
  -> unit
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [chars ()] creates a generator for single characters (codepoints 0-255,
    i.e. Latin-1) as native [char] values.

    {[
      let%hegel_test chars_example tc =
        let c = draw tc (chars ()) in
        assert (Char.code c >= 0 && Char.code c <= 0xFF)
      ;;
    ]} *)
val chars : unit -> char generator MODE(portable)

(** [binary ?min_size ?max_size ()] creates a generator for binary byte strings.
    A string has between [min_size] (default 0) and [max_size] bytes. Without
    [max_size], the engine picks the maximum: 100, or [min_size + 100] when
    [min_size] is above 100.

    {[
      let%hegel_test binary_example tc =
        let bytes = draw tc (binary ~min_size:0 ~max_size:16 ()) in
        assert (String.length bytes <= 16)
      ;;
    ]} *)
val binary : ?min_size:int -> ?max_size:int -> unit -> string generator MODE(portable)

(** [just value] creates a generator that always produces [value]. The output
    type is the caller's, so the result carries no printer.

    {[
      let%hegel_test just_example tc =
        let x = draw_silent tc (just 42) in
        assert (x = 42)
      ;;
    ]} *)
val%template just : ('a KIND(value mod c)) MODE(m) -> 'a generator MODE(m)
[@@mode (m, c) = ((nonportable, uncontended), (portable, contended))]

(** {2 Collection generators} *)

(** [lists elements ?min_size ?max_size ?unique ?unique_by ()] creates a
    generator for lists of [elements]. When [unique] is [true], elements will
    be distinct. When [unique_by] is given, their [unique_by] keys will be
    distinct. Both compare structurally, and giving both raises
    [Usage_error].

    {[
      let%hegel_test lists_example tc =
        let xs =
          draw tc (lists (integers ~min_value:0 ~max_value:9 ()) ~max_size:10 ())
        in
        assert (List.length xs <= 10)
      ;;

      let%hegel_test unique_by_example tc =
        let pairs =
          draw
            tc
            (lists
               (tuples2 (integers ~min_value:0 ~max_value:9 ()) (booleans ()))
               ~unique_by:fst
               ())
        in
        let keys = List.map fst pairs in
        assert (List.length (List.sort_uniq compare keys) = List.length keys)
      ;;
    ]} *)
val%template lists
  :  'a generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> ?unique:bool
  -> ?unique_by:('a -> 'k) MODE(m)
  -> unit
  -> 'a list generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [arrays elements ?min_size ?max_size ()] creates a generator for arrays
    of [elements]. A drawn array shows as [\[|1; 2|\]].

    {[
      let%hegel_test arrays_example tc =
        let a = draw tc (arrays (integers ()) ~min_size:1 ~max_size:4 ()) in
        assert (Array.length a >= 1 && Array.length a <= 4)
      ;;
    ]} *)
val%template arrays
  :  'a generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> 'a array generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [sets (module S) elements ?min_size ?max_size ()] creates a generator for
    sets of [elements] of the set module [S]. An element already in the set
    (by [S.mem]) is redrawn, so a set of [n] elements needs [n] distinct
    elements. A drawn set shows as [Set.of_list \[1; 2\]], its elements in
    the order they were drawn.

    {[
      module Int_set = Set.Make (Int)

      let%hegel_test sets_example tc =
        let s =
          draw tc (sets (module Int_set) (integers ~min_value:0 ~max_value:9 ()) ~min_size:3 ())
        in
        assert (Int_set.cardinal s >= 3)
      ;;
    ]} *)
val sets
  :  (module Set.S with type elt = 'a and type t = 't)
  -> 'a generator
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> 't generator

(** [assoc_lists keys values ?min_size ?max_size ()] creates a
    generator for association lists over [keys] and [values]:
    [(key, value)] pairs, in generation order, whose keys are unique.

    {[
      let%hegel_test assoc_lists_example tc =
        let m =
          draw tc
            (assoc_lists
               (text ~max_size:4 ())
               (integers ~min_value:0 ~max_value:9 ())
               ~max_size:5
               ())
        in
        assert (List.length m <= 5)
      ;;
    ]} *)
val%template assoc_lists
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> ('a * 'b) list generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [make_hash_tables ~of_pairs ~print_of_pairs keys values ?min_size ?max_size ()]
    builds a hash-table generator over any table type ['t]: [of_pairs] builds
    the table from the drawn association list, and [print_of_pairs] turns the
    display of that list (as [\[(k1, v1); …\]]) into the display of the
    table, typically an application of the function that builds it. *)
val%template make_hash_tables
  :  of_pairs:(('a * 'b) list -> 't) MODE(m)
  -> print_of_pairs:(Printer.doc -> Printer.doc) MODE(m)
  -> 'a generator MODE(m)
  -> 'b generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> 't generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [hash_tables keys values ?min_size ?max_size ()] creates a generator for
    [Stdlib.Hashtbl.t] tables over [keys] and [values]. A drawn table shows as
    [Hashtbl.of_seq (List.to_seq \[(k1, v1); …\])].

    {[
      let%hegel_test hash_tables_example tc =
        let m =
          draw tc
            (hash_tables
               (text ~max_size:4 ())
               (integers ~min_value:0 ~max_value:9 ())
               ~max_size:5
               ())
        in
        assert (Hashtbl.length m <= 5)
      ;;
    ]} *)
val%template hash_tables
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> ('a, 'b) Stdlib.Hashtbl.t generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [sampled_from options] creates a generator that samples from a non-empty
    list of values. The values are the caller's, so a drawn one shows as
    [<abstr>] unless a printer is attached with {!with_printer}.

    {[
      let%hegel_test sampled_from_example tc =
        let color = draw_silent tc (sampled_from [ `Red; `Green; `Blue ]) in
        ignore color
      ;;
    ]} *)
val%template sampled_from
  : ('a KIND(value mod c)) list MODE(m) -> 'a generator MODE(m)
[@@mode (m, c) = ((nonportable, uncontended), (portable, contended))]

(** [one_of generators] creates a generator that picks from one of the given
    [generators]. Raises [Usage_error] if [generators] is empty. A drawn value
    prints as the branch it was drawn from prints it.

    {[
      let%hegel_test one_of_example tc =
        let n =
          draw tc
            (one_of
               [ integers ~min_value:0 ~max_value:9 ()
               ; integers ~min_value:90 ~max_value:99 ()
               ])
        in
        assert (n >= 0)
      ;;
    ]} *)
val%template one_of : 'a generator list MODE(m) -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [optional gen] creates a generator that produces either [None] or
    [Some value] from [gen].

    {[
      let%hegel_test optional_example tc =
        let o = draw tc (optional (integers ~min_value:0 ~max_value:9 ())) in
        match o with
        | None -> ()
        | Some n -> assert (n >= 0)
      ;;
    ]} *)
val%template optional
  :  'a generator MODE(m)
  -> 'a option generator MODE(m)
[@@mode m = (nonportable, portable)]

(** {2 Tuple generators} *)

(** [tuples2 g1 g2] creates a generator for 2-element tuples.

    {[
      let%hegel_test tuples2_example tc =
        let n, b =
          draw tc
            (tuples2 (integers ~min_value:0 ~max_value:9 ()) (booleans ()))
        in
        assert (n >= 0 && (b || not b))
      ;;
    ]} *)
val%template tuples2
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> ('a * 'b) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples3 g1 g2 g3] creates a generator for 3-element tuples.

    {[
      let%hegel_test tuples3_example tc =
        let a, b, c =
          draw tc
            (tuples3
               (integers ~min_value:0 ~max_value:9 ())
               (booleans ())
               (text ~max_size:4 ()))
        in
        assert (a >= 0 && (b || not b) && String.length c >= 0)
      ;;
    ]} *)
val%template tuples3
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> 'c generator MODE(m)
  -> ('a * 'b * 'c) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples4 g1 g2 g3 g4] creates a generator for 4-element tuples.

    {[
      let%hegel_test tuples4_example tc =
        let a, b, c, d =
          draw tc
            (tuples4
               (integers ~min_value:0 ~max_value:9 ())
               (booleans ())
               (text ~max_size:4 ())
               (floats ~min_value:0.0 ~max_value:1.0 ()))
        in
        assert (a >= 0 && (b || not b) && String.length c >= 0 && Float.compare d 0.0 >= 0)
      ;;
    ]} *)
val%template tuples4
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> 'c generator MODE(m)
  -> 'd generator MODE(m)
  -> ('a * 'b * 'c * 'd) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples5 g1 g2 g3 g4 g5] creates a generator for 5-element tuples. *)
val%template tuples5
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> 'c generator MODE(m)
  -> 'd generator MODE(m)
  -> 'e generator MODE(m)
  -> ('a * 'b * 'c * 'd * 'e) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples6 g1 g2 g3 g4 g5 g6] creates a generator for 6-element tuples. *)
val%template tuples6
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> 'c generator MODE(m)
  -> 'd generator MODE(m)
  -> 'e generator MODE(m)
  -> 'f generator MODE(m)
  -> ('a * 'b * 'c * 'd * 'e * 'f) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples7 g1 g2 g3 g4 g5 g6 g7] creates a generator for 7-element tuples. *)
val%template tuples7
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> 'c generator MODE(m)
  -> 'd generator MODE(m)
  -> 'e generator MODE(m)
  -> 'f generator MODE(m)
  -> 'g generator MODE(m)
  -> ('a * 'b * 'c * 'd * 'e * 'f * 'g) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples8 g1 g2 g3 g4 g5 g6 g7 g8] creates a generator for 8-element tuples. *)
val%template tuples8
  :  'a generator MODE(m)
  -> 'b generator MODE(m)
  -> 'c generator MODE(m)
  -> 'd generator MODE(m)
  -> 'e generator MODE(m)
  -> 'f generator MODE(m)
  -> 'g generator MODE(m)
  -> 'h generator MODE(m)
  -> ('a * 'b * 'c * 'd * 'e * 'f * 'g * 'h) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [permutations values] creates a generator for permutations of [values],
    shrinking toward [values] in its original order. The values are the
    caller's, so a drawn permutation shows as [<abstr>] unless a printer is
    attached with {!with_printer}.

    {[
      let%hegel_test permutations_example tc =
        let xs = draw_silent tc (permutations [ 1; 2; 3; 4 ]) in
        assert (List.sort compare xs = [ 1; 2; 3; 4 ])
      ;;
    ]} *)
val%template permutations
  : ('a KIND(value mod c)) list MODE(m) -> 'a list generator MODE(m)
[@@mode (m, c) = ((nonportable, uncontended), (portable, contended))]

(** {2 Function generators} *)

(** [functions ?name ?print_arg ~returns ()] creates a generator for functions
    ['a -> 'b] whose results are drawn from [returns].

    Applying the drawn function to an argument draws a result from [returns]
    the first time that argument is seen and memoizes it.

    On the failing final replay each top-level application prints as
    [name arg = result] (applications nested inside a span are suppressed); the
    draw of the function itself prints nothing. [name] is [?name] when you pass
    it. Otherwise, the draw-site binding name inside a [let%hegel_test], else
    ["function"].

    The memo table keys on the argument itself (structural hash/equality), so
    distinct arguments always get independent results. [print_arg] only
    displays the argument in the printed application. An omitted [print_arg]
    shows [<abstr>].

    {[
      let%hegel_test map_length_preserved tc =
        let f = draw tc (functions ~print_arg:Printer.int ~returns:(integers ()) ()) in
        let xs = draw tc (lists (integers ()) ()) in
        assert (List.length (List.map f xs) = List.length xs)
      ;;
    ]} *)
val%template functions
  :  ?name:string
  -> ?print_arg:('a -> Printer.doc) MODE(m)
  -> returns:'b generator MODE(m)
  -> unit
  -> ('a -> 'b) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [functions2 ?name ?print_arg1 ?print_arg2 ~returns ()] creates a
    generator for curried two-argument functions ['a -> 'b -> 'c].

    Sugar over {!functions} keyed on the argument pair: the two arguments form
    one memo key, and an application prints as [name arg1 arg2 = result]. *)
val%template functions2
  :  ?name:string
  -> ?print_arg1:('a -> Printer.doc) MODE(m)
  -> ?print_arg2:('b -> Printer.doc) MODE(m)
  -> returns:'c generator MODE(m)
  -> unit
  -> ('a -> 'b -> 'c) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [functions3 ?name ?print_arg1 ?print_arg2 ?print_arg3 ~returns ()]
    creates a generator for curried three-argument functions
    ['a -> 'b -> 'c -> 'd].

    Like {!functions2}, keyed on the argument triple, and an application
    prints as [name arg1 arg2 arg3 = result]. *)
val%template functions3
  :  ?name:string
  -> ?print_arg1:('a -> Printer.doc) MODE(m)
  -> ?print_arg2:('b -> Printer.doc) MODE(m)
  -> ?print_arg3:('c -> Printer.doc) MODE(m)
  -> returns:'d generator MODE(m)
  -> unit
  -> ('a -> 'b -> 'c -> 'd) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** {2 Format generators} *)

(** [emails ()] creates a generator for valid email address strings.

    Addresses follow RFC 5321/5322: a local part of 1 to 64 characters from the
    RFC 5322 [atext] set, an [@], and a domain from {!domains}, with the overall
    address length capped at 254 octets (RFC 5321 §4.5.3.1.3).

    {[
      let%hegel_test emails_example tc =
        let e = draw tc (emails ()) in
        assert (String.contains e '@')
      ;;
    ]} *)
val emails : unit -> string generator MODE(portable)

(** [urls ()] creates a generator for valid URL strings.

    URLs follow RFC 3986, of the form
    [scheme://domain\[:port\]/path\[#fragment\]] with [scheme] one of
    [http]/[https], the domain drawn from {!domains} (up to 255 characters), an
    optional port in [1, 65535], zero or more [/]-separated path segments of up
    to 100 characters each, and an optional fragment of up to 100 characters.
    Path and fragment characters are percent-encoded.

    {[
      let%hegel_test urls_example tc =
        let u = draw tc (urls ()) in
        assert (String.length u > 0)
      ;;
    ]} *)
val urls : unit -> string generator MODE(portable)

(** [domains ?max_length ()] creates a generator for domain name strings.

    Domains are RFC 1035 fully-qualified domain names: a top-level domain
    sampled from the IANA TLD list followed by up to 126 dot-separated labels,
    each 1 to 63 characters matching
    [\[a-zA-Z\](\[a-zA-Z0-9-\]{0,61}\[a-zA-Z0-9\])?] (punycode [xn--] labels
    reserved by RFC 5890 are excluded). Generated domains never exceed
    [max_length] (default 255, per RFC 1035 §2.3.4); when provided, [max_length]
    must be in [4, 255].

    {[
      let%hegel_test domains_example tc =
        let d = draw tc (domains ~max_length:64 ()) in
        assert (String.length d <= 64)
      ;;
    ]} *)
val domains : ?max_length:int -> unit -> string generator MODE(portable)

(** A proleptic Gregorian calendar date. [year] is in [\[-999999, 999999\]],
    [month] in [\[1, 12\]], and [day] in [\[1, days-in-month\]]. *)
type date =
  { year : int
  ; month : int
  ; day : int
  }

(** A time of day at nanosecond resolution. [hour] is in [\[0, 23\]],
    [minute] and [second] in [\[0, 59\]], and [nanosecond] in [\[0, 999999999\]]. *)
type time =
  { hour : int
  ; minute : int
  ; second : int
  ; nanosecond : int
  }

(** [make_dates ~of_date ~print ?min_date ?max_date ()] builds a generator
    for dates in [\[min_date, max_date\]] over any representation. [of_date]
    converts each drawn {!date} to the desired representation. The default
    range is [\[0001-01-01, 9999-12-31\]].

    {[
      let core_dates =
        make_dates
          ~of_date:(fun { year; month; day } ->
            Core.Date.create_exn ~y:year ~m:(Core.Month.of_int_exn month) ~d:day)
          ~print:(Printer.of_sexp Core.Date.sexp_of_t)
          ()
    ]} *)
val%template make_dates
  :  of_date:(date -> 'a) MODE(m)
  -> print:('a -> Printer.doc) MODE(m)
  -> ?min_date:date
  -> ?max_date:date
  -> unit
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [make_times ~of_time ~print ?min_time ?max_time ()] builds a generator
    for times of day in [\[min_time, max_time\]] over any representation.
    [of_time] converts each drawn {!time} to the desired representation. The
    default range is [\[00:00:00.000000000, 23:59:59.999999999\]]. *)
val%template make_times
  :  of_time:(time -> 'a) MODE(m)
  -> print:('a -> Printer.doc) MODE(m)
  -> ?min_time:time
  -> ?max_time:time
  -> unit
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [make_datetimes ~of_datetime ~print ?min_datetime ?max_datetime ()] builds a
    generator for naive datetimes in [\[min_datetime, max_datetime\]] over any
    representation. [of_datetime] converts each drawn [(date, time)] pair to the
    desired representation. The default range is [\[0001-01-01T00:00:00.000000000, 9999-12-31T23:59:59.999999999\]]. *)
val%template make_datetimes
  :  of_datetime:(date * time -> 'a) MODE(m)
  -> print:('a -> Printer.doc) MODE(m)
  -> ?min_datetime:date * time
  -> ?max_datetime:date * time
  -> unit
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [dates ?min_date ?max_date ()] creates a generator for ISO 8601
    [YYYY-MM-DD] date strings in [\[min_date, max_date\]]. The default range is
    [\[0001-01-01, 9999-12-31\]].

    {[
      let%hegel_test dates_example tc =
        let d = draw tc (dates ()) in
        assert (String.length d = 10)
      ;;
    ]} *)
val dates : ?min_date:date -> ?max_date:date -> unit -> string generator MODE(portable)

(** [times ?min_time ?max_time ()] creates a generator for ISO 8601
    [HH:MM:SS.fffffffff] time-of-day strings in [\[min_time, max_time\]]. The
    default range is [\[00:00:00.000000000, 23:59:59.999999999\]].

    {[
      let%hegel_test times_example tc =
        let t =
          draw tc (times ~min_time:{ hour = 9; minute = 0; second = 0; nanosecond = 0 } ())
        in
        assert (String.length t = 18 && String.compare t "09:00:00.000000000" >= 0)
      ;;
    ]} *)
val times : ?min_time:time -> ?max_time:time -> unit -> string generator MODE(portable)

(** [datetimes ?min_datetime ?max_datetime ()] creates a generator for naive
    ISO 8601 [YYYY-MM-DDTHH:MM:SS.fffffffff] datetime strings in
    [\[min_datetime, max_datetime\]]. The default range is
    [\[0001-01-01T00:00:00.000000000, 9999-12-31T23:59:59.999999999\]].

    {[
      let%hegel_test datetimes_example tc =
        let dt = draw tc (datetimes ()) in
        assert (String.contains dt 'T')
      ;;
    ]} *)
val datetimes
  :  ?min_datetime:date * time
  -> ?max_datetime:date * time
  -> unit
  -> string generator MODE(portable)

(** [ip_addresses ?version ()] creates a generator for typed [Ipaddr.t] IP
    addresses. [version] selects IPv4 ([`V4], RFC 791) or IPv6 ([`V6],
    RFC 4291); when omitted, either version is generated. Render a drawn
    address with [Ipaddr.to_string] (RFC 5952 canonical form for v6).

    {[
      let%hegel_test ip_addresses_example tc =
        match draw tc (ip_addresses ~version:`V4 ()) with
        | Ipaddr.V4 _ as ip -> assert (String.contains (Ipaddr.to_string ip) '.')
        | Ipaddr.V6 _ -> assert false
      ;;
    ]} *)
val ip_addresses : ?version:[ `V4 | `V6 ] -> unit -> Ipaddr.t generator MODE(portable)

(** [from_regex pattern ?fullmatch ?codec ?min_codepoint ?max_codepoint
     ?categories ?exclude_categories ?include_characters ?exclude_characters
     ?alphabet ()] creates a generator for strings matching a regular
    expression [pattern], written in the syntax of Python's [re] module. When
    [fullmatch] is [true] (the default) the whole string must match [pattern];
    otherwise a match anywhere suffices. A pattern that does not parse, or that
    no string matches, raises [Usage_error] when drawn.

    The character filtering options restrict every character of the drawn
    string, including the characters [.], [\\w] and the like match and, when
    [fullmatch] is [false], the text around the match. They mean what they mean
    for {!text}.

    {[
      let%hegel_test from_regex_example tc =
        let s = draw tc (from_regex "[a-z]+" ()) in
        assert (String.length s >= 1)
      ;;

      let%hegel_test from_regex_alphabet_example tc =
        let s = draw tc (from_regex ~fullmatch:false ~alphabet:"abc" "b" ()) in
        assert (String.for_all (fun c -> c = 'a' || c = 'b' || c = 'c') s)
      ;;
    ]} *)
val from_regex
  :  string
  -> ?fullmatch:bool
  -> ?codec:string
  -> ?min_codepoint:int
  -> ?max_codepoint:int
  -> ?categories:string list
  -> ?exclude_categories:string list
  -> ?include_characters:string
  -> ?exclude_characters:string
  -> ?alphabet:string
  -> unit
  -> string generator MODE(portable)

(** [from_lark grammar ?start ?explicit ?max_size ?max_depth ?import_path
     ?codec ?min_codepoint ?max_codepoint ?categories ?exclude_categories
     ?include_characters ?exclude_characters ?alphabet ()] creates a generator
    for strings of a grammar written in the syntax of the
    {{:https://lark-parser.readthedocs.io/en/stable/grammar.html} Lark}
    parsing library, starting from its [start] rule, or the rule named
    [start] when given.

    The whole grammar language is supported: rules, terminals with string and
    regex patterns and priorities, [%import] (including Lark's bundled
    [common], [python], [unicode] and [lark] grammars), [%ignore],
    [%declare], [%override], [%extend] and templates. Generated strings are
    ones Lark's Earley parser accepts for the grammar, with [%ignore]d
    terminals such as whitespace and comments inserted wherever a lexer
    would skip them. A draw that cannot produce such a string after several
    attempts rejects the test case, as [assume false] does.

    - [explicit]: pairs of a terminal's name and a generator its values are
      drawn from instead of from the terminal's pattern. Every terminal the
      grammar [%declare]s must be given one, and any other terminal may be.
      The values must be UTF-8, and it is the generator's part to draw values
      that read as the terminal where they land (a value under a
      quoted-string terminal should contain no quote, say).
    - [max_size]: the most characters a string may have, explicit values
      included: 8192 by default, at most 1048576.
    - [max_depth]: how deeply rules may nest: 200 by default, at most 500.
    - [import_path]: the directory [%import]ed grammars are read from.
      [%import a.b.X] reads [a/b.lark] from it, and Lark's bundled grammars
      stand in when it has no such file.
    - The character filtering options restrict every character the
      terminals' patterns draw, as they do for {!text}.

    A grammar Lark would reject, an undefined start rule, a [max_size] below
    the grammar's smallest string, or an [explicit] generator for a terminal
    the grammar does not use raises [Usage_error] when drawn.

    {[
      let grammar =
        {|
          ?start: sum
          ?sum: product | sum "+" product
          ?product: atom | product "*" atom
          ?atom: NUMBER | "(" sum ")"
          %import common.NUMBER
        |}

      let%hegel_test from_lark_example tc =
        let expression = draw tc (from_lark grammar ()) in
        assert (String.length expression >= 1)
      ;;
    ]} *)
val%template from_lark
  :  string
  -> ?start:string
  -> ?explicit:(string * string generator) list MODE(m)
  -> ?max_size:int
  -> ?max_depth:int
  -> ?import_path:string
  -> ?codec:string
  -> ?min_codepoint:int
  -> ?max_codepoint:int
  -> ?categories:string list
  -> ?exclude_categories:string list
  -> ?include_characters:string
  -> ?exclude_characters:string
  -> ?alphabet:string
  -> unit
  -> string generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [uuids ?version ()] creates a generator for UUIDs as lowercase hyphenated
    strings, such as ["0f8fad5b-d9cb-469f-a165-70867728950e"]. With [version]
    (1 to 5) the UUID has that RFC 4122 version and the RFC 4122 variant.
    The nil UUID is never generated.

    {[
      let%hegel_test uuids_example tc =
        let u = draw tc (uuids ~version:4 ()) in
        assert (u.[14] = '4')
      ;;
    ]} *)
val uuids : ?version:int -> unit -> string generator MODE(portable)

(** {2 Generator combinators} *)

(** [composite generate_fn] builds a generator from an imperative [generate_fn]
    that draws sub-values from the test case and assembles a result, useful when
    a value is easiest to describe by drawing its parts in sequence. The
    result is the caller's, so a drawn value shows as [<abstr>] unless a
    printer is attached with {!with_printer}.

    {[
      let point =
        composite (fun tc ->
          let x = draw_silent tc (integers ~min_value:0 ~max_value:9 ()) in
          let y = draw_silent tc (integers ~min_value:0 ~max_value:9 ()) in
          x, y)
        |> with_printer (Printer.pair Printer.int Printer.int)
      ;;
    ]} *)
val%template composite : (Internal.test_case -> 'a) MODE(m) -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [map f gen] transforms values from [gen] using [f]. The output type is
    the caller's, so a drawn value shows as [<abstr>] unless a printer is
    attached with {!with_printer}.

    {[
      let%hegel_test map_example tc =
        let even =
          draw tc
            (map (fun x -> x * 2) (integers ~min_value:0 ~max_value:9 ())
             |> with_printer Printer.int)
        in
        assert (even mod 2 = 0)
      ;;
    ]} *)
val%template map
  :  ('a -> 'b) MODE(m)
  -> 'a generator MODE(m)
  -> 'b generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [flat_map f gen] creates a dependent generator. [f] receives the generated
    value and returns a generator whose value is the final result, and which
    prints it.

    {[
      let%hegel_test flat_map_example tc =
        let len_gen = integers ~min_value:0 ~max_value:5 () in
        let xs =
          draw tc
            (flat_map
               (fun n ->
                  lists
                    (integers ~min_value:0 ~max_value:9 ())
                    ~min_size:n
                    ~max_size:n
                    ())
               len_gen)
        in
        assert (List.length xs <= 5)
      ;;
    ]} *)
val%template flat_map
  :  ('a -> 'b generator) MODE(m)
  -> 'a generator MODE(m)
  -> 'b generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [filter predicate gen] filters values from [gen] using [predicate], keeping
    [gen]'s printer. Tries up to three times and rejects the test case if all
    attempts fail.

    {[
      let%hegel_test filter_example tc =
        let even =
          draw tc (filter (fun x -> x mod 2 = 0) (integers ~min_value:0 ~max_value:100 ()))
        in
        assert (even mod 2 = 0)
      ;;
    ]} *)
val%template filter
  :  ('a -> bool) MODE(m)
  -> 'a generator MODE(m)
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** {2 Recursive generators} *)

(** [recursive ?max_depth ?max_leaves leaf branch] generates recursively
    structured values, such as trees or JSON documents. [leaf] generates the
    base cases. [branch] builds one level of structure: it receives the
    generator of sub-values, each itself a leaf or a further branch, and
    returns a generator combining some number of them into one value.

    The engine decides where a value branches and where it bottoms out in a
    leaf. Branches nest at most [max_depth] deep (default 32; sub-values at
    that depth are always leaves, so [~max_depth:0] generates only leaves),
    and a value holds at most [max_leaves] leaves (default 100): an attempt
    that draws more is discarded and retried smaller. Values shrink toward a
    single leaf. A drawn value prints as its leaves and branches print.

    {[
      type tree =
        | Leaf of int
        | Node of tree list

      let trees =
        recursive
          (map (fun n -> Leaf n) (integers ()))
          (fun subtrees -> map (fun children -> Node children) (lists subtrees ()))
      ;;
    ]}

    A negative [max_depth], or a [max_leaves] below 1, raises
    {!Hegel.Usage_error}. For mutually recursive definitions, use
    {!deferred}. *)
val%template recursive
  :  ?max_depth:int
  -> ?max_leaves:int
  -> 'a generator MODE(m)
  -> ('a generator MODE(m) -> 'a generator MODE(m)) MODE(m)
  -> 'a generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [deferred ()] is a generator that is defined later, and the function that
    defines it: a forward reference, so generators can refer to each other, or
    to themselves, before they exist.

    {[
      type expr =
        | Num of int
        | Neg of expr
        | Sum of expr list

      let exprs =
        let exprs, define_exprs = deferred () in
        let terms = one_of [ map (fun n -> Num n) (integers ()); map (fun e -> Neg e) exprs ] in
        define_exprs (one_of [ terms; map (fun es -> Sum es) (lists terms ~max_size:3 ()) ]);
        exprs
      ;;
    ]}

    Drawing from the generator before it is defined raises
    {!Hegel.Usage_error}, as does defining it twice, or defining it as itself
    (possibly through {!map}, {!filter} or {!with_printer}, which would recurse
    without drawing anything). Prefer {!recursive} where it fits: it lets the
    engine bound the size of the value. *)
val deferred : unit -> 'a generator * ('a generator -> unit)
end

(**/**)

include module type of struct
  include Public
end

(**/**)
(*
    The engine-pool generator ([Stateful.Pool]) resolves engine-drawn variable
    ids against the client-side pool.
*)

module Int_table : Stdlib.Hashtbl.S with type key = int

(** [resolve_draw values ~consume id] resolves a drawn pool id against a client
    table, removing it when [consume]. *)
val resolve_draw : 'a Int_table.t -> consume:bool -> int -> 'a

(** [Int_pool] is the client side of an engine pool for a sequential machine:
    drawn ids resolved against an [Int_table] of values, with no lock. Its
    element type is unconstrained. *)
module Int_pool : sig
  type 'a t

  val create : Internal.test_case -> clone:('a -> 'a) -> 'a t
  val add : 'a t -> Internal.test_case -> 'a -> unit
  val size : _ t -> int

  (** Reusable draws apply the pool's clone function. Consumed draws return
      the stored value directly. *)
  val pool_values : 'a t -> consume:bool -> 'a generator
end

(** [Int_pool_concurrent] is the same client side for a machine whose workers
    share the pool. *)
module%template Int_pool_concurrent : sig
#ifdef OXCAML
  type ('a : value mod m c) t : value mod m c
#else
  type 'a t
#endif

#ifdef OXCAML
  val create : Internal.test_case -> clone:('a -> 'a) @ m -> 'a t
#else
  val create : Internal.test_case -> clone:('a -> 'a) -> 'a t
#endif

  val add : 'a t -> Internal.test_case -> 'a -> unit
  val size : _ t -> int

  (** Reusable draws use the pool's clone function under its lock, if present.
      Consumed draws return the stored value directly. *)
  val pool_values : 'a t -> consume:bool -> 'a generator
end
[@@mode (m, c) = ((portable, contended), (nonportable, uncontended))]

(** Implementation helpers for library modules and white-box tests. Not for
    direct use — no stability guarantees. *)
module Private : sig
  (** Span labels: opaque values identifying a generator to the engine, which
      treats two spans with the same label as coming from the same generator,
      and so as candidates for swapping, duplicating, and reordering during
      shrinking and mutation. *)
  module Labels : sig
    (** [from_name name] is the label of a generator named [name] (computed by
        [hegel_label_from_name]). *)
    val from_name : string -> Internal.Label.t

    (** [combine labels] is the label of a generator built from others: its
        own label first, then its components' (computed by
        [hegel_label_combine]). *)
    val combine : Internal.Label.t list -> Internal.Label.t

    val list : Internal.Label.t
    val set : Internal.Label.t
    val array : Internal.Label.t
    val permutation : Internal.Label.t
    val assoc_list : Internal.Label.t
    val hash_table : Internal.Label.t
    val tuple : Internal.Label.t
    val one_of : Internal.Label.t
    val optional : Internal.Label.t
    val fixed_dict : Internal.Label.t
    val flat_map : Internal.Label.t
    val filter : Internal.Label.t
    val filter_attempt : Internal.Label.t
    val mapped : Internal.Label.t
    val enum_variant : Internal.Label.t
    val pool : Internal.Label.t
    val function_ : Internal.Label.t
    val function_result : Internal.Label.t
    val stateful_rule : Internal.Label.t
  end

  (** [label_of gen] is the span label of [gen]. *)
  val label_of : 'a generator -> Internal.Label.t

  (** [group label data f] runs [f ()] inside a span with the given [label]. The
      span is stopped with [discard:false] regardless of whether [f] raises. *)
  val group : Internal.Label.t -> Internal.test_case -> (unit -> 'a) -> 'a

  (** [discardable_group label data f] runs [f ()] inside a span with [label].
      If [f] raises, the span is stopped with [discard:true]; otherwise
      [discard:false]. *)
  val discardable_group : Internal.Label.t -> Internal.test_case -> (unit -> 'a) -> 'a

  (** A collection handle for generating variable-length sequences. *)
  type collection =
    { mutable finished : bool
    ; mutable handle : Internal.collection option
    ; min_size : int
    ; max_size : int option
    }

  (** [with_collection ~min_size ?max_size data f] runs [f] with a new
      collection and releases the engine-side handle after calling [f]. *)
  val with_collection
    :  min_size:int
    -> ?max_size:int
    -> Internal.test_case
    -> (collection -> 'a)
    -> 'a

  (** [collection_more coll data] returns [true] if more elements should be
      generated, [false] when the collection is complete. *)
  val collection_more : collection -> Internal.test_case -> bool

  (** [collection_reject coll data] rejects the last element of the collection.
      Raises [Internal.Stop_test] on StopTest. *)
  val collection_reject : collection -> Internal.test_case -> unit
end

(** Helpers referenced by code generated by [ppx_hegel_generator]. Not for
    direct use — no stability guarantees. *)
module Ppx_internal : sig
  module Labels : sig
    val from_name : string -> Internal.Label.t
    val combine : Internal.Label.t list -> Internal.Label.t
    val fixed_dict : Internal.Label.t
    val enum_variant : Internal.Label.t
  end

  (** A drawn value's display, produced only when the draw is printed. *)
  type show = unit -> Printer.doc

  (** [draw tc gen] draws from [gen], returning the value with its display. *)
  val draw : Internal.test_case -> 'a generator -> 'a * show

  (** [explicit_draw tc ~name ~source value gen] is [value], the value an
      [[@@example]] gives, written [source], for the binding [name] of a draw
      from [gen]. The [let%hegel_test] PPX substitutes it for the draw in the
      example's copy of the test body. *)
  val explicit_draw
    :  Internal.test_case
    -> name:string
    -> source:string
    -> 'a
    -> 'a generator
    -> 'a

  (** [composite_with_label ~label generate_fn] is {!composite} but tags the
      span with [label] instead of the fixed struct/record label, and
      [generate_fn] returns the value's display with it. Used by the derive PPX
      to build derived generators that print structurally. *)
  val%template composite_with_label
    :  label:Internal.Label.t
    -> (Internal.test_case -> 'a * show) MODE(m)
    -> 'a generator MODE(m)
  [@@mode m = (nonportable, portable)]
end

(**/**)
