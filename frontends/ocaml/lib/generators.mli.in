#ifdef OXCAML
@@ portable
#define MODE(m) @ m
#define KIND(k) : k
#else
#define MODE(m)
#define KIND(k)
#endif
(** This module provides a composable generator API for property-based testing.
    Generators produce typed OCaml values.

    All examples in this documentation assume [open Hegel].

    The usual way to build a compound value is to {!Hegel.draw} its parts in
    sequence:

    {[
      type point = { x : int; y : int }

      let%hegel_test points_stay_in_range tc =
        let x = draw tc (integers ~min_value:0 ~max_value:100 ()) in
        let y = draw tc (integers ~min_value:0 ~max_value:100 ()) in
        let p = { x; y } in
        require tc ~msg:"point coordinates stay in range"
          (p.x <= 100 && p.y <= 100)
      ;;
    ]}

    Generator combinators are higher-order functions that take generators and/or
    functions as input and assemble them into a single generator:

    - {!map} transforms every generated value with a function.
    - {!flat_map} builds a {e dependent} generator, where a later generator is
      chosen from an earlier value. For example, draw a length [n], then a list
      of exactly [n] elements.
    - {!filter} keeps only values satisfying a predicate.
    - {!one_of} and {!sampled_from} choose among alternatives.

    Every generator carries a phantom type ['p] recording whether it holds a printer.
    Primitive generators are {!printable} and may be drawn with {!Hegel.draw},
    which prints the drawn value on a failing replay. *)

(** A generator producing values of type ['a]. The phantom ['p] is {!printable}
    when the generator carries a printer (and so may be drawn with {!Hegel.draw})
    and {!unprintable} otherwise. *)
type ('a, 'p) generator
#ifdef OXCAML
  : value mod contended
#endif

(** Phantom witness that a generator carries a printer; see {!generator}. *)
type printable

(** Phantom witness that a generator carries no printer; see {!generator}.

    A generator is [unprintable] whenever the result type is the caller's rather
    than the engine's, so Hegel has no printer to attach. This covers {!map},
    {!flat_map}, {!sampled_from}, {!just}, {!composite}, and the generators
    produced by [\[@@deriving hegel_generator\]]. An [unprintable] generator
    cannot be drawn with {!Hegel.draw}. There are two ways to use an [unprintable]
    generator:

    - Draw it with {!Hegel.draw_silent}, which produces the value but records
      nothing for the failing-replay output.
    - Attach a printer with {!Hegel.with_printer} to obtain a {!printable}
      generator that can be drawn from with {!Hegel.draw} *)
type unprintable

(**/**)

(** [draw ?label ?loc tc gen] produces a typed value from the printable generator
    [gen] using test case [tc].

    On the final replay of a failing test (or on every case under verbose
    output), an outermost draw prints its value through [Internal.note] as
    [name = value] when no location is supplied. The [name] is [label] when given,
    else ["draw"]. An unlabeled draw is numbered ([draw_1], [draw_2], …).
    Draws nested inside a span (e.g. composite elements) are suppressed so only
    the outermost value shows. To draw a generator with no printer, use
    {!draw_silent} or attach a printer with {!with_printer}.

    [?loc] adds the source filename and line to the printed draw. In OxCaml, the
    compiler automatically supplies the caller's position when omitted. Providing
    [loc] overrides that position. The draw is then printed as
    [name @ filename:line = value].

    Inside a [let%hegel_test], the PPX supplies the binding name as the label, so
    [let x = draw tc gen] prints its value as [x = value]. When the same name is
    shadowed or drawn in a loop, its draws are numbered [x_1], [x_2], … in draw
    order. Pass [?label] to override the name (e.g. [draw ~label:"y" tc gen]).

    {[
      let%hegel_test draw_example tc =
        let n = draw tc (integers ~min_value:0 ~max_value:100 ()) in
        assert (n >= 0)
      ;;
    ]} *)
val draw
  :  ?label:string
#ifdef OXCAML
  -> loc:[%call_pos]
#else
  -> ?loc:Lexing.position
#endif
  -> Internal.test_case
  -> ('a, printable) generator
  -> 'a

(** [draw_named ~label ~repeatable tc gen] is the naming-aware draw the
    [let%hegel_test] PPX rewrites bindings to; not intended for direct use
    (prefer {!draw}). It prints [label = value] (bare), or [label_1 = value],
    [label_2 = value], … when [repeatable] is set. The PPX sets [repeatable = true]
    for a binding name that is reused or drawn in a loop. *)
val draw_named
  :  label:string
#ifdef OXCAML
  -> loc:[%call_pos]
#else
  -> ?loc:Lexing.position
#endif
  -> repeatable:bool
  -> Internal.test_case
  -> ('a, printable) generator
  -> 'a

(** [draw_silent tc gen] produces a typed value from any generator without
    recording it for the final-replay output. Use it for draws whose value is
    not a useful part of the printed counterexample, or for generators that
    carry no printer.

    {[
      let%hegel_test draw_silent_example tc =
        let n =
          draw_silent
            tc
            (map (fun x -> x * 2) (integers ~min_value:0 ~max_value:9 ()))
        in
        assert (n >= 0)
      ;;
    ]} *)
val draw_silent : Internal.test_case -> ('a, 'p) generator -> 'a

(** [draw_silent_named ~name tc gen] is {!draw_silent} threading the draw-site
    [name] into a function generator ({!functions}). Not intended for
    direct use (prefer {!draw_silent}). *)
val draw_silent_named : name:string -> Internal.test_case -> ('a, 'p) generator -> 'a

(** [with_printer sexp_of gen] attaches (or replaces) [gen]'s printer, yielding
    a printable generator that {!draw} accepts. This is how a [map]/[flat_map]/
    [sampled_from]/[just] result is made drawable with {!draw}.

    The printer is any ['a -> Sexplib0.Sexp.t].

    With [ppx_sexp_conv] in your preprocessor, [\[%sexp_of: t\]] is the idiomatic
    shorthand for that function

    {[
      let%hegel_test with_printer_example tc =
        let doubled =
          map (fun x -> x * 2) (integers ~min_value:0 ~max_value:9 ())
        in
        (* [%sexp_of: int] is shorthand for the int printer. *)
        let n = draw tc (with_printer [%sexp_of: int] doubled) in
        assert (n >= 0)
      ;;
    ]} *)
val%template with_printer
  :  ('a -> Sexplib0.Sexp.t) MODE(m)
  -> ('a, 'p) generator MODE(m)
  -> ('a, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [printer gen] is the printer carried by the printable generator [gen]. *)
val%template printer : ('a, printable) generator MODE(m) -> ('a -> Sexplib0.Sexp.t) MODE(m)
[@@mode m = (nonportable, portable)]

(** [leaf ~name ~draw ~sexp_of] builds a printable generator from a single
    typed engine draw, labeled from [name]. Not part of the public API. *)
val%template leaf
  :  name:string
  -> draw:(Internal.test_case -> 'a) MODE(m)
  -> sexp_of:('a -> Sexplib0.Sexp.t) MODE(m)
  -> ('a, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(**/**)

(**/**)

(** The generator constructors. {!Hegel} re-exports them unqualified. *)
module Public : sig
(** {2 Primitive generators} *)

(** [booleans ?p ()] creates a generator for boolean values, [true] with
    probability [p] (default [0.5]). [p] must be between 0 and 1.

    {[
      let%hegel_test booleans_example tc =
        let b = draw tc (booleans ~p:0.9 ()) in
        assert (b = true || b = false)
      ;;
    ]} *)
val booleans : ?p:float -> unit -> (bool, printable) generator MODE(portable)

(** [integers ?min_value ?max_value ()] creates a generator for integers within
    the given bounds.

    Defaults:
    - [min_value]: OCaml native int min
    - [max_value]: OCaml native int max

    {[
      let%hegel_test integers_example tc =
        let n = draw tc (integers ~min_value:1 ~max_value:6 ()) in
        assert (n >= 1 && n <= 6)
      ;;
    ]} *)
val integers : ?min_value:int -> ?max_value:int -> unit -> (int, printable) generator MODE(portable)

(** [floats ?min_value ?max_value ?exclude_min ?exclude_max ?allow_nan
     ?allow_infinity ()] creates a generator for floating-point values.

    Defaults:
    - [min_value] / [max_value]: unbounded. With [allow_infinity = false] the
      range is [[-max_float, max_float]].
    - [exclude_min]: [false]
    - [exclude_max]: [false]
    - [allow_nan]: [true] only when no bounds are set
    - [allow_infinity]: [true] when at most one bound is set

    Bounds that only allow infinity to be generated while [allow_infinity] is [false], 
    such as [~min_value:infinity], raise [Usage_error].

    {[
      let%hegel_test floats_example tc =
        let f = draw tc (floats ~min_value:0.0 ~max_value:1.0 ()) in
        assert (Float.compare f 0.0 >= 0)
      ;;
    ]} *)
val floats
  :  ?min_value:float
  -> ?max_value:float
  -> ?exclude_min:bool
  -> ?exclude_max:bool
  -> ?allow_nan:bool
  -> ?allow_infinity:bool
  -> unit
  -> (float, printable) generator MODE(portable)

(** [text ?min_size ?max_size ?codec ?min_codepoint ?max_codepoint ?categories
     ?exclude_categories ?include_characters ?exclude_characters ?alphabet ()]
    creates a generator for Unicode text strings.

    Character filtering options restrict which characters may appear:
    - [codec]: restrict to characters encodable in this codec (e.g. ["ascii"],
      ["utf-8"], ["latin-1"])
    - [min_codepoint], [max_codepoint]: restrict Unicode codepoint range
    - [categories]: whitelist of Unicode general categories (e.g.
      [["L"; "Nd"]]). Mutually exclusive with [exclude_categories].
    - [exclude_categories]: blacklist of Unicode general categories. Mutually
      exclusive with [categories].
    - [include_characters]: add these characters even if the codepoint range or
      categories exclude them. Each must be encodable in [codec] and must not
      also appear in [exclude_characters], or the draw raises [Usage_error].
    - [exclude_characters]: always exclude these characters
    - [alphabet]: fixed set of allowed characters. Mutually exclusive with all
      individual character filtering parameters.

    Surrogate codepoints (category Cs) are always excluded since OCaml strings
    are conventionally UTF-8.

    {[
      let%hegel_test text_example tc =
        let s = draw tc (text ~min_size:1 ~max_size:8 ~codec:"ascii" ()) in
        assert (String.length s >= 1)
      ;;
    ]} *)
val text
  :  ?min_size:int
  -> ?max_size:int
  -> ?codec:string
  -> ?min_codepoint:int
  -> ?max_codepoint:int
  -> ?categories:string list
  -> ?exclude_categories:string list
  -> ?include_characters:string
  -> ?exclude_characters:string
  -> ?alphabet:string
  -> unit
  -> (string, printable) generator MODE(portable)

(** [characters ?codec ?min_codepoint ?max_codepoint ?categories
     ?exclude_categories ?include_characters ?exclude_characters ()] creates a
    generator for single Unicode characters (as single-character UTF-8 strings).

    Accepts the same character filtering options as {!text} except [min_size],
    [max_size], and [alphabet]. Surrogate codepoints (category Cs) are always
    excluded since OCaml strings are conventionally UTF-8.

    {[
      let%hegel_test characters_example tc =
        let c = draw tc (characters ~codec:"ascii" ()) in
        assert (String.length c >= 1)
      ;;
    ]} *)
val characters
  :  ?codec:string
  -> ?min_codepoint:int
  -> ?max_codepoint:int
  -> ?categories:string list
  -> ?exclude_categories:string list
  -> ?include_characters:string
  -> ?exclude_characters:string
  -> unit
  -> (string, printable) generator MODE(portable)

(** [make_characters ~of_char ~sexp_of ()] builds a generator for single
    characters over any representation ['a], covering the full native [char]
    range (codepoints 0-255, i.e. Latin-1). *)
val%template make_characters
  :  of_char:(char -> 'a) MODE(m)
  -> sexp_of:('a -> Sexplib0.Sexp.t) MODE(m)
  -> unit
  -> ('a, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [chars ()] creates a generator for single characters (codepoints 0-255,
    i.e. Latin-1) as native [char] values.

    {[
      let%hegel_test chars_example tc =
        let c = draw tc (chars ()) in
        assert (Char.code c >= 0 && Char.code c <= 0xFF)
      ;;
    ]} *)
val chars : unit -> (char, printable) generator MODE(portable)

(** [binary ?min_size ?max_size ()] creates a generator for binary byte strings.

    {[
      let%hegel_test binary_example tc =
        let bytes = draw tc (binary ~min_size:0 ~max_size:16 ()) in
        assert (String.length bytes <= 16)
      ;;
    ]} *)
val binary : ?min_size:int -> ?max_size:int -> unit -> (string, printable) generator MODE(portable)

(** [just value] creates a generator that always produces [value]. The output
    type is the caller's, so the result carries no printer.

    {[
      let%hegel_test just_example tc =
        let x = draw_silent tc (just 42) in
        assert (x = 42)
      ;;
    ]} *)
val%template just : ('a KIND(value mod c)) MODE(m) -> ('a, unprintable) generator MODE(m)
[@@mode (m, c) = ((nonportable, uncontended), (portable, contended))]

(** {2 Collection generators} *)

(** [lists elements ?min_size ?max_size ?unique ()] creates a generator for
    lists of [elements]. When [unique] is [true], elements will be
    distinct.

    {[
      let%hegel_test lists_example tc =
        let xs =
          draw tc (lists (integers ~min_value:0 ~max_value:9 ()) ~max_size:10 ())
        in
        assert (List.length xs <= 10)
      ;;
    ]} *)
val%template lists
  :  ('a, printable) generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> ?unique:bool
  -> unit
  -> ('a list, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [assoc_lists keys values ?min_size ?max_size ()] creates a
    generator for association lists over printable [keys] and [values]:
    [(key, value)] pairs, in generation order, whose keys are unique.

    {[
      let%hegel_test assoc_lists_example tc =
        let m =
          draw tc
            (assoc_lists
               (text ~max_size:4 ())
               (integers ~min_value:0 ~max_value:9 ())
               ~max_size:5
               ())
        in
        assert (List.length m <= 5)
      ;;
    ]} *)
val%template assoc_lists
  :  ('a, printable) generator MODE(m)
  -> ('b, printable) generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> (('a * 'b) list, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [make_hash_tables ~of_pairs ~sexp_of_t keys values ?min_size ?max_size ()]
    builds a hash-table generator over any table type ['t]. *)
val%template make_hash_tables
  :  of_pairs:(('a * 'b) list -> 't) MODE(m)
  -> sexp_of_t:
       (('a -> Sexplib0.Sexp.t) -> ('b -> Sexplib0.Sexp.t) -> 't -> Sexplib0.Sexp.t) MODE(m)
  -> ('a, printable) generator MODE(m)
  -> ('b, printable) generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> ('t, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [hash_tables keys values ?min_size ?max_size ()] creates a generator for
    [Stdlib.Hashtbl.t] tables over printable [keys] and [values]

    {[
      let%hegel_test hash_tables_example tc =
        let m =
          draw tc
            (hash_tables
               (text ~max_size:4 ())
               (integers ~min_value:0 ~max_value:9 ())
               ~max_size:5
               ())
        in
        assert (Hashtbl.length m <= 5)
      ;;
    ]} *)
val%template hash_tables
  :  ('a, printable) generator MODE(m)
  -> ('b, printable) generator MODE(m)
  -> ?min_size:int
  -> ?max_size:int
  -> unit
  -> (('a, 'b) Stdlib.Hashtbl.t, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [sampled_from options] creates a generator that samples from a non-empty
    list of values.

    {[
      let%hegel_test sampled_from_example tc =
        let color = draw_silent tc (sampled_from [ `Red; `Green; `Blue ]) in
        ignore color
      ;;
    ]} *)
val%template sampled_from
  : ('a KIND(value mod c)) list MODE(m) -> ('a, unprintable) generator MODE(m)
[@@mode (m, c) = ((nonportable, uncontended), (portable, contended))]

(** [one_of generators] creates a generator that picks from one of the given
    printable [generators]. Raises [Usage_error] if [generators] is empty. On a failing
    replay, the drawn value prints through the printer of the branch it was
    drawn from. The recorded branch is per generator value: if one [one_of]
    generator is drawn several times before printing (e.g. as the element
    generator of {!lists}), every value prints through the most recently drawn
    branch's printer.

    {[
      let%hegel_test one_of_example tc =
        let n =
          draw tc
            (one_of
               [ integers ~min_value:0 ~max_value:9 ()
               ; integers ~min_value:90 ~max_value:99 ()
               ])
        in
        assert (n >= 0)
      ;;
    ]} *)
val%template one_of : ('a, printable) generator list MODE(m) -> ('a, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [optional gen] creates a generator that produces either [None] or
    [Some value] from the printable [gen].

    {[
      let%hegel_test optional_example tc =
        let o = draw tc (optional (integers ~min_value:0 ~max_value:9 ())) in
        match o with
        | None -> ()
        | Some n -> assert (n >= 0)
      ;;
    ]} *)
val%template optional
  :  ('a, printable) generator MODE(m)
  -> ('a option, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** {2 Tuple generators} *)

(** [tuples2 g1 g2] creates a generator for 2-element tuples of printable
    components.

    {[
      let%hegel_test tuples2_example tc =
        let n, b =
          draw tc
            (tuples2 (integers ~min_value:0 ~max_value:9 ()) (booleans ()))
        in
        assert (n >= 0 && (b || not b))
      ;;
    ]} *)
val%template tuples2
  :  ('a, printable) generator MODE(m)
  -> ('b, printable) generator MODE(m)
  -> ('a * 'b, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples3 g1 g2 g3] creates a generator for 3-element tuples of printable
    components.

    {[
      let%hegel_test tuples3_example tc =
        let a, b, c =
          draw tc
            (tuples3
               (integers ~min_value:0 ~max_value:9 ())
               (booleans ())
               (text ~max_size:4 ()))
        in
        assert (a >= 0 && (b || not b) && String.length c >= 0)
      ;;
    ]} *)
val%template tuples3
  :  ('a, printable) generator MODE(m)
  -> ('b, printable) generator MODE(m)
  -> ('c, printable) generator MODE(m)
  -> ('a * 'b * 'c, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [tuples4 g1 g2 g3 g4] creates a generator for 4-element tuples of printable
    components.

    {[
      let%hegel_test tuples4_example tc =
        let a, b, c, d =
          draw tc
            (tuples4
               (integers ~min_value:0 ~max_value:9 ())
               (booleans ())
               (text ~max_size:4 ())
               (floats ~min_value:0.0 ~max_value:1.0 ()))
        in
        assert (a >= 0 && (b || not b) && String.length c >= 0 && Float.compare d 0.0 >= 0)
      ;;
    ]} *)
val%template tuples4
  :  ('a, printable) generator MODE(m)
  -> ('b, printable) generator MODE(m)
  -> ('c, printable) generator MODE(m)
  -> ('d, printable) generator MODE(m)
  -> ('a * 'b * 'c * 'd, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** {2 Function generators} *)

(** [functions ?name ?sexp_of_arg ~returns ()] creates a generator for functions
    ['a -> 'b] whose results are drawn from [returns].

    The result carries no printer (its output type is a function), so draw it
    with {!Hegel.draw_silent}. Applying the drawn function to an argument draws a
    result from [returns] the first time that argument is seen and memoizes it.

    On the failing final replay each top-level application prints as
    [name arg = result] (applications nested inside a span are suppressed).
    [name] is [?name] when you pass it. Otherwise, the draw-site binding name
    inside a [let%hegel_test], else ["function"].

    The memo table keys on the argument itself (structural hash/equality), so
    distinct arguments always get independent results. [sexp_of_arg] only renders
    the argument in the shown pair. An omitted [sexp_of_arg] or a non-printable
    [returns] shows [<opaque>].

    {[
      let%hegel_test map_length_preserved tc =
        let f_gen =
          functions ~sexp_of_arg:[%sexp_of: int] ~returns:(integers ()) ()
        in
        let f = draw_silent tc f_gen in
        let xs = draw tc (lists (integers ()) ()) in
        assert (List.length (List.map f xs) = List.length xs)
      ;;
    ]} *)
val%template functions
  :  ?name:string
  -> ?sexp_of_arg:('a -> Sexplib0.Sexp.t) MODE(m)
  -> returns:('b, _) generator MODE(m)
  -> unit
  -> ('a -> 'b, unprintable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [functions2 ?name ?sexp_of_arg1 ?sexp_of_arg2 ~returns ()] creates a
    generator for curried two-argument functions ['a -> 'b -> 'c].

    Sugar over {!functions} keyed on the argument pair: the two arguments form
    one memo key and are shown uncurried as [name (arg1 arg2) = result]. Draw it
    with {!draw_silent}. *)
val%template functions2
  :  ?name:string
  -> ?sexp_of_arg1:('a -> Sexplib0.Sexp.t) MODE(m)
  -> ?sexp_of_arg2:('b -> Sexplib0.Sexp.t) MODE(m)
  -> returns:('c, _) generator MODE(m)
  -> unit
  -> ('a -> 'b -> 'c, unprintable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [functions3 ?name ?sexp_of_arg1 ?sexp_of_arg2 ?sexp_of_arg3 ~returns ()]
    creates a generator for curried three-argument functions
    ['a -> 'b -> 'c -> 'd].

    Like {!functions2}, keyed on the argument triple and shown uncurried as
    [name (arg1 arg2 arg3) = result]. Draw it with {!draw_silent}. *)
val%template functions3
  :  ?name:string
  -> ?sexp_of_arg1:('a -> Sexplib0.Sexp.t) MODE(m)
  -> ?sexp_of_arg2:('b -> Sexplib0.Sexp.t) MODE(m)
  -> ?sexp_of_arg3:('c -> Sexplib0.Sexp.t) MODE(m)
  -> returns:('d, _) generator MODE(m)
  -> unit
  -> ('a -> 'b -> 'c -> 'd, unprintable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** {2 Format generators} *)

(** [emails ()] creates a generator for valid email address strings.

    Addresses follow RFC 5321/5322: a local part of 1 to 64 characters from the
    RFC 5322 [atext] set, an [@], and a domain from {!domains}, with the overall
    address length capped at 254 octets (RFC 5321 §4.5.3.1.3).

    {[
      let%hegel_test emails_example tc =
        let e = draw tc (emails ()) in
        assert (String.contains e '@')
      ;;
    ]} *)
val emails : unit -> (string, printable) generator MODE(portable)

(** [urls ()] creates a generator for valid URL strings.

    URLs follow RFC 3986, of the form
    [scheme://domain\[:port\]/path\[#fragment\]] with [scheme] one of
    [http]/[https], the domain drawn from {!domains} (up to 255 characters), an
    optional port in [1, 65535], zero or more [/]-separated path segments of up
    to 100 characters each, and an optional fragment of up to 100 characters.
    Path and fragment characters are percent-encoded.

    {[
      let%hegel_test urls_example tc =
        let u = draw tc (urls ()) in
        assert (String.length u > 0)
      ;;
    ]} *)
val urls : unit -> (string, printable) generator MODE(portable)

(** [domains ?max_length ()] creates a generator for domain name strings.

    Domains are RFC 1035 fully-qualified domain names: a top-level domain
    sampled from the IANA TLD list followed by up to 126 dot-separated labels,
    each 1 to 63 characters matching
    [\[a-zA-Z\](\[a-zA-Z0-9-\]{0,61}\[a-zA-Z0-9\])?] (punycode [xn--] labels
    reserved by RFC 5890 are excluded). Generated domains never exceed
    [max_length] (default 255, per RFC 1035 §2.3.4); when provided, [max_length]
    must be in [4, 255].

    {[
      let%hegel_test domains_example tc =
        let d = draw tc (domains ~max_length:64 ()) in
        assert (String.length d <= 64)
      ;;
    ]} *)
val domains : ?max_length:int -> unit -> (string, printable) generator MODE(portable)

(** [ip_addresses ?version ()] creates a generator for typed [Ipaddr.t] IP
    addresses. [version] selects IPv4 ([`V4], RFC 791) or IPv6 ([`V6],
    RFC 4291); when omitted, either version is generated. Render a drawn
    address with [Ipaddr.to_string] (RFC 5952 canonical form for v6).

    {[
      let%hegel_test ip_addresses_example tc =
        match draw tc (ip_addresses ~version:`V4 ()) with
        | Ipaddr.V4 _ as ip -> assert (String.contains (Ipaddr.to_string ip) '.')
        | Ipaddr.V6 _ -> assert false
      ;;
    ]} *)
val ip_addresses : ?version:[ `V4 | `V6 ] -> unit -> (Ipaddr.t, printable) generator MODE(portable)

(** [from_regex pattern ?fullmatch ()] creates a generator for strings matching
    a regular expression [pattern], written in the syntax of Python's [re]
    module. When [fullmatch] is [true] (the default) the whole string must match
    [pattern]; otherwise a match anywhere suffices. A pattern that does not
    parse, or that no string matches, raises [Usage_error] when drawn.

    {[
      let%hegel_test from_regex_example tc =
        let s = draw tc (from_regex "[a-z]+" ()) in
        assert (String.length s >= 1)
      ;;
    ]} *)
val from_regex : string -> ?fullmatch:bool -> unit -> (string, printable) generator MODE(portable)

(** {2 Generator combinators} *)

(** [composite generate_fn] builds a generator from an imperative [generate_fn]
    that draws sub-values from the test case and assembles a result, useful when
    a value is easiest to describe by drawing its parts in sequence.

    {[
      let point =
        composite (fun tc ->
          let x = draw_silent tc (integers ~min_value:0 ~max_value:9 ()) in
          let y = draw_silent tc (integers ~min_value:0 ~max_value:9 ()) in
          x, y)
      ;;
    ]} *)
val%template composite : (Internal.test_case -> 'a) MODE(m) -> ('a, unprintable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [map f gen] transforms values from [gen] using [f].

    {[
      let%hegel_test map_example tc =
        let even =
          draw_silent tc (map (fun x -> x * 2) (integers ~min_value:0 ~max_value:9 ()))
        in
        assert (even mod 2 = 0)
      ;;
    ]} *)
val%template map
  :  ('a -> 'b) MODE(m)
  -> ('a, 'p) generator MODE(m)
  -> ('b, unprintable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [flat_map f gen] creates a dependent generator. [f] receives the generated
    value and returns a generator whose value is the final result.

    {[
      let%hegel_test flat_map_example tc =
        let len_gen = integers ~min_value:0 ~max_value:5 () in
        let xs =
          draw_silent tc
            (flat_map
               (fun n ->
                  lists
                    (integers ~min_value:0 ~max_value:9 ())
                    ~min_size:n
                    ~max_size:n
                    ())
               len_gen)
        in
        assert (List.length xs <= 5)
      ;;
    ]} *)
val%template flat_map
  :  ('a -> ('b, 'q) generator) MODE(m)
  -> ('a, 'p) generator MODE(m)
  -> ('b, unprintable) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** [filter predicate gen] filters values from [gen] using [predicate], keeping
    [gen]'s printability. Tries up to three times and rejects the test case if all
    attempts fail.

    {[
      let%hegel_test filter_example tc =
        let even =
          draw tc (filter (fun x -> x mod 2 = 0) (integers ~min_value:0 ~max_value:100 ()))
        in
        assert (even mod 2 = 0)
      ;;
    ]} *)
val%template filter
  :  ('a -> bool) MODE(m)
  -> ('a, 'p) generator MODE(m)
  -> ('a, 'p) generator MODE(m)
[@@mode m = (nonportable, portable)]

(** Date and time generators: dates, times, instants, UTC offsets, time
    zones, zoned datetimes, durations and calendar spans, drawn by default
    against the IANA time zone database bundled in the engine. *)
module Temporal : sig
  (** Dates, times, instants, UTC offsets, time zones, durations and calendar
      spans, as the engine draws them.

      The generators are {!dates}, {!times}, {!datetimes}, {!instants},
      {!offsets}, {!zones}, {!zoned_datetimes}, {!durations} and {!spans}. The
      values they draw are the plain records and variants of this module,
      mirroring the engine's value model field for field, with no arithmetic and
      no parsing: a test that uses a date library converts the value it draws
      with {!map}. Each generator is printable, and prints a value in the RFC
      9557 form the engine prints a counterexample in, so a failing value reads
      the same from every language binding:
      [2024-03-10T01:30:00-05:00[America/New_York]], with [[gap]] or
      [[fold=0]]/[[fold=1]] appended to a skipped or repeated wall time,
      [-00:00] for an unknown offset and [Z[Etc/Unknown]] for the unknown zone.
      Failure output prints that text as it is, without the quotes and escapes
      of an s-expression atom, also when the value is part of a larger one
      such as a list; the [sexp_of_*] printers return it as an atom.

      {[
        let%hegel_test weekend_dates tc =
          let d =
            draw
              tc
              (Temporal.dates
                 ~min_value:Temporal.{ year = 2024; month = 1; day = 1 }
                 ~weekdays:Temporal.[ Saturday; Sunday ]
                 ())
          in
          assert (d.year >= 2024)
        ;;
      ]}

      {2 Time zone data}

      Zones are drawn, and wall times classified and resolved, against a
      {!Zone_source.t}. OCaml's standard library has no time zone database, so
      by default every draw and query uses the IANA database bundled in the
      engine, whose release {!tzdb_version} names. {!set_default_zone_source}
      replaces that default for the whole process, and [zones ~source] for one
      generator. {!Zone_source} fills a source from any other database (TZif
      files, zone data as fields, an offset oracle, or a loader that supplies
      each zone the first time it is needed), so that the gaps and folds the
      engine targets are the ones the code under test computes. The functions
      {!resolve}, {!offset_at} and {!info} query a source directly, outside any
      test. *)

  (** {2 Values} *)

  (** The lowest year of a {!type-date}, [-999999]. *)
  val min_year : int

  (** The highest year of a {!type-date}, [999999]. *)
  val max_year : int

  (** The first second of {!min_year}, the lowest [second] of an {!type-instant}. *)
  val min_instant : int

  (** The last second of {!max_year}, the highest [second] of an {!type-instant}. *)
  val max_instant : int

  (** The largest magnitude of a known {!utc_offset} in seconds, 25:59:59. *)
  val max_offset : int

  (** ["Etc/Unknown"], the zone whose instants are known and whose offset is
      not. *)
  val unknown_zone : string

  (** A proleptic Gregorian calendar date: [year] in
      [\[min_year, max_year\]], [month] in [\[1, 12\]] and [day] in
      [\[1, days in the month\]]. Prints as [2024-03-10], with a signed
      six-digit year outside [0000] to [9999]. *)
  type date =
    { year : int
    ; month : int
    ; day : int
    }

  (** A time of day from [00:00:00] to [23:59:59.999999999]: [hour] in
      [\[0, 23\]], [minute] and [second] in [\[0, 59\]] (no leap seconds) and
      [nanosecond] in [\[0, 999999999\]]. Prints as [02:30:00], with the
      fraction appended when it is not zero: [02:30:00.5]. *)
  type time =
    { hour : int
    ; minute : int
    ; second : int
    ; nanosecond : int
    }

  (** A wall-clock date and time with no zone or offset. Prints as
      [2024-03-10T02:30:00]. *)
  type datetime =
    { date : date
    ; time : time
    }

  (** An instant: [second]s since the Unix epoch in
      [\[min_instant, max_instant\]] and a [nanosecond] in [\[0, 999999999\]]
      counted forward from that second, so -1.5 s is
      [{ second = -2; nanosecond = 500_000_000 }]. Prints as the UTC wall
      time with a [Z] suffix: [2000-01-01T00:00:00Z]. *)
  type instant =
    { second : int
    ; nanosecond : int
    }

  (** A UTC offset: a known number of seconds east of UTC within
      [±max_offset], or the unknown offset of RFC 3339's [-00:00]. Prints as
      [+05:30], [-00:44:30] (the seconds appended when they are not zero) or
      [-00:00]. *)
  type utc_offset =
    | Known of int
    | Unknown

  (** A time zone: [name] as it was drawn or written, link names such as
      [Asia/Calcutta] included, and [primary_name] the zone it resolves to
      ([Asia/Kolkata]), or the name itself for a zone the source lacks. Prints
      as the name. *)
  type time_zone =
    { name : string
    ; primary_name : string
    }

  (** How a wall-clock time maps to instants in its zone. *)
  type transition_kind =
    | Unique (** Exactly one instant. *)
    | Gap (** None: the clocks skipped it. *)
    | Fold (** Two: the clocks repeated it. *)

  (** A wall-clock time in a time zone, resolved to an instant: the
      {!transition_kind} of the wall time, the offsets in force before and
      after the transition it falls on (both the resolved offset for a unique
      time), which repeat of a fold it means ([fold], the later when set), the
      resolved [offset] ({!Unknown} in {!unknown_zone} and in a zone only the
      caller's database knows) and the [instant]: the unique instant, the one
      [fold] picks, or for a gap the wall time read with [offset_before].
      Build a value of your own date library from [civil], the zone name and
      [fold] (or, for a gap, from [instant]), never from the offsets, so that
      a newer database on your side changes what a value means but never
      makes it invalid. *)
  type zoned_datetime =
    { zone : time_zone
    ; civil : datetime
    ; kind : transition_kind
    ; offset_before : utc_offset
    ; offset_after : utc_offset
    ; fold : bool
    ; offset : utc_offset
    ; instant : instant
    }

  (** A signed duration: [seconds] plus [nanoseconds] of the same sign, the
      latter within [±999999999], so -1.5 s is
      [{ seconds = -1; nanoseconds = -500_000_000 }]. Prints in the ISO 8601
      form [PT1H30M5.5S], with a leading [-] when negative and [PT0S] for
      zero. *)
  type signed_duration =
    { seconds : int
    ; nanoseconds : int
    }

  (** A calendar span: a signed count of each unit from years to nanoseconds,
      never normalised (90 minutes is not an hour and a half, and a month is
      not a number of days). Every unit shares one sign unless the span was
      drawn with {!Mixed}. Prints each nonzero unit as
      [1y 2mo 3w 4d 5h 6m 7s 8ms 9µs 10ns], with one leading [-] when every
      unit is negative or zero, a [-] on each negative unit when the signs are
      mixed, and [0s] for zero. *)
  type span =
    { years : int
    ; months : int
    ; weeks : int
    ; days : int
    ; hours : int
    ; minutes : int
    ; seconds : int
    ; milliseconds : int
    ; microseconds : int
    ; nanoseconds : int
    }

  (** The unit the time part of a drawn value is counted in: the value is a
      whole number of these units and shrinks in them. *)
  type precision =
    | Nanoseconds
    | Microseconds
    | Milliseconds
    | Seconds
    | Minutes
    | Hours

  (** The values an offset draw restricts itself to. *)
  type granularity =
    | Hours
    | Quarter_hours
    | Minutes
    | Seconds

  (** A day of the week. *)
  type weekday =
    | Monday
    | Tuesday
    | Wednesday
    | Thursday
    | Friday
    | Saturday
    | Sunday

  (** A month of the year. *)
  type month =
    | January
    | February
    | March
    | April
    | May
    | June
    | July
    | August
    | September
    | October
    | November
    | December

  (** Which instant a zoned datetime draw means by a wall time the clocks
      repeated. *)
  type ambiguous =
    | Both (** Either, decided by a drawn fold that shrinks to the earlier. *)
    | Earlier (** The earlier instant, with no fold drawn. *)
    | Later (** The later instant, with no fold drawn. *)

  (** How the signs of a span's units are drawn. *)
  type span_sign =
    | Uniform (** One sign for every unit. *)
    | Mixed (** Each unit signed on its own. *)
    | Non_negative (** Magnitudes only. *)

  (** A unit of a {!span}, largest first. *)
  type span_unit =
    | Years
    | Months
    | Weeks
    | Days
    | Hours
    | Minutes
    | Seconds
    | Milliseconds
    | Microseconds
    | Nanoseconds

  (** A feature of a time zone, derived from its offsets and name. "After
      1970" means at any instant from 1970-01-01T00:00:00Z on, the rule in
      force after the last explicit transition included. *)
  type tag =
    | Fixed (** No transition after 1970. *)
    | Whole_hour (** Every offset after 1970 is a whole number of hours. *)
    | Fractional
    (** Some offset after 1970 is a whole number of minutes but not of hours. *)
    | Seconds (** Some offset in the zone's history is not a whole number of minutes. *)
    | Dst (** The current rule has a DST offset exactly one hour from standard. *)
    | Dst_other (** The current rule has a DST offset of another size. *)
    | Multi (** Some calendar year has more than two offset changes. *)
    | Base_change
    (** The lowest offset in force during some year after 1970 differs from
        the previous year's. *)
    | Midnight (** A transition after 1970 whose wall time before or after it is midnight. *)
    | Spans_midnight
    (** A transition after 1970 whose wall times before and after it fall on
        different dates. *)
    | Whole_day (** A transition that skips or repeats a whole day. *)
    | Same_offset
    (** A transition after 1970 that changes the abbreviation but not the offset. *)
    | Undefined (** The zone uses the [-00] undefined-offset abbreviation. *)
    | Link (** The name is a link to another zone. *)
    | Legacy (** The name is not [Area/Location] for a current area. *)
    | Inverted_sign (** The name is one of the [Etc/GMT+5] family. *)

  (** What a zone source knows about a time zone name; see {!info}. [rank] is
      the name's position on the shrink ladder ([UTC] is 0) and [tags] its
      features in declaration order. *)
  type zone_info =
    { primary_name : string
    ; is_link : bool
    ; rank : int
    ; tags : tag list
    }

  (** The offset a zone has in force at an instant; see {!offset_at}.
      [is_dst] is the database's daylight-saving flag, informational only, and
      [abbreviation] the abbreviation in force, such as [EST], or [-00] when
      the offset is unknown. *)
  type zone_offset =
    { offset : utc_offset
    ; is_dst : bool
    ; abbreviation : string
    }

  (** Prints a {!type-date}. *)
  val sexp_of_date : date -> Sexplib0.Sexp.t

  (** Prints a {!type-time}. *)
  val sexp_of_time : time -> Sexplib0.Sexp.t

  (** Prints a {!datetime}. *)
  val sexp_of_datetime : datetime -> Sexplib0.Sexp.t

  (** Prints an {!type-instant}. *)
  val sexp_of_instant : instant -> Sexplib0.Sexp.t

  (** Prints a {!utc_offset}. *)
  val sexp_of_utc_offset : utc_offset -> Sexplib0.Sexp.t

  (** Prints a {!time_zone}. *)
  val sexp_of_time_zone : time_zone -> Sexplib0.Sexp.t

  (** Prints a {!zoned_datetime}. *)
  val sexp_of_zoned_datetime : zoned_datetime -> Sexplib0.Sexp.t

  (** Prints a {!signed_duration}. *)
  val sexp_of_signed_duration : signed_duration -> Sexplib0.Sexp.t

  (** Prints a {!span}. *)
  val sexp_of_span : span -> Sexplib0.Sexp.t

  (** {2 Zone sources} *)

  (** A source of time zone data: the database {!zones} and
      {!zoned_datetimes} draw names from and classify, target and resolve wall
      times against, and {!resolve}, {!offset_at} and {!info} query.

      Zone names, their link and legacy flags, their feature tags and the
      order they shrink in always come from the engine's bundled catalogue, so
      a stored failure shrinks the same way everywhere; only what a wall time
      means in a zone comes from the source. A name the catalogue lacks is
      drawn too, after every catalogued name, tagged from its data.

      A source takes data in three shapes, TZif files ({!Zone_source.add_tzif}), fields
      ({!Zone_source.add_zone}) and an offset oracle ({!Zone_source.add_oracle}), plus links
      ({!Zone_source.add_link}) and names whose data a loader supplies the first time a
      draw or query needs it ({!Zone_source.declare} and {!Zone_source.set_loader}). Data added for a
      name replaces what the source had for it. Add or declare names before
      building generators that draw from the source.

      {[
        let source = Temporal.Zone_source.create () in
        Temporal.Zone_source.declare source [ "America/New_York"; "Europe/London" ];
        Temporal.Zone_source.set_loader source (fun source name ->
          match In_channel.with_open_bin ("/usr/share/zoneinfo/" ^ name) In_channel.input_all with
          | bytes -> Temporal.Zone_source.add_tzif source name bytes
          | exception Sys_error _ -> ());
        let%hegel_test zoned tc =
          let z =
            draw tc (Temporal.zoned_datetimes ~zones:(Temporal.zones ~source ()) ())
          in
          ignore z
        ;;
      ]}

      A source lives for the rest of the process: the engine shares it with
      every generator and default that uses it. Every function raises
      [Usage_error] with the engine's reason when it rejects the data
      or the call. *)
  module Zone_source : sig
    (** A zone source. *)
    type t KIND(value mod portable contended)

    (** A local time type of a zone: an offset of less than two days in
        seconds east of UTC, its daylight-saving flag (informational: reported
        by {!offset_at}, never used to classify a wall time) and its
        abbreviation, such as [EST]. *)
    type zone_type =
      { offset_seconds : int
      ; is_dst : bool
      ; abbreviation : string
      }

    (** An explicit transition: from [instant] (Unix seconds) on, [local_type]
        is in force. *)
    type zone_transition =
      { instant : int
      ; local_type : zone_type
      }

    (** The day a yearly rule's transition happens on, as a POSIX TZ string
        names it (RFC 9636 §3.3.1). *)
    type rule_day =
      | Julian of int
      (** [Jn]: the day of the year in [\[1, 365\]], February 29 never counted. *)
      | Zero_based of int
      (** [n]: the zero-based day of the year in [\[0, 365\]], February 29 counted. *)
      | Month_week_day of
          { month : month
          ; week : int
          ; weekday : weekday
          }
      (** [Mm.w.d]: the [week]th [weekday] of [month], [week] in [\[1, 5\]]
          with 5 meaning the last. *)

    (** When a yearly rule's transition happens: [time] seconds (within ±167
        hours) after local midnight of [day], in the offset in force before
        the transition. *)
    type rule_date =
      { day : rule_day
      ; time : int
      }

    (** The daylight-saving half of a {!zone_rule}: [local_type] is in force
        from [starts] to [ends] each year. *)
    type dst_rule =
      { local_type : zone_type
      ; starts : rule_date
      ; ends : rule_date
      }

    (** A zone's rule for every year after its last explicit transition, the
        footer of a TZif file: a standard type and, when the zone observes
        daylight saving time, a {!dst_rule}. *)
    type zone_rule =
      { standard : zone_type
      ; dst : dst_rule option
      }

    (** What a zone has in force after its last explicit transition. *)
    type after =
      | Hold (** The last type, for ever. *)
      | Rule of zone_rule (** The yearly rule. *)
      | Infer of int
      (** A yearly rule inferred from the transitions of the given last year
          the transitions cover and the year before it, or the last type held
          when they show none. *)

    (** A zone's data as fields, the TZif model of RFC 9636: the type in force
        before the first transition, the transitions strictly ascending by
        instant, and what follows them. *)
    type zone_data =
      { initial : zone_type
      ; transitions : zone_transition list
      ; after : after
      }

    (** [bundled ()] is the engine's bundled IANA database. It cannot be
        changed: every [add_*] and [set_*] function raises on it. *)
    val bundled : unit -> t

    (** [create ()] is a new, empty source. *)
    val create : unit -> t

    (** [add_tzif source name bytes] adds the zone [name] from the contents of
        a TZif file (RFC 9636, version 2 or later), such as one under
        [/usr/share/zoneinfo]. A name is not empty, has no NUL bytes and is not
        {!unknown_zone}. *)
    val add_tzif : t -> string -> string -> unit

    (** [add_zone source name data] adds the zone [name] from its data as
        fields. *)
    val add_zone : t -> string -> zone_data -> unit

    (** [add_oracle source name offset_at] adds the zone [name] from a library
        that answers lookups but does not expose its data, probing
        [offset_at], the type in force at an instant in Unix seconds, over the
        years [first_year] (default 1900) to [last_year] (default 2100). With
        [next_transition], the first instant after the one given at which the
        type in force changes ([None] when it never changes again), the probe
        asks for each transition in turn; without it, it samples [offset_at]
        once a day and bisects each change to the second, which misses a pair
        of changes less than a day apart. Before [first_year] the type at its
        start holds; after [last_year] the last type holds, or with [~infer:true]
        a yearly rule inferred from the last two years probed (closer for a
        library that applies the current rule for ever). The callbacks run on
        the calling thread, during the call only; an exception they raise
        fails the call with its message. *)
    val add_oracle
      :  t
      -> string
      -> ?next_transition:(int -> int option)
      -> ?first_year:int
      -> ?last_year:int
      -> ?infer:bool
      -> (int -> zone_type)
      -> unit

    (** [add_link source name ~target] makes [name] a link to [target], whose
        data then applies to both. The target need not have data, or be
        known, yet. *)
    val add_link : t -> string -> target:string -> unit

    (** [declare source names] declares names the source knows whose data
        comes later: from the loader the first time a draw or query needs it,
        or from an [add_*] call before a zoned datetime is drawn in that zone.
        A name the source already has keeps what it has. A declared name
        whose data never comes raises [Usage_error] from a query of the name
        and from a draw from the source that loads it; drawing zones from a
        source loads every name it could draw. *)
    val declare : t -> string list -> unit

    (** [set_loader source load] sets the loader asked for the data of a
        name the source lacks, the first time a draw or query needs it: [load
        source name] adds that name's zone (or a link) with the [add_*]
        functions, or adds nothing when it does not know the name, which is
        then unknown (an error for a {!declare}d name). It runs on whichever
        thread draws or queries, possibly more than once for one name, and
        must not draw. An exception it raises fails the draw or query with
        [Usage_error] carrying its message. *)
    val set_loader : t -> (t -> string -> unit) -> unit

    (** [set_version source version] records which release of its database
        the source holds, such as ["2026e"]. Failure output does not report
        it. *)
    val set_version : t -> string -> unit

    (** [version source] is the release of the source's database: for the
        bundled source {!tzdb_version}, for another what {!set_version}
        recorded, or [""]. *)
    val version : t -> string
  end

  (** [default_zone_source ()] is the process-wide default zone source: the
      one {!zones}, a {!zoned_datetimes} over another zone generator, and the
      queries use when given no source. It is {!Zone_source.bundled} until
      {!set_default_zone_source} sets another. *)
  val default_zone_source : unit -> Zone_source.t

  (** [set_default_zone_source source] replaces the process-wide default.
      A generator that draws from the default reads it at every draw, so the
      new default applies to generators built earlier too. *)
  val set_default_zone_source : Zone_source.t -> unit

  (** [tzdb_version ()] is the IANA release of the time zone database bundled
      in the engine, such as ["2026e"]. *)
  val tzdb_version : unit -> string

  (** [info ?source name] is what [source] (default {!default_zone_source})
      knows about [name], matched exactly as the source spells it, or [None]
      for a name it lacks. {!unknown_zone} is known, with itself as primary
      name, {!Undefined} and the highest rank. A name the catalogue lacks
      reports the source's link target, the rank after every catalogued name
      and the tags of its data and spelling. Raises [Usage_error] when
      loading the name's data fails. *)
  val info : ?source:Zone_source.t -> string -> zone_info option

  (** [resolve ?source name civil] classifies the wall time [civil] in the
      zone [name] of [source] (default {!default_zone_source}) and resolves it
      to an instant, meaning the earlier instant of a repeated wall time
      ([fold] false). Raises [Usage_error] for a zone the source lacks
      or fails to load, an invalid [civil], or one whose instant lies outside
      the range of {!type-instant}. *)
  val resolve : ?source:Zone_source.t -> string -> datetime -> zoned_datetime

  (** [offset_at ?source name instant] is the offset the zone [name] of
      [source] (default {!default_zone_source}) has in force at [instant].
      Raises [Usage_error] for a zone the source lacks or fails to load,
      or an invalid [instant]. *)
  val offset_at : ?source:Zone_source.t -> string -> instant -> zone_offset

  (** {2 Generators}

      Every bound is inclusive and validated by the engine. Building a
      generator does not touch the engine: on its first draw a generator
      builds its engine configuration (date options, or a time zone, zoned
      or span spec), which the engine validates, and reuses it for every later
      draw, building one per zone source for a generator that follows the
      default source. An invalid or inverted bound, or bounds holding no value
      at the precision, raises [Usage_error] from the generator's first draw,
      and from every later one, since a rejected configuration is not kept.
      Only an {!Unknown} offset bound, and civil and instant bounds given
      together, raise when the generator is built.

      In failure output a drawn value is printed as its text, without the
      quoting and escaping of s-expression atoms. *)

  (** [dates ?min_value ?max_value ?weekdays ?months ()] generates dates in
      [\[min_value, max_value\]] (default: the whole range of {!type-date}) on the
      given [weekdays] and in the given [months] (default: all of them). A
      drawn day on another weekday or in another month is moved to the
      nearest allowed day inside the bounds rather than rejected. Shrinks
      toward 2000-01-01 or the nearest bound; one draw in twenty on average
      targets an interesting date in the bounds: a bound, the nearest leap day
      or year boundary, the Unix epoch, the 32-bit and 64-bit boundaries or the
      Gregorian cutover. An empty [weekdays] or [months] list is an error. *)
  val dates
    :  ?min_value:date
    -> ?max_value:date
    -> ?weekdays:weekday list
    -> ?months:month list
    -> unit
    -> (date, printable) generator MODE(portable)

  (** [times ?min_value ?max_value ?precision ()] generates times of day in
      [\[min_value, max_value\]] (default: the whole day), a whole number of
      [precision] units (default {!Nanoseconds}) since midnight. Shrinks
      toward midnight or the lower bound. *)
  val times
    :  ?min_value:time
    -> ?max_value:time
    -> ?precision:precision
    -> unit
    -> (time, printable) generator MODE(portable)

  (** [datetimes ?min_value ?max_value ?precision ()] generates naive
      datetimes in [\[min_value, max_value\]] (default: the whole range of
      {!type-date}) whose time of day is a whole number of [precision] units
      (default {!Nanoseconds}). Shrinks toward 2000-01-01T00:00:00 or the
      nearest bound. *)
  val datetimes
    :  ?min_value:datetime
    -> ?max_value:datetime
    -> ?precision:precision
    -> unit
    -> (datetime, printable) generator MODE(portable)

  (** [instants ?min_value ?max_value ?precision ()] generates instants in
      [\[min_value, max_value\]] (default: the whole range of {!type-instant}), a
      whole number of [precision] units (default {!Nanoseconds}) since the
      epoch. Shrinks toward 2000-01-01T00:00:00Z or the nearest bound; one
      draw in twenty on average targets an interesting instant: the Unix
      epoch, the 32-bit and 64-bit boundaries, a leap second's or a time zone
      transition's. *)
  val instants
    :  ?min_value:instant
    -> ?max_value:instant
    -> ?precision:precision
    -> unit
    -> (instant, printable) generator MODE(portable)

  (** [offsets ?min_value ?max_value ?granularity ?unknown ()] generates UTC
      offsets in [\[min_value, max_value\]] (default [±max_offset], both
      bounds {!Known}) that are a whole number of [granularity] units (default
      {!Seconds}), and the unknown offset as well when [unknown] (default
      [false]). Shrinks to a known offset, then toward [+00:00]; one draw in
      twenty on average targets an offset some time zone has used, so
      [+05:45] and [-00:44:30] appear. An {!Unknown} bound raises
      [Usage_error]. *)
  val offsets
    :  ?min_value:utc_offset
    -> ?max_value:utc_offset
    -> ?granularity:granularity
    -> ?unknown:bool
    -> unit
    -> (utc_offset, printable) generator MODE(portable)

  (** [zones ?names ?links ?legacy ?unknown ?opaque ?source ()] generates
      time zones of [source] (default: {!default_zone_source} as it is at each
      draw). Without [names] it draws every name of the source,
      link names such as [Asia/Calcutta] included unless [links] is [false],
      legacy names such as [EST5EDT] and [US/Eastern] excluded unless [legacy]
      is [true]; with [names] it draws only those, each exactly as the source
      spells it, and the flags do not apply. [unknown] (default [false]) adds
      {!unknown_zone}. With [opaque] (default [false]), a name of [names] the
      source lacks is accepted as an opaque zone, one only the caller's
      database knows: drawn like any other name, evaluated like
      {!unknown_zone}. Shrinks down a ladder of names to [UTC] when it is
      allowed; half the draws are uniform over the allowed names and half
      weighted by the zones' features, so a zone with a rare feature is drawn
      at a rate a short run reaches. A name the source lacks that [opaque]
      does not admit, or a source with no name the flags allow, raises
      [Usage_error]. *)
  val zones
    :  ?names:string list
    -> ?links:bool
    -> ?legacy:bool
    -> ?unknown:bool
    -> ?opaque:bool
    -> ?source:Zone_source.t
    -> unit
    -> (time_zone, printable) generator MODE(portable)

  (** [zoned_datetimes ?zones ?min_value ?max_value ?min_instant ?max_instant
      ?precision ?allow_imaginary ?ambiguous ()] generates a zone, a wall-clock
      time in it and, when the clocks repeated that time, which repeat is
      meant.

      The zone comes from [zones] (default [zones ()]). A generator {!zones}
      returned gives its names and its source to the engine, and the zone and
      the wall time come from one engine draw. Any other generator draws a
      zone first, then the wall time in that zone, resolved against
      {!default_zone_source} as it is at each draw; a name
      that source lacks is then an opaque zone.

      The bounds are either on the wall clock in whatever zone is drawn
      ([min_value] / [max_value], default the whole range of {!type-date}) or on
      the instant ([min_instant] / [max_instant]); giving one of each kind
      raises [Usage_error]. The wall time is a whole number of
      [precision] units (default {!Nanoseconds}) since midnight. With
      [allow_imaginary] (default [true]) a wall time the clocks skipped is
      drawn and reported with kind {!Gap}; without, another wall time is
      drawn, and a replayed or shrunk value that lands in a gap is moved past
      it. [ambiguous] (default {!Both}) says which instant a repeated wall
      time means.

      Shrinks down the zone ladder, then toward 2000-01-01T00:00, preferring a
      unique wall time to a repeated one; one draw in twenty on average
      targets a transition of the zone, which is how gaps, folds and the exact
      boundary instants are reached.

      {[
        let%hegel_test new_york tc =
          let z =
            draw
              tc
              (Temporal.zoned_datetimes
                 ~zones:(Temporal.zones ~names:[ "America/New_York" ] ())
                 ~precision:Temporal.Seconds
                 ~allow_imaginary:false
                 ())
          in
          assert (z.kind <> Temporal.Gap)
        ;;
      ]} *)
  val%template zoned_datetimes
    :  ?zones:(time_zone, 'p) generator MODE(m)
    -> ?min_value:datetime
    -> ?max_value:datetime
    -> ?min_instant:instant
    -> ?max_instant:instant
    -> ?precision:precision
    -> ?allow_imaginary:bool
    -> ?ambiguous:ambiguous
    -> unit
    -> (zoned_datetime, printable) generator MODE(m)
  [@@mode m = (nonportable, portable)]

  (** [durations ?min_value ?max_value ?precision ()] generates signed
      durations in [\[min_value, max_value\]] (default: [±max_int] seconds and
      [±999999999] nanoseconds), a whole number of [precision] units (default
      {!Nanoseconds}). Shrinks toward zero; one draw in twenty on average
      targets a bound or a duration such as one unit, 24 hours or the 32-bit
      seconds limit. *)
  val durations
    :  ?min_value:signed_duration
    -> ?max_value:signed_duration
    -> ?precision:precision
    -> unit
    -> (signed_duration, printable) generator MODE(portable)

  (** [spans ?years ?months ?weeks ?days ?hours ?minutes ?seconds
      ?milliseconds ?microseconds ?nanoseconds ?sign ()] generates calendar
      spans. A unit given inclusive [(min, max)] bounds is drawn within them
      and a unit without is always 0; with no unit given, every unit is drawn
      within [±max_int], or [\[0, max_int\]] under {!Non_negative}. [sign]
      (default {!Uniform}) says how the units' signs are drawn. Shrinks toward
      the zero span. Inverted bounds, or bounds the sign policy does not
      admit, raise [Usage_error].

      {[
        let%hegel_test short_spans tc =
          let s = draw tc (Temporal.spans ~days:(0, 30) ~hours:(0, 23) ()) in
          assert (s.days <= 30 && s.years = 0)
        ;;
      ]} *)
  val spans
    :  ?years:int * int
    -> ?months:int * int
    -> ?weeks:int * int
    -> ?days:int * int
    -> ?hours:int * int
    -> ?minutes:int * int
    -> ?seconds:int * int
    -> ?milliseconds:int * int
    -> ?microseconds:int * int
    -> ?nanoseconds:int * int
    -> ?sign:span_sign
    -> unit
    -> (span, printable) generator MODE(portable)
end

(** {2 Deprecated date and time generators}

    The string date and time generators that preceded {!Temporal}. They draw
    through {!Temporal.dates}, {!Temporal.times} and {!Temporal.datetimes}
    and produce the same values as before. *)

(** A proleptic Gregorian calendar date; the same type as {!Temporal.type-date}.

    @deprecated [since 2026-10] use {!Temporal.type-date}. *)
type date = Temporal.date =
  { year : int
  ; month : int
  ; day : int
  }

(** A time of day at nanosecond resolution; the same type as
    {!Temporal.type-time}.

    @deprecated [since 2026-10] use {!Temporal.type-time}. *)
type time = Temporal.time =
  { hour : int
  ; minute : int
  ; second : int
  ; nanosecond : int
  }

(** [make_dates ~of_date ~sexp_of ?min_date ?max_date ()] builds a generator
    for dates in [\[min_date, max_date\]] over any representation. [of_date]
    converts each drawn date to the desired representation. The default range
    is [\[0001-01-01, 9999-12-31\]]. Use [map] over {!Temporal.dates}
    instead. *)
val%template make_dates
  :  of_date:(Temporal.date -> 'a) MODE(m)
  -> sexp_of:('a -> Sexplib0.Sexp.t) MODE(m)
  -> ?min_date:Temporal.date
  -> ?max_date:Temporal.date
  -> unit
  -> ('a, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]
[@@deprecated "[since 2026-10] use map over Temporal.dates"]

(** [make_times ~of_time ~sexp_of ?min_time ?max_time ()] builds a generator
    for times of day in [\[min_time, max_time\]] over any representation.
    The default range is [\[00:00:00.000000000, 23:59:59.999999999\]]. Use
    [map] over {!Temporal.times} instead. *)
val%template make_times
  :  of_time:(Temporal.time -> 'a) MODE(m)
  -> sexp_of:('a -> Sexplib0.Sexp.t) MODE(m)
  -> ?min_time:Temporal.time
  -> ?max_time:Temporal.time
  -> unit
  -> ('a, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]
[@@deprecated "[since 2026-10] use map over Temporal.times"]

(** [make_datetimes ~of_datetime ~sexp_of ?min_datetime ?max_datetime ()]
    builds a generator for naive datetimes in [\[min_datetime,
    max_datetime\]] over any representation, as [(date, time)] pairs. The
    default range is
    [\[0001-01-01T00:00:00.000000000, 9999-12-31T23:59:59.999999999\]]. Use
    [map] over {!Temporal.datetimes} instead. *)
val%template make_datetimes
  :  of_datetime:(Temporal.date * Temporal.time -> 'a) MODE(m)
  -> sexp_of:('a -> Sexplib0.Sexp.t) MODE(m)
  -> ?min_datetime:Temporal.date * Temporal.time
  -> ?max_datetime:Temporal.date * Temporal.time
  -> unit
  -> ('a, printable) generator MODE(m)
[@@mode m = (nonportable, portable)]
[@@deprecated "[since 2026-10] use map over Temporal.datetimes"]

(** [dates ?min_date ?max_date ()] creates a generator for ISO 8601
    [YYYY-MM-DD] date strings in [\[min_date, max_date\]]. The default range
    is [\[0001-01-01, 9999-12-31\]]. Use {!Temporal.dates} instead. *)
val dates
  :  ?min_date:Temporal.date
  -> ?max_date:Temporal.date
  -> unit
  -> (string, printable) generator MODE(portable)
[@@deprecated "[since 2026-10] use Temporal.dates"]

(** [times ?min_time ?max_time ()] creates a generator for ISO 8601
    [HH:MM:SS.fffffffff] time-of-day strings in [\[min_time, max_time\]].
    The default range is [\[00:00:00.000000000, 23:59:59.999999999\]]. Use
    {!Temporal.times} instead. *)
val times
  :  ?min_time:Temporal.time
  -> ?max_time:Temporal.time
  -> unit
  -> (string, printable) generator MODE(portable)
[@@deprecated "[since 2026-10] use Temporal.times"]

(** [datetimes ?min_datetime ?max_datetime ()] creates a generator for naive
    ISO 8601 [YYYY-MM-DDTHH:MM:SS.fffffffff] datetime strings in
    [\[min_datetime, max_datetime\]]. The default range is
    [\[0001-01-01T00:00:00.000000000, 9999-12-31T23:59:59.999999999\]]. Use
    {!Temporal.datetimes} instead. *)
val datetimes
  :  ?min_datetime:Temporal.date * Temporal.time
  -> ?max_datetime:Temporal.date * Temporal.time
  -> unit
  -> (string, printable) generator MODE(portable)
[@@deprecated "[since 2026-10] use Temporal.datetimes"]
end

(**/**)

include module type of struct
  include Public
end

(**/**)
(*
    The engine-pool generator ([Stateful.Pool]) resolves engine-drawn variable
    ids against the client-side pool.
*)

module Int_table : Stdlib.Hashtbl.S with type key = int

(** [resolve_draw values ~consume id] resolves a drawn pool id against a client
    table, removing it when [consume]. *)
val resolve_draw : 'a Int_table.t -> consume:bool -> int -> 'a

(** [Int_pool] is the client side of an engine pool for a sequential machine:
    drawn ids resolved against an [Int_table] of values, with no lock. Its
    element type is unconstrained. *)
module Int_pool : sig
  type 'a t

  val create : Internal.test_case -> clone:('a -> 'a) -> 'a t
  val add : 'a t -> Internal.test_case -> 'a -> unit
  val size : _ t -> int

  (** The pool's values, in no particular order, each through the pool's
      clone function. *)
  val to_list : 'a t -> 'a list

  (** Reusable draws apply the pool's clone function. Consumed draws return
      the stored value directly. *)
  val pool_values : 'a t -> consume:bool -> ('a, unprintable) generator
end

(** [Int_pool_concurrent] is the same client side for a machine whose workers
    share the pool. *)
module%template Int_pool_concurrent : sig
#ifdef OXCAML
  type ('a : value mod m c) t : value mod m c
#else
  type 'a t
#endif

#ifdef OXCAML
  val create : Internal.test_case -> clone:('a -> 'a) @ m -> 'a t
#else
  val create : Internal.test_case -> clone:('a -> 'a) -> 'a t
#endif

  val add : 'a t -> Internal.test_case -> 'a -> unit
  val size : _ t -> int

  (** The pool's values, in no particular order, each through the pool's
      clone function, taken under its lock. *)
  val to_list : 'a t -> 'a list

  (** Reusable draws use the pool's clone function under its lock, if present.
      Consumed draws return the stored value directly. *)
  val pool_values : 'a t -> consume:bool -> ('a, unprintable) generator
end
[@@mode (m, c) = ((portable, contended), (nonportable, uncontended))]

(** Implementation helpers for library modules and white-box tests. Not for
    direct use — no stability guarantees. *)
module Private : sig
  (** Span labels: opaque values identifying a generator to the engine, which
      treats two spans with the same label as coming from the same generator,
      and so as candidates for swapping, duplicating, and reordering during
      shrinking and mutation. *)
  module Labels : sig
    (** [from_name name] is the label of a generator named [name] (64-bit
        FNV-1a, as [hegel_label_from_name]). *)
    val from_name : string -> int64

    (** [combine labels] is the label of a generator built from others: its
        own label first, then its components' (as [hegel_label_combine]). *)
    val combine : int64 list -> int64

    val list : int64
    val set : int64
    val assoc_list : int64
    val hash_table : int64
    val tuple : int64
    val one_of : int64
    val optional : int64
    val fixed_dict : int64
    val flat_map : int64
    val filter : int64
    val mapped : int64
    val enum_variant : int64
    val pool : int64
    val function_ : int64
    val function_result : int64
    val stateful_rule : int64
  end

  (** [label_of gen] is the span label of [gen]. *)
  val label_of : ('a, 'p) generator -> int64

  (** [group label data f] runs [f ()] inside a span with the given [label]. The
      span is stopped with [discard:false] regardless of whether [f] raises. *)
  val group : int64 -> Internal.test_case -> (unit -> 'a) -> 'a

  (** [discardable_group label data f] runs [f ()] inside a span with [label].
      If [f] raises, the span is stopped with [discard:true]; otherwise
      [discard:false]. *)
  val discardable_group : int64 -> Internal.test_case -> (unit -> 'a) -> 'a

  (** A collection handle for generating variable-length sequences. *)
  type collection =
    { mutable finished : bool
    ; mutable handle : Internal.collection option
    ; min_size : int
    ; max_size : int option
    }

  (** [with_collection ~min_size ?max_size data f] runs [f] with a new
      collection and releases the engine-side handle after calling [f]. *)
  val with_collection
    :  min_size:int
    -> ?max_size:int
    -> Internal.test_case
    -> (collection -> 'a)
    -> 'a

  (** [collection_more coll data] returns [true] if more elements should be
      generated, [false] when the collection is complete. *)
  val collection_more : collection -> Internal.test_case -> bool

  (** [collection_reject coll data] rejects the last element of the collection.
      Raises [Internal.Stop_test] on StopTest. *)
  val collection_reject : collection -> Internal.test_case -> unit
end

(** Helpers referenced by code generated by [ppx_hegel_generator]. Not for
    direct use — no stability guarantees. *)
module Ppx_internal : sig
  module Labels : sig
    val from_name : string -> int64
    val combine : int64 list -> int64
    val fixed_dict : int64
    val enum_variant : int64
  end

  (** [composite_with_label ~label generate_fn] is {!composite} but tags the
      span with [label] instead of the fixed struct/record label. Used by the
      derive PPX to tag composites (e.g. {!Labels.enum_variant}). *)
  val%template composite_with_label
    :  label:int64
    -> (Internal.test_case -> 'a) MODE(m)
    -> ('a, unprintable) generator MODE(m)
  [@@mode m = (nonportable, portable)]
end

(**/**)
