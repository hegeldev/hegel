// Exercises most of the grammar language in one place.
// start: start
start: value+ -> values
     | "nothing"

?value: number
      | string
      | list
      | pair{NAME, value}
      | ("a".."c")~2..3
      | /x+/i
      | "KeyWord"i
      | WS_INLINE? [":"] value~1

pair{k, v}: k "=" v

number: SIGNED_NUMBER
string: ESCAPED_STRING
list: "[" [value ("," value)*] "]"

NAME: ("_"|LETTER) ("_"|LETTER|DIGIT)*
MULTI.2: "ab" | "abc" | "a"
FLAGGED: /foo/is "bar"
ESCAPES: "\t\n\\\"" | /\d\/\\/
RANGE_ESC: "\x41".."\x5a"

%import common.SIGNED_NUMBER
%import common.ESCAPED_STRING
%import common (LETTER, DIGIT, WS_INLINE)
%import common.WS -> SPACE
%ignore SPACE
%ignore /#[^\n]*/
