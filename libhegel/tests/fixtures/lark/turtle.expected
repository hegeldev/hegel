start start
terminal C	0	"c"
terminal COLOR	0	"(?:(?:[A-Z]|[a-z]))+"
terminal FILL	0	"fill"
terminal LBRACE	0	"\\{"
terminal MOVEMENT	0	"(?:f|b|l|r)"
terminal NUMBER	0	"(?:[0-9])+"
terminal RBRACE	0	"\\}"
terminal REPEAT	0	"repeat"
terminal WS	0	"(?:[ \t\f\r\n])+"
ignore WS
rule code_block
rule instruction
rule start
