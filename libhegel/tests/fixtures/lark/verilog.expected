start start
terminal AMPERSAND	0	"\\&"
terminal ASSIGN	0	"assign"
terminal BANG	0	"!"
terminal CIRCUMFLEX	0	"\\^"
terminal COLON	0	":"
terminal COMMA	0	","
terminal COMMENT	0	"//[^\n]*\\\n"
terminal DOT	0	"\\."
terminal ENDMODULE	0	"endmodule"
terminal EQUAL	0	"="
terminal IDENTIFIER	0	"(?:\\\\([^\\s]+)|(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)"
terminal INPUT	0	"input"
terminal LPAR	0	"\\("
terminal MODULE	0	"module"
terminal MULTILINE_COMMENT	0	"\\/\\*(\\*(?!\\/)|[^*])*\\*\\/"
terminal NEWLINE	0	"\\\n"
terminal OUTPUT	0	"output"
terminal QMARK	0	"\\?"
terminal RPAR	0	"\\)"
terminal SEMICOLON	0	";"
terminal TILDE	0	"\\~"
terminal VBAR	0	"\\|"
terminal WIRE	0	"wire"
terminal WS	0	"(?:[ \t\f\r\n])+"
terminal __ANON_0	0	"1'b0"
terminal __ANON_1	0	"1'h0"
terminal __ANON_2	0	"1'b1"
terminal __ANON_3	0	"1'h1"
terminal __ANON_4	0	"1'bx"
terminal __ANON_5	0	"1'hx"
terminal __ANON_6	0	"\\~\\^"
terminal __ANON_7	0	"\\^\\~"
ignore WS
ignore COMMENT
ignore MULTILINE_COMMENT
ignore NEWLINE
rule and
rule and_gate
rule assignment
rule condition
rule constant_one
rule constant_value
rule constant_x
rule constant_zero
rule continuous_assign
rule description
rule expression
rule identifier
rule input_declaration
rule list_of_assignments
rule list_of_module_connections
rule list_of_ports
rule list_of_variables
rule lvalue
rule module
rule module_instance
rule module_instantiation
rule module_item
rule module_port_connection
rule name_of_instance
rule name_of_module
rule named_port_connection
rule net_declaration
rule not_gate
rule or
rule or_gate
rule output_declaration
rule port
rule primary
rule start
rule ternary
rule unary
rule xnor_gate
rule xor
rule xor_gate
