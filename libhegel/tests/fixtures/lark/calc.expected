start start
terminal EQUAL	0	"="
terminal LPAR	0	"\\("
terminal MINUS	0	"\\-"
terminal NAME	0	"(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*"
terminal NUMBER	0	"(?:(?:(?:[0-9])+(?:e|E)(?:(?:\\+|\\-))?(?:[0-9])+|(?:(?:[0-9])+\\.(?:(?:[0-9])+)?|\\.(?:[0-9])+)(?:(?:e|E)(?:(?:\\+|\\-))?(?:[0-9])+)?)|(?:[0-9])+)"
terminal PLUS	0	"\\+"
terminal RPAR	0	"\\)"
terminal SLASH	0	"/"
terminal STAR	0	"\\*"
terminal WS_INLINE	0	"(?:(?:\\ |\t))+"
ignore WS_INLINE
rule atom
rule product
rule start
rule sum
