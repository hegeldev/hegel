terminal RPAR	0	"\\)"
terminal RSQB	0	"\\]"
terminal RULE	0	"!?[_?]?[a-z][_a-z0-9]*"
terminal STRING	0	"\".*?(?<!\\\\)(\\\\\\\\)*?\"(?:i)?"
terminal TILDE	0	"\\~"
terminal TOKEN	0	"_?[A-Z][_A-Z0-9]*"
terminal WS_INLINE	0	"(?:(?:\\ |\t))+"
terminal _NL	0	"(\r?\n)+\\s*"
terminal _VBAR	0	"(?:(\r?\n)+\\s*)?\\|"
