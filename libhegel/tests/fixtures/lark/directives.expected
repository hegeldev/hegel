start start
terminal EQUAL	0	"="
terminal INT	0	"(?:[0-9])+"
terminal LPAR	0	"\\("
terminal NAME	0	"(?:\\$(?:[0-9])+|(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)"
terminal NEWLINE	0	"(?:\r?\n)+"
terminal PASS	0	"pass"
terminal RPAR	0	"\\)"
terminal __IGNORE_0	0	"\\ "
ignore __IGNORE_0
rule expr
rule start
rule stmt
